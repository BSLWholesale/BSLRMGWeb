                                <table class="table table-striped table-responsive-sm" id="tblDisplayOB" style="display: none;">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                            <th><input type="checkbox" id="chkAll" style="accent-color: green;" /> Select-All</th>
                                            <th>Description</th>
                                            <th>OpNo</th>
                                            <th>Machine</th>
                                            <th>SubSection</th>
                                            <th>StdMin</th>
                                            <th>Rate</th>
                                            @*<th>Product</th>*@
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyDisplayOB"></tbody>
                                </table>

                                <!-- End OB Display -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" id="loader" style=" margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>

    </section>
</section>
<input type="hidden" id="hdnMID" value="0" />

<!-- Model Start-->

<div id="AddOBModal" class="modal fade" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <div class="row">
                    <div class="col-sm-10">
                        <h4 class="modal-title">Add New</h4>
                    </div>
                    <div class="col-sm-2">
                        <button type="button" class="close" style="color:#fff;" data-dismiss="modal">&times;</button>
                    </div>
                </div>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Product</label>
                            <input type="text" id="txtProduct" class="form-control" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Description</label>
                            <input type="text" id="txtDescription" class="form-control" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>OpNo</label>
                            <input type="text" id="txtOpNo" onkeypress="if (isNaN(String.fromCharCode(event.keyCode))) return false;" class="form-control" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Machine</label>
                            <input type="text" id="txtMachine" class="form-control" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>SubSection</label>
                            <input type="text" id="txtSubSection" class="form-control" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Category</label>
                            <input type="text" id="txtCategory" class="form-control" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>StdMin</label>
                            <input type="text" id="txtStdMin" onkeypress="var ch = String.fromCharCode(event.keyCode); if (isNaN(ch) && ch !== '.') return false;" class="form-control" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Rate</label>
                            <input type="text" id="txtRate" onkeypress="if (isNaN(String.fromCharCode(event.keyCode))) return false;" class="form-control" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Grade</label>
                            <input type="text" id="txtGrade" class="form-control" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Remark</label>
                            <input type="text" id="txtRemark" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" type="button" onclick="Fn_Add_New_OpNo();"> Save </button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>

<!-- model End -->
