        function Fn_Check_Exist_style_In_Master() {

            var clsOPBreackDownMaster = {};
            clsOPBreackDownMaster.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownMaster.StyleCode = $("#txtStyleCode").val();
            clsOPBreackDownMaster.ProcessName = $("#ddlProcessName option:selected").text();

            if (clsOPBreackDownMaster.StyleCode == "") {
                Swal.fire({ title: "", text: "Please Enter Style Code", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Check_Exist_style_In_Master",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownMaster),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            $("#hdnMID").val(obj.ID);
                        }
                        else {
                            $("#hdnMID").val(0);
                        }
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }

        }

        function Fn_OnDDLChange() {
            Fn_Check_Exist_style_In_Master();
            if ($("#txtStyleCode").val() == "") {

            }
            else {
                Fn_Get_Operation_BreackdownFile();
            }
        }

        function Fn_Get_OB_BY_Product() {
            var clsOPBreackDownDetail = {};
            $("#chkAll").prop("checked", false);
            clsOPBreackDownDetail.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownDetail.Product = $("#ddlProduct option:selected").text();
            $("#tbodyDisplayOB").html('');
            var html = '';
            $("#spTotalRowCount").html('');
            $.ajax({
                type: "POST",
                url: "/Order/Fn_Get_OB_BY_Product",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsOPBreackDownDetail),
                beforeSend: function () {
                    $("#loader").show();
                    $("#dvMain").hide();
                },
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        var rCount = 0;
                        for (var i = 0; i < obj.length; i++) {
                            rCount++;
                            html += "<tr id='row_" + rCount + "'>";
                            html += "<td><input type='checkbox' id='chk_" + rCount + "' class='chkItem' /></td>";
                            html += "<td id='Descriptions_row_" + rCount + "'>" + obj[i].Descriptions + "</td>";
                            html += "<td id='OpNo_row_" + rCount + "'>" + obj[i].OpNo + "</td>";
                            html += "<td id='Machine_row_" + rCount + "'>" + obj[i].Machine + "</td>";
                            html += "<td id='SubSection_row_" + rCount + "'>" + obj[i].SubSection + "</td>";
                            html += "<td id='StdMin_row_" + rCount + "'>" + obj[i].StdMin + "</td>";
                            html += "<td id='Rate_row_" + rCount + "'>" + obj[i].Rate + "</td>";
                            /* html += "<td id='Product_row_" + rCount + "'>" + obj[i].Product + "</td>";*/
                            html += "<td id='row_" + rCount + "'>";
                            html += "<button id='edit_button" + rCount + "' onclick='Fn_Edit_OB_Row(" + rCount + ")' class='btn btn-xs btn-info'><i class='fa fa-edit'></i></button>";
                            html += "<button id='save_button" + rCount + "' onclick='Fn_Save_OB_Row(" + rCount + ")' style='display:none;' class='btn btn-xs btn-success'><i class='fa fa-check'></i></button>";
                            // html += "<a href='javascript: void (0);' class='btn btn-xs btn-info'><i class='fa fa-edit' onclick='Fn_Edit_OB_Row(" + rCount + ")'></i></a>";
                            html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-danger deleteOBRow'><i class='fa fa-trash' ></i></a>";
                            html += "</td>";
                            html += "</tr>";

                        }
                        $('#btnInsert').removeAttr('disabled');
                        $("#spTotalRowCount").html("Total : " + rCount);
                        $("#tblDisplayOB").show();
                        $("#tblOPList").hide();
                        $(".clsdvSerch").show();
                    }
                    else {
                        html += "<tr><td colspan='12' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                        $('#btnInsert').attr('disabled', 'disabled');
                        $("#tblDisplayOB").show();
                        $("#tblOPList").hide();
                        $(".clsdvSerch").hide();
                    }
                    $("#tbodyDisplayOB").append(html);
                },
                complete: function (data) {
                    $("#loader").hide();
                    $("#dvMain").show();
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });

                }
            });
        }

        $(document).on("click", '.deleteOBRow', function () {
            $(this).closest('tr').remove();
        });

        function Fn_Edit_OB_Row(no) {

            document.getElementById("edit_button" + no).style.display = "none";
            document.getElementById("save_button" + no).style.display = "inline-block";

            var widths = {
                //Descriptions: "300px",
                //OpNo: "80px",
                //Machine: "150px",
                //SubSection: "150px",
                //StdMin: "50px",
                Rate: "50px"
            };

            /* var cells = ["Descriptions", "OpNo", "Machine", "SubSection", "StdMin", "Rate"];*/
            var cells = ["Rate"];
            cells.forEach(function (type) {
                var cell = document.getElementById(type + "_row_" + no);

                if (cell) {
                    var currentValue = cell.innerText.trim(); // safer than innerHTML

                    // cell.innerHTML = "<input type='text' id='" + type + "_text" + no + "' value='" + currentValue + "'>";
                    cell.innerHTML =
                        "<input type='text' style='width:" + widths[type] + ";' id='" + type + "_text" + no + "' value='" + currentValue + "'>";
                }
            });
        }

        function Fn_Save_OB_Row(no) {
            var clsOPBreackDownDetail = {};

            var cells = ["Rate"];

            cells.forEach(function (type) {
                var input = document.getElementById(type + "_text" + no);
                var cell = document.getElementById(type + "_row_" + no);

                if (input && cell) {
                    cell.innerHTML = input.value;
                    clsOPBreackDownDetail.Rate = input.value
                    clsOPBreackDownDetail.OpNo = $("#OpNo_row_" + no).html();
                }

                Swal.fire({
                    title: 'Are your sure?',
                    text: "Do you want to change rate?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes',
                }).then((result) => {
                    if (result.isConfirmed) {
                        clsOPBreackDownDetail.CreatedBy = sessionStorage.getItem("LogInID");
                        $.ajax({
                            type: "POST",
                            url: "/Order/Fn_Update_Rate_In_OB_Master",
                            contentType: "application/json;charset=utf-8",
                            dataType: "json",
                            data: JSON.stringify(clsOPBreackDownDetail),
                            success: function (data) {
                                var obj = JSON.parse(data.message);
                                if (obj.vErrorMsg == "Success") {
                                    Swal.fire({ title: "", text: "Rate updated successfully.", icon: "success" });
                                    return true;
                                }
                                else {
                                    Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                                }
                            },
                            error: function (err) {
                                alert(err);
                            }
                        });
                    }
                    else {
                        return false;
                    }
                });

            });

            document.getElementById("edit_button" + no).style.display = "inline-block";
            document.getElementById("save_button" + no).style.display = "none";
        }


        function Fn_Insert_OB_BY_Product() {

            var clsOPBreackDownMaster = {};
            clsOPBreackDownMaster.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownMaster.StyleCode = $("#txtStyleCode").val();
            clsOPBreackDownMaster.ProcessName = $("#ddlProcessName option:selected").text();

            var clsOPBreackDownDetail = [];

            $('#tbodyDisplayOB tr').each(function (index, row) {

                if ($(this).find('td:eq(0) input[type="checkbox"]').prop('checked')) {

                    var tds = $(this).find('td');

                    clsOPBreackDownDetail.push({
                        SeqNo: index + 1,
                        Descriptions: tds.eq(1).text(),
                        OpNo: tds.eq(2).text(),
                        Machine: tds.eq(3).text(),
                        SubSection: tds.eq(4).text(),
                        StdMin: tds.eq(5).text(),
                        Rate: tds.eq(6).text(),
                        Product: $("#ddlProduct option:selected").text(),
                        IsDirect: false,
                        IsDispatch: false,
                        IsDS: false
                    });

                }
            });

            clsOPBreackDownMaster.oList = clsOPBreackDownDetail;

            var MID = $("#hdnMID").val();
            if (MID == 0) {
                clsOPBreackDownMaster.ID = 0;
            }
            else {
                clsOPBreackDownMaster.ID = MID;
            }

            if (clsOPBreackDownMaster.StyleCode == "") {
                Swal.fire({ title: "", text: "Please Enter Style Code", icon: "error" });
            }
            else if (clsOPBreackDownMaster.ProcessName == "0") {
                Swal.fire({ title: "", text: "Please select Process Name", icon: "error" });
            }
            else if (clsOPBreackDownMaster.oList == null || clsOPBreackDownMaster.oList.length == 0) {
                Swal.fire({ title: "", text: "Please select List", icon: "error" });
            }
            else {

                let formData = new FormData();
                formData.append("CreatedBy", clsOPBreackDownMaster.CreatedBy);
                formData.append("StyleCode", clsOPBreackDownMaster.StyleCode);
                formData.append("ProcessName", clsOPBreackDownMaster.ProcessName);
                formData.append("ID", clsOPBreackDownMaster.ID);
                formData.append("oList", JSON.stringify(clsOPBreackDownMaster.oList));
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Insert_OB_BY_Product",
                    data: formData,
                    processData: false,
                    contentType: false,
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {

                            Swal.fire({ title: "", text: "Operation file uploaded successfully", icon: "success" });
                            Fn_Get_Operation_BreackdownFile();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }

                    },
                    complete: function (data) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }

        }

        function Fn_Open_Add_Popup() {
            $("#AddOBModal").modal('show');
        }

        function Fn_Add_New_OpNo() {

            var clsOPBreackDownDetail = {};

            clsOPBreackDownDetail.Product = $("#txtProduct").val();
            clsOPBreackDownDetail.Descriptions = $("#txtDescription").val();
            clsOPBreackDownDetail.OpNo = $("#txtOpNo").val();
            clsOPBreackDownDetail.Machine = $("#txtMachine").val();
            clsOPBreackDownDetail.SubSection = $("#txtSubSection").val();
            clsOPBreackDownDetail.StdMin = $("#txtStdMin").val();
            clsOPBreackDownDetail.Rate = $("#txtRate").val();
            clsOPBreackDownDetail.CreatedBy = sessionStorage.getItem("LogInID");

            $.ajax({
                type: "POST",
                url: "/Order/Fn_Add_New_OpNo",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsOPBreackDownDetail),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj.vErrorMsg == "Success") {
                        Swal.fire({ title: "", text: "Added new record successfully.", icon: "success" });
                        $("#txtProduct").val("");
                        $("#txtDescription").val("");
                        $("#txtOpNo").val("");
                        $("#txtMachine").val("");
                        $("#txtSubSection").val("");
                        $("#txtStdMin").val("");
                        $("#txtRate").val("");
                        Fn_Get_OB_BY_Product();
                    }
                    else {
                        Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                    }
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

    </script>
