                                            <th>Prog.Point</th>
                                            <th>IsDispatch</th>
                                            <th>Direct</th>
                                            <th>Depend.OPNO</th>
                                            <th>IsDS</th>
                                            @*
                                                <th>Action</th>*@
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyList"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>

    </section>
</section>
