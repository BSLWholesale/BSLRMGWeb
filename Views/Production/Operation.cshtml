            else if ($("#txtRate_New").val() == 0 || $("#txtRate_New").val() == "0" || $("#txtRate_New").val() == null) {
                Swal.fire({ title: "", text: "Please Enter Rate", icon: "error" });
            }
            else if ($("#txtProduct_New").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Product", icon: "error" });
            }
            else if ($("#txtSkill_New").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Skill", icon: "error" });
            }
            else if ($("#txtGrade_New").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Grade", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Add_New_OpNo_IN_OBD",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownDetail),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Swal.fire({ title: "", text: "OpNo added successfully.", icon: "success" });
                            Fn_Get_Operation_BreackdownFile();
                            $("#txtDescription_New").val("");
                            $("#txtOpNo_New").val("");
                            $("#txtSeqNo_New").val("");
                            $("#txtMachine_New").val("");
                            $("#txtSubSection_New").val("");
                            $("#txtRate_New").val("");
                            $("#txtStdMin_New").val("");
                            $("#txtProduct_New").val("");
                            $("#txtSkill_New").val("");
                            $("#txtGrade_New").val("");
                            $("#txtSeamlength_New").val("");
                            $("#ShowOpDV").hide();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }
        }

        /// download excel data


        function fnExcelReport() {

            var sa;
            var strFileName = "OB_Data";
            var tab = document.getElementById('tblOPList');
            var tab_text = "<table border='2px'>";
            // Find the Action column index
            var actionColIndex = -1;
            var headerCells = tab.rows[0].cells;

            for (var i = 0; i < headerCells.length; i++) {
                if (headerCells[i].innerText.trim().toLowerCase() === "action") {
                    actionColIndex = i;
                    break;
                }
            }

            // Build table without Action column
            for (var j = 0; j < tab.rows.length; j++) {

                tab_text += "<tr>";
                var cells = tab.rows[j].cells;
                // Total columns to export (excluding Action column)
                var totalExportCols = cells.length - (actionColIndex !== -1 ? 1 : 0);
                var exportColIndex = 0;
                for (var i = 0; i < cells.length; i++) {

                    // Skip Action column
                    if (i === actionColIndex) {
                        continue;
                    }

                    var cellValue = cells[i].innerText.trim();
                    var tagName = cells[i].tagName.toLowerCase();
                    // Convert last exported column Yes/No -> 1/0
                    if (tagName !== "th" && exportColIndex === totalExportCols - 1) {
                        if (cellValue.toLowerCase() === "yes") {
                            cellValue = "1";
                        } else if (cellValue.toLowerCase() === "no") {
                            cellValue = "0";
                        }
                    }

                    if (tagName === "th") {
                        tab_text += "<th bgcolor='#87AFC6'>" + cellValue + "</th>";
                    }
                    else if (exportColIndex === 0) {
                        // First exported column as number
                        tab_text += "<td style=\"mso-number-format:'0';\">" + cellValue + "</td>";
                    }
                    else {
                        tab_text += "<td>" + cellValue + "</td>";
                    }

                    exportColIndex++;
                }

                tab_text += "</tr>";
            }

            tab_text += "</table>";

            // Remove hyperlinks, images and inputs
            tab_text = tab_text.replace(/<A[^>]*>|<\/A>/gi, "");
            tab_text = tab_text.replace(/<img[^>]*>/gi, "");
            tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

            var ua = window.navigator.userAgent;
            var msie = ua.indexOf("MSIE ");

            if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {

                txtArea1.document.open("txt/html", "replace");
                txtArea1.document.write(tab_text);
                txtArea1.document.close();
                txtArea1.focus();

                sa = txtArea1.document.execCommand("SaveAs", true, strFileName + ".xls");

            } else {

                var blob = new Blob([tab_text], {
                    type: "application/vnd.ms-excel"
                });

                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = strFileName + ".xls";

                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                URL.revokeObjectURL(link.href);
            }

            return sa;
        }

    </script>


