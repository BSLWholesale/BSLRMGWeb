
@{
    ViewBag.Title = "Operation";
}


@{
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script type="text/javascript">

        $(document).ready(function () {

            Fn_AutoComplete_Textbox("txtStyleCode", "StyleMaster", "StyleCode");
            Fn_Fill_DropdownList("ddlProcessName", "ProcessMaster", "ProcessName", "ID", "");

            // Fn_Get_Operation_BreackdownFile();

            ////// for search table data

            $("#txtSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                var rCount = 0;

                if ($("#tbodyList").length > 0) {
                    $("#tblOPList tbody tr").filter(function () {
                        var col3 = $(this).find("td:eq(3)").text().toLowerCase();
                        var col4 = $(this).find("td:eq(4)").text().toLowerCase();
                        var col5 = $(this).find("td:eq(5)").text().toLowerCase();
                        var match = col3.indexOf(value) > -1 || col4.indexOf(value) > -1 || col5.indexOf(value) > -1;

                        $(this).toggle(match);

                        if (match) {
                            rCount++;
                        }
                        $("#spTotalRowCount").html("Total OB : " + rCount);
                    });
                }
            });

            $("#btntoggle").click(function () {
                $("#dvAddNewOpRow").toggle();
            });

            $("#txtSearchDescription").on("keydown", function (e) {
                if (e.key === "Enter") {
                    Fn_Filter_OP_Detail();
                }
            });
        });

        function Fn_AutoComplete_Textbox(txtName, strTBLName, strFieldName) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vTBLName = strTBLName;

            $("#" + txtName).autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Production/Fn_AutoComplete_Textbox',
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term, strTBLName: strTBLName, strFieldName: strFieldName },
                        success: function (data) {
                            var obj = JSON.parse(data.message);
                            response($.map(obj, function (item) {
                                return { label: item.SearchKeyword, value: item.SearchKeyword };
                            }));
                        }
                    });
                },
                select: function (event, ui) {
                    var str = ui.item.value;
                }
            });
        }

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

        function Fn_Upload_Operation_BreackdownFile() {

            var clsOPBreackDownMaster = {};
            clsOPBreackDownMaster.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownMaster.StyleCode = $("#txtStyleCode").val();
            clsOPBreackDownMaster.ProcessName = $("#ddlProcessName option:selected").text();

            var MID = $("#hdnMID").val();
            if (MID == 0) {
                clsOPBreackDownMaster.ID = 0;
            }
            else {
                clsOPBreackDownMaster.ID = MID;
            }

            let formData = new FormData();
            let file = $("#fileEmpUploadExcel").get(0).files[0];

            formData.append("file", file);
            formData.append("CreatedBy", clsOPBreackDownMaster.CreatedBy);
            formData.append("StyleCode", clsOPBreackDownMaster.StyleCode);
            formData.append("ProcessName", clsOPBreackDownMaster.ProcessName);
            formData.append("ID", clsOPBreackDownMaster.ID);

            if (!file) {
                Swal.fire({ title: "", text: "Please upload opeartion file", icon: "error" });
            }
            else if (clsOPBreackDownMaster.StyleCode == "") {
                Swal.fire({ title: "", text: "Please Enter Style Code", icon: "error" });
            }
            else if (clsOPBreackDownMaster.ProcessName == "0") {
                Swal.fire({ title: "", text: "Please select Process Name", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Upload_Operation_BreackdownFile",
                    data: formData,
                    processData: false,
                    contentType: false,
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {

                            Swal.fire({ title: "", text: "Operation file uploaded successfully", icon: "success" });
                            const EmpDataExcelFile = document.getElementById('fileEmpUploadExcel');
                            EmpDataExcelFile.value = '';
                            Fn_Get_Operation_BreackdownFile();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }

                    },
                    complete: function (data) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }

        }


        function Fn_ResetFields() {
            const EmpDataExcelFile = document.getElementById('fileEmpUploadExcel');
            EmpDataExcelFile.value = '';
            $("#txtStyleCode").val("");
            $("#ddlProcessName").val("0");
        }

        function Fn_Downlod_Operation_Template_ExcelFile() {
            window.open('/DOC/Operation Sequence.xlsx', '_blank');
        }

        function Fn_Get_Operation_BreackdownFile() {
            var clsOPBreackDownMaster = {};
            clsOPBreackDownMaster.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownMaster.StyleCode = $("#txtStyleCode").val();
            clsOPBreackDownMaster.ProcessName = $("#ddlProcessName option:selected").text();
            $("#tbodyList").html('');
            var html = '';
            $("#spTotalRowCount").html('')
            if (clsOPBreackDownMaster.StyleCode == "") {
                Swal.fire({ title: "", text: "Please enter stylecode", icon: "error" });
                $("#ddlProcessName").val("0");
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Get_Operation_BreackdownFile",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownMaster),
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj[0].vErrorMsg == "Success") {
                            var rCount = 0;
                            for (var i = 0; i < obj.length; i++) {
                                rCount++;
                                html += "<tr>";
                                html += "<td>" + obj[i].SeqNo + "</td>";
                                html += "<td>" + obj[i].Descriptions + "</td>";
                                html += "<td>" + obj[i].StdMin + "</td>";
                                html += "<td>" + obj[i].OpNo + "</td>";
                                html += "<td>" + obj[i].Machine + "</td>";
                                html += "<td>" + obj[i].SubSection + "</td>";
                                html += "<td>" + obj[i].ProgressPoint + "</td>";
                                // html += "<td>" + obj[i].IsDispatch + "</td>";
                                if (obj[i].IsDispatch == true) {
                                    html += "<td><span class='label label-success label-mini'>Yes</span></td>";
                                }
                                else {
                                    html += "<td><span class='label label-warning label-mini'>No</span></td>";
                                }
                                // html += "<td>" + obj[i].IsDirect + "</td>";
                                if (obj[i].IsDirect == true) {
                                    html += "<td><span class='label label-success label-mini'>Yes</span></td>";
                                }
                                else {
                                    html += "<td><span class='label label-warning label-mini'>No</span></td>";
                                }
                                html += "<td>" + obj[i].DependOPNO + "</td>";
                                // html += "<td>" + obj[i].IsDS + "</td>";
                                if (obj[i].IsDS == true) {
                                    html += "<td><span class='label label-success label-mini'>Yes</span></td>";
                                }
                                else {
                                    html += "<td><span class='label label-warning label-mini'>No</span></td>";
                                }
                                //html += "<td>";
                                //html += "<a href='javascript: void (0);' class='btn btn-xs btn-info'><i class='fa fa-edit' onclick='Fn_Edit_Process(" + obj[i].DetailID + ")'></i></a>";
                                //html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-danger'><i class='fa fa-trash' onclick=\"Fn_Delete_Process('" + obj[i].DetailID + "')\"></i></a>";
                                //html += "</td>";
                                html += "</tr>";
                            }
                            $('#btnUpload').attr('disabled', 'disabled');
                            $("#spTotalRowCount").html("Total OB : " + rCount);
                            $(".clsdvSerch").show();
                        }
                        else {
                            html += "<tr><td colspan='12' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                            $('#btnUpload').removeAttr('disabled');
                            $(".clsdvSerch").hide();
                        }
                        $("#tbodyList").append(html);

                    },
                    complete: function (data) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });

                    }
                });
            }

        }

        /////////////////

        function Fn_Check_Exist_style_In_Master() {

            var clsOPBreackDownMaster = {};
            clsOPBreackDownMaster.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownMaster.StyleCode = $("#txtStyleCode").val();
            clsOPBreackDownMaster.ProcessName = $("#ddlProcessName option:selected").text();

            if (clsOPBreackDownMaster.StyleCode == "") {
                Swal.fire({ title: "", text: "Please Enter Style Code", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Check_Exist_style_In_Master",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownMaster),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            $("#hdnMID").val(obj.ID);
                        }
                        else {
                            $("#hdnMID").val(0);
                        }
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }

        }

        function Fn_OnDDLChange() {
            Fn_Check_Exist_style_In_Master();
            Fn_Get_Operation_BreackdownFile();
        }

        //////////////// new change for add new op 10-JUN-2026
       

        function Fn_Open_Add_Popup() {

            $("#AddOBModal").modal('show');
            var ddlProduct = $("#ddlProduct").val();
            $("#txtProduct").val(ddlProduct);
            Fn_Fill_DropdownList("ddlSubSection", "OBMainMasterNew", "SubSection", "", "");
            Fn_Fill_DropdownList("ddlMachine", "OBMainMasterNew", "Machine", "", "");
        }

        function Fn_Filter_OP_Detail() {

            var clsOPBreackDownDetail = {};
            const ddlFielName = $("#ddlFielName").val();

            switch (ddlFielName) {
                case "Description":
                    clsOPBreackDownDetail.Descriptions = $("#txtSearchDescription").val();
                    break;
                case "OpNo":
                    clsOPBreackDownDetail.OpNo = $("#txtSearchDescription").val();
                    break;
                case "Product":
                    clsOPBreackDownDetail.Product = $("#txtSearchDescription").val();
                    break;
                case "Machine":
                    clsOPBreackDownDetail.Machine = $("#txtSearchDescription").val();
                    break;
                case "Skill":
                    clsOPBreackDownDetail.Skill = $("#txtSearchDescription").val();
                    break;
                case "SubSection":
                    clsOPBreackDownDetail.SubSection = $("#txtSearchDescription").val();
                    break;
                default:
                    Swal.fire({ title: "", text: "Please Select Field", icon: "error" });
                    return;
            }

            clsOPBreackDownDetail.CreatedBy = sessionStorage.getItem("LogInID");
            $("#tbodySearchOP").html('');
            var html = '';
            $("#spTotalRowCount").html('')
            if ($("#ddlFielName").val() == "0") {
                Swal.fire({ title: "", text: "Please Select Field", icon: "error" });
            }
            else if ($("#txtSearchDescription").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Description", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Filter_OP_Detail",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownDetail),
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        var opNo = 0;
                        if (obj[0].vErrorMsg == "Success") {
                            for (var i = 0; i < obj.length; i++) {

                                if (obj[i].OpNo != opNo) {
                                    html += "<tr>";
                                    html += "<td>" + obj[i].OpNo + "</td>";
                                    html += "<td>" + obj[i].Descriptions + "</td>";
                                    html += "<td>" + obj[i].StdMin + " / " + obj[i].Rate + "</td>";
                                    html += "<td>" + obj[i].Machine + " / " + obj[i].Skill + " / " + obj[i].Grade + " / " + obj[i].Product + " / " + obj[i].SubSection + "</td>";
                                    html += "<td>" + obj[i].Folder + "</td>";
                                    html += "<td>";
                                    html += "<a href='javascript: void (0);' class='btn btn-xs btn-success'><i onclick=\"Fn_Append_New_OpNo('" + obj[i].OpNo + "')\" class='fa fa-shopping-cart'></i></a>";
                                    html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-danger'><i class='fa fa-trash' onclick=\"Fn_Delete_Process('" + obj[i].OpNo + "')\"></i></a>";
                                    html += "</td>";
                                    html += "</tr>";
                                    opNo = obj[i].OpNo;
                                }
                            }
                        }
                        else {
                            html += "<tr><td colspan='5' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                        }
                        $("#tbodySearchOP").append(html);
                        $("#tblSearchOP").show();
                    },
                    complete: function (data) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });

                    }
                });
            }
        }

        function Fn_Append_New_OpNo(OpNo) {

            var clsOPBreackDownDetail = {};
           
            clsOPBreackDownDetail.OpNo = OpNo;
            clsOPBreackDownDetail.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownDetail.Folder = $("#txtStyleCode").val();

            if (OpNo == "0" || OpNo == 0 || OpNo == null) {
                Swal.fire({ title: "", text: "Please Enter OpNo", icon: "error" });
            }
            else if ($("#txtStyleCode").val() == "") {
                Swal.fire({ title: "", text: "Please Enter StyleCode", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Append_New_OpNo",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownDetail),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Swal.fire({ title: "", text: "Added new record successfully.", icon: "success" });
                            Fn_Get_Operation_BreackdownFile();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }
        }

        function Fn_Add_New_OpNo() {

            var clsOPBreackDownDetail = {};

            clsOPBreackDownDetail.Product = $("#txtProduct").val();
            clsOPBreackDownDetail.Descriptions = $("#txtDescription").val();
            clsOPBreackDownDetail.OpNo = $("#txtOpNo").val();
            clsOPBreackDownDetail.Machine = $("#ddlMachine").val();
            clsOPBreackDownDetail.SubSection = $("#ddlSubSection").val();
            clsOPBreackDownDetail.StdMin = $("#txtStdMin").val();
            clsOPBreackDownDetail.Rate = $("#txtRate").val();
            clsOPBreackDownDetail.CreatedBy = sessionStorage.getItem("LogInID");

            if ($("#txtProduct").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Product", icon: "error" });
            }
            else if ($("#txtDescription").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Descriptions", icon: "error" });
            }
            else if ($("#txtOpNo").val() == "" || $("#txtOpNo").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter OpNo", icon: "error" });
            }
            else if ($("#ddlMachine").val() == "0") {
                Swal.fire({ title: "", text: "Please Select Machine", icon: "error" });
            }
            else if ($("#ddlSubSection").val() == "0") {
                Swal.fire({ title: "", text: "Please Select SubSection", icon: "error" });
            }
            else if ($("#txtStdMin").val() == "" || $("#txtStdMin").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter StdMin", icon: "error" });
            }
            else if ($("#txtRate").val() == "" || $("#txtRate").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter Rate", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Add_New_OpNo",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownDetail),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Swal.fire({ title: "", text: "Added new record successfully.", icon: "success" });
                            $("#txtProduct").val("");
                            $("#txtDescription").val("");
                            $("#txtOpNo").val("");
                            $("#ddlMachine").val("0");
                            $("#ddlSubSection").val("0");
                            $("#txtStdMin").val("");
                            $("#txtRate").val("");


                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }
        }

    </script>
    

