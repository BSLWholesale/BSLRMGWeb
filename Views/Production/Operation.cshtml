        function Fn_Add_New_OpNo_IN_OBD() {

            var clsOPBreackDownDetail = {};

            clsOPBreackDownDetail.Descriptions = $("#txtDescription_New").val();
            clsOPBreackDownDetail.OpNo = $("#txtOpNo_New").val();
            clsOPBreackDownDetail.SeqNo = $("#txtSeqNo_New").val();
            clsOPBreackDownDetail.Machine = $("#txtMachine_New").val();
            clsOPBreackDownDetail.SubSection = $("#txtSubSection_New").val();
            clsOPBreackDownDetail.Rate = $("#txtRate_New").val();
            clsOPBreackDownDetail.StdMin = $("#txtStdMin_New").val();
            clsOPBreackDownDetail.Product = $("#txtProduct_New").val();
            clsOPBreackDownDetail.Skill = $("#txtSkill_New").val();
            clsOPBreackDownDetail.Grade = $("#txtGrade_New").val();
            clsOPBreackDownDetail.Seamlength = $("#txtSeamlength_New").val();
            clsOPBreackDownDetail.Folder = "NA";
            clsOPBreackDownDetail.IsDirect = true;
            clsOPBreackDownDetail.IsDispatch = false;
            clsOPBreackDownDetail.IsDS = false;
            clsOPBreackDownDetail.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownDetail.CreatedOn = $("#txtStyleCode").val();

            if ($("#txtStyleCode").val() == "") {
                Swal.fire({ title: "", text: "Please Enter StyleCode", icon: "error" });
            }
            else if ($("#txtDescription_New").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Descriptions", icon: "error" });
            }
            else if ($("#txtOpNo_New").val() == "" || $("#txtOpNo").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter OpNo", icon: "error" });
            }
