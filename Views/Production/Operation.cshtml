
@{
    ViewBag.Title = "Operation";
}


@{    

    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            Fn_AutoComplete_Textbox("txtStyleCode", "StyleMaster", "StyleCode");
            Fn_Fill_DropdownList("ddlProcessName", "ProcessMaster", "ProcessName", "ID", "");

            // Fn_Get_Operation_BreackdownFile();

            ////// for search table data

            $("#txtSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                var rCount = 0;

                if ($("#tbodyList").length > 0) {
                    $("#tblOPList tbody tr").filter(function () {
                        var col3 = $(this).find("td:eq(3)").text().toLowerCase();
                        var col4 = $(this).find("td:eq(4)").text().toLowerCase();
                        var col5 = $(this).find("td:eq(5)").text().toLowerCase();
                        var match = col3.indexOf(value) > -1 || col4.indexOf(value) > -1 || col5.indexOf(value) > -1;

                        $(this).toggle(match);

                        if (match) {
                            rCount++;
                        }
                        $("#spTotalRowCount").html("Total OB : " + rCount);
                    });
                }
            });

            $("#btntoggle").click(function () {
                $("#dvAddNewOpRow").toggle();
                $("#ShowOpDV").hide();
            });

            $("#btnShowOpDV").click(function () {

                if ($("#ShowOpDV").is(":visible")) {
                    $("#ShowOpDV").hide();
                } else {
                    $("#ShowOpDV").show();
                    Fn_AutoComplete_Textbox("txtMachine_New", "OperationBreackDownDetail", "Machine");
                    Fn_AutoComplete_Textbox("txtSubSection_New", "OperationBreackDownDetail", "SubSection");
                    Fn_AutoComplete_Textbox("txtProduct_New", "OperationBreackDownDetail", "Product");
                    Fn_AutoComplete_Textbox("txtSkill_New", "OperationBreackDownDetail", "Skill");
                    Fn_AutoComplete_Textbox("txtGrade_New", "OperationBreackDownDetail", "Grade");
                }
            });

            $("#txtSearchDescription").on("keydown", function (e) {
                if (e.key === "Enter") {
                    Fn_Filter_OP_Detail();
                }
            });
        });

        function Fn_AutoComplete_Textbox(txtName, strTBLName, strFieldName) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vTBLName = strTBLName;

            $("#" + txtName).autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Production/Fn_AutoComplete_Textbox',
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term, strTBLName: strTBLName, strFieldName: strFieldName },
                        success: function (data) {
                            var obj = JSON.parse(data.message);
                            response($.map(obj, function (item) {
                                return { label: item.SearchKeyword, value: item.SearchKeyword };
                            }));
                        }
                    });
                },
                select: function (event, ui) {
                    var str = ui.item.value;
                }
            });
        }

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

        function Fn_Upload_Operation_BreackdownFile() {

            var clsOPBreackDownMaster = {};
            clsOPBreackDownMaster.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownMaster.StyleCode = $("#txtStyleCode").val();
            clsOPBreackDownMaster.ProcessName = $("#ddlProcessName option:selected").text();

            var MID = $("#hdnMID").val();
            if (MID == 0) {
                clsOPBreackDownMaster.ID = 0;
            }
            else {
                clsOPBreackDownMaster.ID = MID;
            }

            let formData = new FormData();
            let file = $("#fileEmpUploadExcel").get(0).files[0];

            formData.append("file", file);
            formData.append("CreatedBy", clsOPBreackDownMaster.CreatedBy);
            formData.append("StyleCode", clsOPBreackDownMaster.StyleCode);
            formData.append("ProcessName", clsOPBreackDownMaster.ProcessName);
            formData.append("ID", clsOPBreackDownMaster.ID);

            if (!file) {
                Swal.fire({ title: "", text: "Please upload opeartion file", icon: "error" });
            }
            else if (clsOPBreackDownMaster.StyleCode == "") {
                Swal.fire({ title: "", text: "Please Enter Style Code", icon: "error" });
            }
            else if (clsOPBreackDownMaster.ProcessName == "0") {
                Swal.fire({ title: "", text: "Please select Process Name", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Upload_Operation_BreackdownFile",
                    data: formData,
                    processData: false,
                    contentType: false,
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {

                            Swal.fire({ title: "", text: "Operation file uploaded successfully", icon: "success" });
                            const EmpDataExcelFile = document.getElementById('fileEmpUploadExcel');
                            EmpDataExcelFile.value = '';
                            Fn_Get_Operation_BreackdownFile();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }

                    },
                    complete: function (data) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }

        }


        function Fn_ResetFields() {
            const EmpDataExcelFile = document.getElementById('fileEmpUploadExcel');
            EmpDataExcelFile.value = '';
            $("#txtStyleCode").val("");
            $("#ddlProcessName").val("0");
        }

        function Fn_Downlod_Operation_Template_ExcelFile() {

            Swal.fire({
                title: 'Download File?',
                text: 'Do you want to download the Excel with data?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Download Template',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    fnExcelReport();
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    window.open('/DOC/Operation Sequence.xlsx', '_blank');
                }
            });
        }

        function Fn_Get_Operation_BreackdownFile() {
            var clsOPBreackDownMaster = {};
            clsOPBreackDownMaster.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownMaster.StyleCode = $("#txtStyleCode").val();
            clsOPBreackDownMaster.ProcessName = $("#ddlProcessName option:selected").text();
            $("#tbodyList").html('');
            var html = '';
            $("#spTotalRowCount").html('')
            if (clsOPBreackDownMaster.StyleCode == "") {
                Swal.fire({ title: "", text: "Please enter stylecode", icon: "error" });
                $("#ddlProcessName").val("0");
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Get_Operation_BreackdownFile",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownMaster),
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj[0].vErrorMsg == "Success") {
                            var rCount = 0;
                            for (var i = 0; i < obj.length; i++) {
                                rCount++;
                                html += "<tr id='row_" + rCount + "'>";
                                html += "<td id='SeqNo_row_" + rCount + "'>" + obj[i].SeqNo + "</td>";
                                html += "<td id='OpNo_row_" + rCount + "'>" + obj[i].OpNo + "</td>";
                                html += "<td id='Descriptions_row_" + rCount + "'>" + obj[i].Descriptions + "</td>";
                                html += "<td id='Machine_row_" + rCount + "'>" + obj[i].Machine + "</td>";
                                html += "<td id='SubSection_row_" + rCount + "'>" + obj[i].SubSection + "</td>";
                                html += "<td id='StdMin_row_" + rCount + "'>" + obj[i].StdMin + "</td>";
                                html += "<td id='Rate_row_" + rCount + "'>" + obj[i].Rate + "</td>";
                                html += "<td id='Product_row_" + rCount + "'>" + obj[i].Product + "</td>";
                                html += "<td id='Skill_row_" + rCount + "'>" + obj[i].Skill + "</td>";
                                html += "<td id='Grade_row_" + rCount + "'>" + obj[i].Grade + "</td>";
                                html += "<td id='Folder_row_" + rCount + "'>" + obj[i].Folder + "</td>";

                                // Action buttons
                                html += "<td id='Action_row_" + rCount + "' style='white-space:nowrap;'>";
                                html += "<button type='button' id='edit_button" + rCount + "' onclick=\"Fn_Edit_OB_Row(" + rCount + ", '" + obj[i].MID + "')\" class='btn btn-xs btn-info' title='Edit'><i class='fa fa-edit'></i></button> ";
                                html += "<button type='button' id='save_button" + rCount + "' onclick=\"Fn_Save_OB_Row(" + rCount + ", '" + obj[i].DetailID + "', '" + obj[i].MID + "')\" style='display:none;' class='btn btn-xs btn-success' title='Save'><i class='fa fa-check'></i></button> ";
                                html += "<button type='button' id='cancel_button" + rCount + "' onclick='Fn_Cancel_OB_Row(" + rCount + ")' style='display:none;' class='btn btn-xs btn-warning' title='Cancel'><i class='fa fa-times'></i></button> ";
                                html += "<button type='button' onclick=\"Fn_Delete_OpNo_IN_OBD('" + obj[i].DetailID + "', '" + obj[i].MID + "', '" + obj[i].OpNo + "')\" class='btn btn-xs btn-danger' title='Delete'><i class='fa fa-trash'></i></button>";
                                html += "</td>";
                                html += "</tr>";
                            }
                            $('#btnUpload').attr('disabled', 'disabled');
                            $("#spTotalRowCount").html("Total OB : " + rCount);
                            $(".clsdvSerch").show();
                        }
                        else {
                            html += "<tr><td colspan='12' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                            $('#btnUpload').removeAttr('disabled');
                            $(".clsdvSerch").hide();
                        }
                        $("#tbodyList").append(html);

                    },
                    complete: function (data) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });

                    }
                });
            }

        }

        function Fn_Edit_OB_Row(rowNo, Mid) {

            // Save original values for Cancel
            var row = $("#row_" + rowNo);

            row.data("old-values", {
                OpNo: $("#OpNo_row_" + rowNo).text(),
                SubSection: $("#SubSection_row_" + rowNo).text(),
                Rate: $("#Rate_row_" + rowNo).text(),
            });

            // Convert TD to input
            
            $("#OpNo_row_" + rowNo).html(
                "<input type='text' class='form-control input-sm' value='" +
                $("#OpNo_row_" + rowNo).text() + "' readonly='readonly'>"
            );           

            $("#Rate_row_" + rowNo).html(
                "<input type='text' class='form-control input-sm' value='" +
                $("#Rate_row_" + rowNo).text() + "'>"
            );

            ////////////////////////

            var subSectionHtml = "<select class='form-control input-sm' id='SubSection_input_" + rowNo + "'>";
            subSectionHtml += "</select>";
            $("#SubSection_row_" + rowNo).html(subSectionHtml);
            var strCriteria = " AND MID=" + Mid + "";
            Fn_Fill_DropdownList("SubSection_input_" + rowNo, "OperationBreackDownDetail", "SubSection", "", strCriteria);

            ////////////////////////

            // Show Save + Cancel
            $("#edit_button" + rowNo).hide();
            $("#save_button" + rowNo).show();
            $("#cancel_button" + rowNo).show();
        }

        function Fn_Save_OB_Row(rowNo, DetailID, Mid) {

            var row = $("#row_" + rowNo);

            var OpNo = $("#OpNo_row_" + rowNo + " input").val();
            var SubSection = $("#SubSection_row_" + rowNo + " select").val();
            var Rate = $("#Rate_row_" + rowNo + " input").val();

            // Put values back into TD
            $("#OpNo_row_" + rowNo).text(OpNo);
            $("#SubSection_row_" + rowNo).text(SubSection);
            $("#Rate_row_" + rowNo).text(Rate);

            // Hide Save + Cancel
            $("#save_button" + rowNo).hide();
            $("#cancel_button" + rowNo).hide();
            $("#edit_button" + rowNo).show();

            Swal.fire({
                title: 'Are your sure?',
                text: "Do you want to change?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes',
            }).then((result) => {
                if (result.isConfirmed) {
                    var clsOPBreackDownDetail = {};
                    clsOPBreackDownDetail.DetailID = DetailID;
                    clsOPBreackDownDetail.OpNo = OpNo;
                    clsOPBreackDownDetail.MID = Mid;
                    clsOPBreackDownDetail.SubSection = SubSection;
                    clsOPBreackDownDetail.Rate = Rate;
                    clsOPBreackDownDetail.CreatedBy = sessionStorage.getItem("LogInID");
                    clsOPBreackDownDetail.CreatedOn = $("#txtStyleCode").val();
                    $.ajax({
                        type: "POST",
                        url: "/Order/Fn_Update_OpNo_IN_OBD",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        data: JSON.stringify(clsOPBreackDownDetail),
                        success: function (data) {
                            var obj = JSON.parse(data.message);
                            if (obj.vErrorMsg == "Success") {
                                Swal.fire({ title: "", text: "OpNo deleted successfully.", icon: "success" });
                                Fn_Get_Operation_BreackdownFile();
                            }
                            else {
                                Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                            }
                        },
                        error: function (err) {
                            alert(err);
                        }
                    });
                }
                else {
                    return false;
                }
            });
        }

        function Fn_Cancel_OB_Row(rowNo) {

            var row = $("#row_" + rowNo);
            var oldValues = row.data("old-values");

            if (!oldValues) {
                return;
            }

            // Restore original values

            $("#OpNo_row_" + rowNo).text(oldValues.OpNo);
            $("#SubSection_row_" + rowNo).text(oldValues.SubSection);
            $("#Rate_row_" + rowNo).text(oldValues.Rate);            

            $("#save_button" + rowNo).hide();
            $("#cancel_button" + rowNo).hide();
            $("#edit_button" + rowNo).show();
        }

        /////////////////

        function Fn_Check_Exist_style_In_Master() {

            var clsOPBreackDownMaster = {};
            clsOPBreackDownMaster.CreatedBy = sessionStorage.getItem("LogInID");
            clsOPBreackDownMaster.StyleCode = $("#txtStyleCode").val();
            clsOPBreackDownMaster.ProcessName = $("#ddlProcessName option:selected").text();

            if (clsOPBreackDownMaster.StyleCode == "") {
                Swal.fire({ title: "", text: "Please Enter Style Code", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Check_Exist_style_In_Master",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownMaster),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            $("#hdnMID").val(obj.ID);
                        }
                        else {
                            $("#hdnMID").val(0);
                        }
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }

        }

        function Fn_OnDDLChange() {
            Fn_Check_Exist_style_In_Master();
            Fn_Get_Operation_BreackdownFile();
        }

        //////////////// new change for add new op 10-JUN-2026

        function Fn_Filter_OP_Detail() {

            var clsOPBreackDownDetail = {};
            const ddlFielName = $("#ddlFielName").val();

            switch (ddlFielName) {
                case "Description":
                    clsOPBreackDownDetail.Descriptions = $("#txtSearchDescription").val();
                    break;
                case "OpNo":
                    clsOPBreackDownDetail.OpNo = $("#txtSearchDescription").val();
                    break;
                case "Product":
                    clsOPBreackDownDetail.Product = $("#txtSearchDescription").val();
                    break;
                case "Machine":
                    clsOPBreackDownDetail.Machine = $("#txtSearchDescription").val();
                    break;
                case "Skill":
                    clsOPBreackDownDetail.Skill = $("#txtSearchDescription").val();
                    break;
                case "SubSection":
                    clsOPBreackDownDetail.SubSection = $("#txtSearchDescription").val();
                    break;
                default:
                    Swal.fire({ title: "", text: "Please Select Field", icon: "error" });
                    return;
            }

            clsOPBreackDownDetail.CreatedBy = sessionStorage.getItem("LogInID");
            $("#tbodySearchOP").html('');
            var html = '';
            $("#spTotalRowCount").html('')
            if ($("#ddlFielName").val() == "0") {
                Swal.fire({ title: "", text: "Please Select Field", icon: "error" });
            }
            else if ($("#txtSearchDescription").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Description", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Filter_OP_Detail",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOPBreackDownDetail),
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        var opNo = 0;
                        if (obj[0].vErrorMsg == "Success") {
                            for (var i = 0; i < obj.length; i++) {

                                if (obj[i].OpNo != opNo) {
                                    html += "<tr>";
                                    html += "<td>" + obj[i].OpNo + "</td>";
                                    html += "<td>" + obj[i].Descriptions + "</td>";
                                    html += "<td>" + obj[i].StdMin + " / " + obj[i].Rate + "</td>";
                                    html += "<td>" + obj[i].Machine + " / " + obj[i].Skill + " / " + obj[i].Grade + " / " + obj[i].Product + " / " + obj[i].SubSection + "</td>";
                                    html += "<td>" + obj[i].Folder + "</td>";
                                    html += "<td>";
                                    html += "<a href='javascript: void (0);' class='btn btn-xs btn-success'><i onclick=\"Fn_Append_New_OpNo('" + obj[i].OpNo + "')\" class='fa fa-shopping-cart'></i></a>";
                                    html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-danger delete_tblSearchOP_row'><i class='fa fa-trash'></i></a>";
                                    html += "</td>";
                                    html += "</tr>";
                                    opNo = obj[i].OpNo;
                                }
                            }
                        }
                        else {
                            html += "<tr><td colspan='5' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                        }
                        $("#tbodySearchOP").append(html);
                        $("#tblSearchOP").show();
                    },
                    complete: function (data) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });

                    }
                });
            }
        }

        $(document).on('click', '.delete_tblSearchOP_row', function () {
            $(this).closest('tr').remove();
        });

