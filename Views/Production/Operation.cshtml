            else if ($("#txtSubSection_New").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter SubSection", icon: "error" });
            }
            else if ($("#txtStdMin_New").val() == 0 || $("#txtStdMin_New").val() == "0" || $("#txtStdMin_New").val() == null) {
                Swal.fire({ title: "", text: "Please Enter StdMin", icon: "error" });
