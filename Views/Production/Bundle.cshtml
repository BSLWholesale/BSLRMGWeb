        function Fn_Delete_Bundle_Layer(Layid) {
            var clsBundleLayerMaster = {};
            clsBundleLayerMaster.LayID = Layid;
            clsBundleLayerMaster.CreatedBy = sessionStorage.getItem("LogInID");
