                var inputs = row.find('input[type="text"]');

                var checkbox = row.find('input[type="checkbox"]');
                var isChecked = checkbox.is(':checked');

                if (isChecked) {
                    var clsBundleSize = {};
                    clsBundleSize.CreatedBy = sessionStorage.getItem("LogInID");
                    clsBundleSize.LayID = $("#hdnLayID").val();
