        function fn_Check_Value() {

            let checkboxes = document.getElementsByName('chkSubsection');
            let selectedValues = [];

            for (let i = 0; i < checkboxes.length; i++) {
                if (checkboxes[i].checked) {
                    selectedValues.push("'" + checkboxes[i].value + "'");
                }
            }
            let result = selectedValues.join(", ");
            
            if (result === "") {
                Swal.fire({ title: "", text: "Please check at least one checkbox", icon: "error" });
            }
            else if (result.includes("POST ASSEMBLY")) {
                Fn_Get_POST_ASSEMBLY_QR_Data(result);
            }
            else {
                Fn_Get_SectionWis_Compile_QR_Data(result);
            }
        }

