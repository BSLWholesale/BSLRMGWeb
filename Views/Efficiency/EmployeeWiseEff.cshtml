
@{
    ViewBag.Title = "EmployeeWiseEff";
}

@{


    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>
    <link href="~/web/css/select2.min.css" rel="stylesheet" />
    <script type="text/javascript">

        $(document).ready(function () {

            Fn_Fill_DropdownList("ddlOrderNo", "vPieceRateReport", "OrderNo", "", "");

            var strFieldName = " CONCAT(EmpName, ' (', Code, ')') AS EmpName ";
            Fn_Fill_DropdownList("ddlAppEmp", "vPieceRateReport", strFieldName, "Code", "");
            Fn_Fill_DropdownList("ddlLineName", "vPieceRateReport", "LineName", "", "");

            $("#txtFromDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());
            $("#txtToDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());

        });

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }


        function fnExcelReport() {
            var sa;
            var tab = "";
            var StartDate = $("#txtFromDate").val();
            var EndDate = $("#txtToDate").val();

            tab = document.getElementById('tblEmployeeWise');
            var strFileName = "EmployeeWise_Efficiency_Report";
            var tab_text = "<table border='2px'>";

            tab_text += "<tr>";
            tab_text += "<td colspan='18' style='font-weight:bold;font-size:16px;text-align:left;background:#DCE6F1;'>";
            tab_text += strFileName;
            tab_text += "</td>";
            tab_text += "</tr>";

            // Date Row
            tab_text += "<tr>";
            tab_text += "<td style='font-weight:bold; text-align:left'>From Date</td>";
            tab_text += "<td colspan='6' style='font-weight:bold; text-align:left'>" + StartDate + "</td>";
            tab_text += "<td colspan='4'></td>";
            tab_text += "<td style='font-weight:bold; text-align:left'>To Date</td>";
            tab_text += "<td colspan='6' style='font-weight:bold; text-align:left'>" + EndDate + "</td>";
            tab_text += "</tr>";


            for (var j = 0; j < tab.rows.length; j++) {
                tab_text += "<tr>";

                var cells = tab.rows[j].cells;

                for (var i = 0; i < cells.length; i++) {

                    var cellValue = cells[i].innerText.trim();
                    var tagName = cells[i].tagName.toLowerCase();

                    if (tagName === "th") {
                        tab_text += "<th bgcolor='#87AFC6'>" + cellValue + "</th>";
                    }
                    else if (i === 0) {
                        tab_text += "<td style=\"mso-number-format:'0';\">" + cellValue + "</td>";
                    }
                    else {
                        tab_text += "<td>" + cellValue + "</td>";
                    }
                }

                tab_text += "</tr>";
            }

            tab_text += "</table>";

            tab_text = tab_text.replace(/<A[^>]*>|<\/A>/g, "");
            tab_text = tab_text.replace(/<img[^>]*>/gi, "");
            tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

            var ua = window.navigator.userAgent;
            var msie = ua.indexOf("MSIE ");

            if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {
                txtArea1.document.open("txt/html", "replace");
                txtArea1.document.write(tab_text);
                txtArea1.document.close();
                txtArea1.focus();
                sa = txtArea1.document.execCommand("SaveAs", true, "report.xls");
            } else {
                var fileName = strFileName;  //"MyReport.xls"; // change dynamically if needed

                var blob = new Blob([tab_text], {
                    type: "application/vnd.ms-excel"
                });

                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = fileName;

                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }

            return sa;
        }

        var efficiencyIsLoading = false;
        var efficiencyHasMoreData = true;
        var efficiencyPageNumber = 1;
        var efficiencyPageSize = 500;
        var efficiencyTotalRows = 0;

        var grandTotalQty = 0;
        var grandTotalProdMin = 0;
        var grandTotalAmount = 0;
        var grandTotalManualQty = 0;
        var grandTotalQrScanQty = 0;

        function Fn_Get_EmployeeWiseEfficiency(isScroll) {

            if (efficiencyIsLoading) {
                return;
            }

            if (isScroll && !efficiencyHasMoreData) {
                return;
            }

            if (!isScroll) {

                efficiencyPageNumber = 1;
                efficiencyHasMoreData = true;
                efficiencyTotalRows = 0;

                grandTotalQty = 0;
                grandTotalProdMin = 0;
                grandTotalAmount = 0;
                grandTotalManualQty = 0;
                grandTotalQrScanQty = 0;

                $("#tbodyEmployeeWise").html("");
                $("#trGrandTotal").remove();
                $("#spTotalRowCount").html("Loaded Rows: 0");
                $("#btnExcel").hide();
            }

            var clsEfficiencyReq = {};

            if ($("#txtFromDate").val() != "") {
                clsEfficiencyReq.StartDate = $("#txtFromDate").val();
            }
            if ($("#txtToDate").val() != "") {
                clsEfficiencyReq.EndDate = $("#txtToDate").val();
            }
            if ($("#ddlLineName").val() != "0") {
                clsEfficiencyReq.LineName = $("#ddlLineName").val();
            }
            if ($("#ddlOrderNo").val() != "0") {
                clsEfficiencyReq.OrderNo = $("#ddlOrderNo").val();
            }
            if ($("#ddlAppEmp").val() != "0") {
                clsEfficiencyReq.Code = $("#ddlAppEmp").val();
            }

            clsEfficiencyReq.QueryType = "Select_EmployeeWise";
            clsEfficiencyReq.PageNumber = efficiencyPageNumber;
            clsEfficiencyReq.PageSize = efficiencyPageSize;
            $.ajax({
                type: "POST",
                url: "/Efficiency/Fn_Get_EmployeeWiseEfficiency",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsEfficiencyReq),
                beforeSend: function () {
                    efficiencyIsLoading = true;
                    if (!isScroll) {
                        $("#loader").show();
                        $("#dvMain").hide();
                    }

                    $("#dvEfficiencyLoading").remove();
                },
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (!obj || obj.length == 0) {
                        efficiencyHasMoreData = false;
                        if (!isScroll) {

                            $("#tbodyEmployeeWise").html("<tr><td colspan='18' class='text-center'>No records found</td></tr>");
                            $("#spTotalRowCount").html("Loaded Rows: 0");
                        }

                        $("#btnExcel").hide();
                        return;
                    }
                    if (obj[0].vErrorMsg != "Success") {
                        efficiencyHasMoreData = false;
                        if (!isScroll) {
                            $("#tbodyEmployeeWise").html("<tr><td colspan='18' class='text-center' style='color:black;font-weight:800;'>" + obj[0].vErrorMsg + "</td></tr>");
                            $("#spTotalRowCount").html("Loaded Rows: 0");
                        }
                        $("#btnExcel").hide();
                        return;
                    }

                    if (obj[0].TotalRows !== undefined) {

                        efficiencyTotalRows = Number(obj[0].TotalRows || 0);
                    }

                    var html = "";
                    var currentPageRows = 0;
                    for (var i = 0; i < obj.length; i++) {
                        if (obj[i].vErrorMsg != "Success") {
                            continue;
                        }

                        var qty = Number(obj[i].Qty || 0);
                        var prodMin = Number(obj[i].ProductionMinute || 0);
                        var amount = Number(obj[i].Amount || 0);
                        var manualQty = Number(obj[i].ManualQty || 0);
                        var qrScanQty = Number(obj[i].QrScanQty || 0);
                        grandTotalQty += qty;
                        grandTotalProdMin += prodMin;
                        grandTotalAmount += amount;
                        grandTotalManualQty += manualQty;
                        grandTotalQrScanQty += qrScanQty;
                        currentPageRows++;
                        html += "<tr class='employee-efficiency-row'>";
                        html += "<td>" + (obj[i].Division || "") + "</td>";
                        html += "<td>" + (obj[i].LineName || "") + "</td>";
                        html += "<td>" + (obj[i].WorkDate || "") + "</td>";
                        html += "<td>" + (obj[i].Code || "") + "</td>";
                        html += "<td>" + (obj[i].EmpName || "") + "</td>";
                        html += "<td>" + (obj[i].OrderNo || "") + "</td>";
                        html += "<td>" + (obj[i].OpNo || "") + "</td>";
                        html += "<td>" + (obj[i].Descriptions || "") + "</td>";
                        html += "<td>" + (obj[i].StdRate || 0) + "</td>";
                        html += "<td>" + (obj[i].StdMin || 0) + "</td>";
                        html += "<td>" + qty + "</td>";
                        html += "<td>" + prodMin.toFixed(2) + "</td>";
                        html += "<td>" + amount.toFixed(2) + "</td>";
                        html += "<td>" + Number(obj[i].Efficiency || 0).toFixed(2) + " %</td>";
                        html += "<td>" + (obj[i].FirstBundleScanTime || "") + "</td>";
                        html += "<td>" + (obj[i].LastBundleScanTime || "") + "</td>";
                        html += "<td>" + manualQty + "</td>";
                        html += "<td>" + qrScanQty + "</td>";
                        html += "</tr>";
                    }


                    $("#tbodyEmployeeWise").append(html);
                    var loadedRows = $("#tbodyEmployeeWise tr.employee-efficiency-row").length;
                    if (efficiencyTotalRows > 0) {
                        $("#spTotalRowCount").html("Loaded Rows: <b>" + loadedRows + "</b> / <b>" + efficiencyTotalRows + "</b>");

                    }
                    else {
                        $("#spTotalRowCount").html("Loaded Rows: <b>" + loadedRows + "</b>");
                    }

                    if (efficiencyTotalRows > 0) {

                        if (loadedRows >= efficiencyTotalRows) {
                            efficiencyHasMoreData = false;
                        }
                        else {
                            efficiencyHasMoreData = true;
                        }
                    }
                    else {

                        if (currentPageRows < efficiencyPageSize) {
                            efficiencyHasMoreData = false;
                        }
                        else {
                            efficiencyHasMoreData = true;
                        }
                    }


                    $("#tbodyEmployeeWise .code-total-row").remove();
                    Fn_AddCodeWiseTotalRows();
                    $("#trGrandTotal").remove();
                    var grandEfficiency = 0;
                    if (grandTotalProdMin > 0) {
                        grandEfficiency = (grandTotalProdMin / 540);
                    }

                    var totalHtml = "";
                    totalHtml += "<tr id='trGrandTotal' style='background-color:#d4edda;font-weight:700;color:black;'>";
                    totalHtml += "<td>Grand Total</td>";
                    totalHtml += "<td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td>";
                    totalHtml += "<td>" + grandTotalQty + "</td>";
                    totalHtml += "<td>" + grandTotalProdMin.toFixed(2) + "</td>";
                    totalHtml += "<td>" + grandTotalAmount.toFixed(2) + "</td>";
                    totalHtml += "<td>" + grandEfficiency.toFixed(2) + " %</td>";
                    totalHtml += "<td></td><td></td>";
                    totalHtml += "<td>" + grandTotalManualQty + "</td>";
                    totalHtml += "<td>" + grandTotalQrScanQty + "</td>";
                    totalHtml += "</tr>";

                    $("#tbodyEmployeeWise").append(totalHtml);
                    if (loadedRows > 0) {
                        $("#btnExcel").show();
                    }

                    if (efficiencyHasMoreData) {
                        efficiencyPageNumber++;
                        $("#tbodyEmployeeWise").append("<tr id='dvEfficiencyLoading'><td colspan='18' class='text-center' style='font-weight:bold;'>Loading more records...</td></tr>");
                    }
                },
                complete: function () {
                    efficiencyIsLoading = false;
                    $("#dvEfficiencyLoading").remove();
                    if (!isScroll) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    }
                },
                error: function (err) {
                    efficiencyIsLoading = false;
                    $("#dvEfficiencyLoading").remove();
                    Swal.fire({ title: "", text: "Error while loading data.", icon: "error" });
                }

            });
        }


        function Fn_AddCodeWiseTotalRows() {
            $("#tbodyEmployeeWise .code-total-row").remove();
            var codeTotals = {};

            $("#tbodyEmployeeWise tr.employee-efficiency-row").each(function () {

                var tds = $(this).find("td");
                var code = $.trim(tds.eq(3).text());
                var empName = $.trim(tds.eq(4).text());
                if (code == "") {
                    return;
                }
                var qty = Number(tds.eq(10).text()) || 0;
                var prodMin = Number(tds.eq(11).text()) || 0;
                var amount = Number(tds.eq(12).text()) || 0;
                var manualQty = Number(tds.eq(16).text()) || 0;
                var qrScanQty = Number(tds.eq(17).text()) || 0;
                if (!codeTotals[code]) {
                    codeTotals[code] = {
                        EmpName: empName,
                        Qty: 0,
                        ProductionMinute: 0,
                        Amount: 0,
                        ManualQty: 0,
                        QrScanQty: 0
                    };
                }

                codeTotals[code].Qty += qty;
                codeTotals[code].ProductionMinute += prodMin;
                codeTotals[code].Amount += amount;
                codeTotals[code].ManualQty += manualQty;
                codeTotals[code].QrScanQty += qrScanQty;
            });


            $.each(codeTotals, function (code, total) {
                var lastRow = null;
                $("#tbodyEmployeeWise tr.employee-efficiency-row").each(function () {
                        var rowCode = $.trim($(this).find("td").eq(3).text());
                        if (rowCode == code) {
                            lastRow = $(this);
                        }
                    });


                if (!lastRow) {
                    return;
                }

                var efficiency = 0;
                if (total.ProductionMinute > 0) {

                    efficiency = (total.ProductionMinute / 540);
                }
                var totalRow = "";
                totalRow += "<tr class='code-total-row' style='background:#fff3cd; font-weight:600;color:black;'>";
                totalRow += "<td>Total</td><td></td><td></td>";
                totalRow += "<td></td>";
                totalRow += "<td></td>";
                totalRow += "<td></td><td></td><td></td><td></td><td></td>";
                totalRow += "<td>" + total.Qty + "</td>";
                totalRow += "<td>" + total.ProductionMinute.toFixed(2) + "</td>";
                totalRow += "<td>" + total.Amount.toFixed(2) + "</td>";
                totalRow += "<td>" + efficiency.toFixed(2) + " %</td>";
                totalRow += "<td></td><td></td>";
                totalRow += "<td>" + total.ManualQty + "</td>";
                totalRow += "<td>" + total.QrScanQty + "</td>";
                totalRow += "</tr>";
                lastRow.after(totalRow);

            });
        }

        $(window).scroll(function () {

            if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
                Fn_Get_EmployeeWiseEfficiency(true);
            }
        });


    </script>

    <style>
        .table1-wrapper1 {
            max-height: 400px;
            overflow-y: auto;
        }

            .table1-wrapper1 thead th {
                position: sticky;
                top: 0;
                background-color: #E1C16E;
                background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
                color: white;
                z-index: 2;
            }
    </style>

}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-12">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b>Reports</b></a></span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Efficiency Reports</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>

                <span class="pull-right" id="spTotalRowCount" style="color: black; font-weight: 800;"></span>
            </div>

        </div>

        <div class="row" style="margin-top: 1%;" id="dvMain">
            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">From-Date</label>
                                    <input type="text" id="txtFromDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">To-Date</label>
                                    <input type="text" id="txtToDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">Line</label>
                                    <select id="ddlLineName" class="form-control">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">OrderNo</label>
                                    <select id="ddlOrderNo" class="form-control">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">Operator</label>
                                    <select id="ddlAppEmp" class="form-control">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-inline">
                                    <div class="form-group">
                                        <button class="btn btn-success" style="margin-top: 20px;" onclick="Fn_Get_EmployeeWiseEfficiency();">Search</button>
                                        <button id="btnExcel" style="display: none; margin-top: 20px;" title="Download Excel" class="btn btn-success"><i class="fa fa-download" onclick="fnExcelReport()"></i></button>

                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="table-responsive table1-wrapper1" id="dvEmployeeWise">
                                <table class="table table-striped table-hover table-responsive text-nowrap" id="tblEmployeeWise">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                            <th>Division</th>
                                            <th>Line Name</th>
                                            <th>WorkDate</th>
                                            <th>Code</th>
                                            <th>EmpName</th>
                                            <th>OrderNo</th>
                                            <th>OpNo</th>
                                            <th>Descriptions</th>
                                            <th>StdRate</th>
                                            <th>StdMin</th>
                                            <th>Qty</th>
                                            <th>ProdMin</th>
                                            <th>Amount</th>
                                            <th>Eff%</th>
                                            <th>StartScanTime</th>
                                            <th>LastScanTime</th>
                                            <th>ManualQty</th>
                                            <th>QrScannQty</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyEmployeeWise"></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>

    </section>
</section>
<script src="~/web/js/select2.min.js"></script>
<script>

    $(function () {
        $("#ddlLineName").select2();
        $("#ddlOrderNo").select2();
        $("#ddlAppEmp").select2();
    });

</script>
