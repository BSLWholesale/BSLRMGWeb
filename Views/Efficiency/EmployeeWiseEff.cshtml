
@{
    ViewBag.Title = "EmployeeWiseEff";
}

@{


    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>
    <link href="~/web/css/select2.min.css" rel="stylesheet" />

    <!-- start for Excel js file-->
    <script src="~/web/js/xlsx.full.min.js"></script>
    <script src="~/web/js/xlsx.bundle.js"></script>
    <!-- End for Excel js file-->

    <script type="text/javascript">

        $(document).ready(function () {

            Fn_Fill_DropdownList("ddlOrderNo", "vPieceRateReport", "OrderNo", "", "");

            var strFieldName = " CONCAT(EmpName, ' (', Code, ')') AS EmpName ";
            Fn_Fill_DropdownList("ddlAppEmp", "vPieceRateReport", strFieldName, "Code", "");
            Fn_Fill_DropdownList("ddlLineName", "vPieceRateReport", "LineName", "", "");

            $("#txtFromDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());
            $("#txtToDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());

        });

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }


        function fnExcelReport() {

            var table = document.getElementById('tblEmployeeWise');

            var strFileName = "EmployeeWise_Efficiency_Report";
            var strHeader = "EmployeeWise Efficiency Report";
            var StartDate = $('#txtFromDate').val();
            var EndDate = $('#txtToDate').val();

            var tableSheet = XLSX.utils.table_to_sheet(table, {
                raw: true
            });

            var tableData = XLSX.utils.sheet_to_json(tableSheet, {
                header: 1,
                defval: ""
            });

            var excelData = [
                [strHeader],
                ["From Date", StartDate],
                ["To Date", EndDate],
                ...tableData
            ];

            var worksheet = XLSX.utils.aoa_to_sheet(excelData);
            worksheet["!merges"] = [
                {
                    s: { r: 0, c: 0 },
                    e: { r: 0, c: 17 }
                }
            ];

            worksheet["!cols"] = [
                { wch: 18 },
                { wch: 18 }
            ];

            worksheet["A1"].s = {
                font: {
                    bold: true,
                    sz: 14,
                    color: { rgb: "000000" }
                },
                alignment: {
                    horizontal: "left",
                    vertical: "center"
                }
            };

            ["A2", "B2", "A3", "B3"].forEach(function (cell) {

                if (worksheet[cell]) {
                    worksheet[cell].s = {
                        font: {
                            bold: true,
                            color: { rgb: "000000" }
                        },
                        alignment: {
                            horizontal: "left",
                            vertical: "center"
                        }
                    };
                }
            });

            for (var r = 0; r < table.rows.length; r++) {

                for (var c = 0; c < table.rows[r].cells.length; c++) {

                    var htmlCell = table.rows[r].cells[c];

                    if (htmlCell.tagName.toLowerCase() === "th") {

                        var cellAddress = XLSX.utils.encode_cell({
                            r: r + 3,
                            c: c
                        });

                        // Create cell even if TH is blank
                        if (!worksheet[cellAddress]) {
                            worksheet[cellAddress] = {
                                t: "s",
                                v: htmlCell.innerText.trim()
                            };
                        }

                        // Apply background, font, alignment and borders
                        worksheet[cellAddress].s = {

                            fill: {
                                patternType: "solid",
                                fgColor: { rgb: "06BBCC" }
                            },

                            font: {
                                bold: true,
                                color: { rgb: "FFFFFF" }
                            },

                            alignment: {
                                horizontal: "center",
                                vertical: "center"
                            },

                            border: {
                                top: {
                                    style: "thin",
                                    color: { rgb: "000000" }
                                },
                                bottom: {
                                    style: "thin",
                                    color: { rgb: "000000" }
                                },
                                left: {
                                    style: "thin",
                                    color: { rgb: "000000" }
                                },
                                right: {
                                    style: "thin",
                                    color: { rgb: "000000" }
                                }
                            }
                        };
                    }
                }
            }

            var workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(
                workbook,
                worksheet,
                "Employee Report"
            );

            XLSX.writeFile(workbook, strFileName + ".xlsx");
        }


        var efficiencyIsLoading = false;
        var efficiencyHasMoreData = true;
        var efficiencyPageNumber = 1;
        var efficiencyPageSize = 1000;
        var efficiencyTotalRows = 0;
        var allEmployeeEfficiencyRows = [];

        function Fn_Get_EmployeeWiseEfficiency(isScroll) {

            isScroll = isScroll || false;

            if (efficiencyIsLoading) return;
            if (isScroll && !efficiencyHasMoreData) return;

            if (!isScroll) {
                efficiencyPageNumber = 1;
                efficiencyHasMoreData = true;
                efficiencyTotalRows = 0;
                allEmployeeEfficiencyRows = [];

                $("#tbodyEmployeeWise").empty();
                $("#spTotalRowCount").text("");
            }

            efficiencyIsLoading = true;

            if (isScroll) {
                $("#tbodyEmployeeWise").find(".loading-row").remove();
                $("#tbodyEmployeeWise").append(
                    "<tr class='loading-row'><td colspan='18' style='text-align:center;'>Loading...</td></tr>"
                );
            } else {
                $("#loader").show();
            }

            var clsEfficiencyReq = {};

            if ($("#txtFromDate").val() != "")
                clsEfficiencyReq.StartDate = $("#txtFromDate").val();

            if ($("#txtToDate").val() != "")
                clsEfficiencyReq.EndDate = $("#txtToDate").val();

            if ($("#ddlLineName").val() != "0")
                clsEfficiencyReq.LineName = $("#ddlLineName").val();

            if ($("#ddlOrderNo").val() != "0")
                clsEfficiencyReq.OrderNo = $("#ddlOrderNo").val();

            if ($("#ddlAppEmp").val() != "0")
                clsEfficiencyReq.Code = $("#ddlAppEmp").val();

            clsEfficiencyReq.QueryType = "Select_EmployeeWise";
            clsEfficiencyReq.PageNumber = efficiencyPageNumber;
            clsEfficiencyReq.PageSize = efficiencyPageSize;

            const selectedRadio = document.querySelector('input[name="rbOrderBy"]:checked')?.value;

            $.ajax({
                url: "/Efficiency/Fn_Get_EmployeeWiseEfficiency",
                type: "POST",
                data: JSON.stringify(clsEfficiencyReq),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    $("#tbodyEmployeeWise").find(".loading-row").remove();

                    var obj = [];

                    if (data && data.message) {
                        obj = typeof data.message === "string"
                            ? JSON.parse(data.message)
                            : data.message;
                    } else if (Array.isArray(data)) {
                        obj = data;
                    }

                    if (!Array.isArray(obj)) obj = [];

                    if (obj.length > 0 && obj[0].vErrorMsg === "Success") {

                        efficiencyTotalRows =
                            parseInt(obj[0].TotalRows, 10) || efficiencyTotalRows;

                        obj.forEach(function (row) {
                            if (row.vErrorMsg === "Success" || !row.vErrorMsg) {
                                allEmployeeEfficiencyRows.push(row);
                            }
                        });

                        $("#btnExcel").show();

                        var html = "";

                        var grand = {
                            Qty: 0,
                            ProductionMinute: 0,
                            Amount: 0,
                            ManualQty: 0,
                            QrScanQty: 0
                        };

                        function esc(value) {
                            if (value === null || value === undefined) return "";

                            return String(value)
                                .replace(/&/g, "&amp;")
                                .replace(/</g, "&lt;")
                                .replace(/>/g, "&gt;")
                                .replace(/"/g, "&quot;")
                                .replace(/'/g, "&#39;");
                        }

                        function num(value) {
                            var n = parseFloat(value);
                            return isNaN(n) ? 0 : n;
                        }

                        function formatNum(value) {
                            return Number(value.toFixed(2)).toString();
                        }

                        function dateValue(value) {
                            if (!value) return 0;

                            var match = String(value).trim().match(
                                /^(\d{1,2})[-\s]([A-Za-z]{3})[-\s](\d{4})$/
                            );

                            if (match) {
                                var months = {
                                    jan: 0, feb: 1, mar: 2, apr: 3,
                                    may: 4, jun: 5, jul: 6, aug: 7,
                                    sep: 8, oct: 9, nov: 10, dec: 11
                                };

                                var month = months[match[2].toLowerCase()];

                                if (month !== undefined) {
                                    return new Date(
                                        parseInt(match[3], 10),
                                        month,
                                        parseInt(match[1], 10)
                                    ).getTime();
                                }
                            }

                            var parsed = Date.parse(value);
                            return isNaN(parsed) ? 0 : parsed;
                        }

                        var uniqueDates = new Set();
                        var uniqueCode = new Set();

                        allEmployeeEfficiencyRows.forEach(function (row) {
                            if (row.WorkDate) {
                                uniqueDates.add(String(row.WorkDate).trim());
                            }
                            if (row.Code) {
                                uniqueCode.add(String(row.Code).trim());
                            }
                        });

                        var numberOfDays = uniqueDates.size;
                        var numberOfManPower = uniqueCode.size;
                        var codeGroups = {};

                        allEmployeeEfficiencyRows.forEach(function (row) {

                            var code = row.Code || "";
                            var date = row.WorkDate || "";

                            if (!codeGroups[code]) {
                                codeGroups[code] = {};
                            }

                            if (!codeGroups[code][date]) {
                                codeGroups[code][date] = [];
                            }

                            codeGroups[code][date].push(row);
                        });

                        var codes = Object.keys(codeGroups).sort(function (a, b) {
                            return String(a).localeCompare(
                                String(b),
                                undefined,
                                { numeric: true, sensitivity: "base" }
                            );
                        });

                        codes.forEach(function (code) {

                            var codeTotal = {
                                Qty: 0,
                                ProductionMinute: 0,
                                Amount: 0,
                                ManualQty: 0,
                                QrScanQty: 0
                            };

                            var dates = Object.keys(codeGroups[code]).sort(function (a, b) {
                                return dateValue(a) - dateValue(b);
                            });

                            dates.forEach(function (date) {

                                var dateTotal = {
                                    Qty: 0,
                                    ProductionMinute: 0,
                                    Amount: 0,
                                    ManualQty: 0,
                                    QrScanQty: 0
                                };

                                var operationRows = codeGroups[code][date];

                                operationRows.sort(function (a, b) {
                                    return String(a.OpNo || "").localeCompare(
                                        String(b.OpNo || ""),
                                        undefined,
                                        { numeric: true, sensitivity: "base" }
                                    );
                                });


                                operationRows.forEach(function (row) {

                                    var qty = num(row.Qty);
                                    var prodMin = num(row.ProductionMinute);
                                    var amount = num(row.Amount);
                                    var manualQty = num(row.ManualQty);
                                    var qrScanQty = num(row.QrScanQty);

                                    dateTotal.Qty += qty;
                                    dateTotal.ProductionMinute += prodMin;
                                    dateTotal.Amount += amount;
                                    dateTotal.ManualQty += manualQty;
                                    dateTotal.QrScanQty += qrScanQty;

                                    html += "<tr class='employee-efficiency-row'>";
                                    html += "<td>" + esc(row.Division) + "</td>";
                                    html += "<td>" + esc(row.LineName) + "</td>";
                                    html += "<td>" + esc(row.WorkDate) + "</td>";
                                    html += "<td>" + esc(row.Code) + "</td>";
                                    html += "<td>" + esc(row.EmpName) + "</td>";
                                    html += "<td>" + esc(row.OrderNo) + "</td>";
                                    html += "<td>" + esc(row.OpNo) + "</td>";
                                    html += "<td>" + esc(row.Descriptions) + "</td>";
                                    html += "<td>" + esc(row.StdRate) + "</td>";
                                    html += "<td>" + esc(row.StdMin) + "</td>";
                                    html += "<td>" + formatNum(qty) + "</td>";
                                    html += "<td>" + formatNum(prodMin) + "</td>";
                                    html += "<td>" + formatNum(amount) + "</td>";
                                    html += "<td>--</td>";
                                    html += "<td>" + esc(row.FirstBundleScanTime) + "</td>";
                                    html += "<td>" + esc(row.LastBundleScanTime) + "</td>";
                                    html += "<td>" + formatNum(manualQty) + "</td>";
                                    html += "<td>" + formatNum(qrScanQty) + "</td>";
                                    html += "</tr>";
                                });

                                var dateEfficiency = (dateTotal.ProductionMinute / 540) * 100;

                                html += "<tr class='date-total-row' style='font-weight:bold;background:#e8f3ff;'>";
                                html += "<th style='color:black;'>Datewise Total</th>";
                                html += "<th></th><th></th>";
                                html += "<th style='color:black;'>" + esc(code) + "</th>";
                                html += "<th></th><th></th><th></th><th></th><th></th><th></th>";
                                html += "<th style='color:black;'>" + formatNum(dateTotal.Qty) + "</th>";
                                html += "<th style='color:black;'>" + formatNum(dateTotal.ProductionMinute) + "</th>";
                                html += "<th style='color:black;'>" + formatNum(dateTotal.Amount) + "</th>";
                                html += "<th style='color:black;'>" + formatNum(dateEfficiency) + "%</th>";
                                html += "<th></th><th></th>";
                                html += "<th style='color:black;'>" + formatNum(dateTotal.ManualQty) + "</th>";
                                html += "<th style='color:black;'>" + formatNum(dateTotal.QrScanQty) + "</th>";
                                html += "</tr>";

                                // Accumulate date totals into employee totals.
                                codeTotal.Qty += dateTotal.Qty;
                                codeTotal.ProductionMinute += dateTotal.ProductionMinute;
                                codeTotal.Amount += dateTotal.Amount;
                                codeTotal.ManualQty += dateTotal.ManualQty;
                                codeTotal.QrScanQty += dateTotal.QrScanQty;
                            });

                            // Employee/code-wise total row.
                            var days = 0;
                            days = numberOfDays;
                            var codeEfficiency = (codeTotal.ProductionMinute / (days * 540)) * 100;

                            html += "<tr class='code-total-row' style='font-weight:bold;background:#d5e8d4;'>";
                            html += "<th style='color:black;'>Total</th>";
                            html += "<th></th><th></th><th></th><th></th><th></th><th></th><th></th><th></th><th></th>";
                            html += "<th style='color:black;'>" + formatNum(codeTotal.Qty) + "</th>";
                            html += "<th style='color:black;'>" + formatNum(codeTotal.ProductionMinute) + "</th>";
                            html += "<th style='color:black;'>" + formatNum(codeTotal.Amount) + "</th>";
                            html += "<th style='color:black;'>" + formatNum(codeEfficiency) + "%</th>";
                            html += "<th></th><th></th>";
                            html += "<th style='color:black;'>" + formatNum(codeTotal.ManualQty) + "</th>";
                            html += "<th style='color:black;'>" + formatNum(codeTotal.QrScanQty) + "</th>";
                            html += "</tr>";

                            // Accumulate employee totals into grand totals.
                            grand.Qty += codeTotal.Qty;
                            grand.ProductionMinute += codeTotal.ProductionMinute;
                            grand.Amount += codeTotal.Amount;
                            grand.ManualQty += codeTotal.ManualQty;
                            grand.QrScanQty += codeTotal.QrScanQty;
                        });

                        var grandEfficiency = 0;
                        if (selectedRadio == "Linewise") {
                            alert(numberOfManPower);
                            grandEfficiency = numberOfManPower > 0
                                ? (grand.ProductionMinute / (numberOfManPower * 540)) * 100
                                : 0;
                        }
                        else if (selectedRadio == "Operatorwise") {
                            alert(numberOfDays);
                            grandEfficiency = numberOfDays > 0
                                ? (grand.ProductionMinute / (numberOfDays * 540)) * 100
                                : 0;
                        }
                        else {

                        }

                        // Grand total row.
                        html += "<tr class='grand-total-row' style='font-weight:bold;background:#f5d6a7;'>";
                        html += "<th style='color:black;'>Grand Total</th>";
                        html += "<th></th><th></th><th></th><th></th><th></th><th></th><th></th><th></th><th></th>";
                        html += "<th style='color:black;'>" + formatNum(grand.Qty) + "</th>";
                        html += "<th style='color:black;'>" + formatNum(grand.ProductionMinute) + "</th>";
                        html += "<th style='color:black;'>" + formatNum(grand.Amount) + "</th>";
                        html += "<th style='color:black;'>" + formatNum(grandEfficiency) + "%</th>";
                        html += "<th></th><th></th>";
                        html += "<th style='color:black;'>" + formatNum(grand.ManualQty) + "</th>";
                        html += "<th style='color:black;'>" + formatNum(grand.QrScanQty) + "</th>";
                        html += "</tr>";

                        $("#tbodyEmployeeWise").html(html);

                        $("#spTotalRowCount").text(
                            "Total Records: " + allEmployeeEfficiencyRows.length +
                            (efficiencyTotalRows ? " / " + efficiencyTotalRows : "")
                        );

                        if (efficiencyTotalRows > 0) {
                            efficiencyHasMoreData =
                                allEmployeeEfficiencyRows.length < efficiencyTotalRows;
                        } else {
                            efficiencyHasMoreData = obj.length >= efficiencyPageSize;
                        }

                        efficiencyPageNumber++;

                    } else if (efficiencyPageNumber === 1) {

                        $("#tbodyEmployeeWise").html("<tr><td colspan='18' style='text-align:center;'>No records found</td></tr>");

                        $("#spTotalRowCount").text("Total Records: 0");
                        efficiencyHasMoreData = false;
                        $("#btnExcel").hide();
                    }
                },
                error: function (xhr, status, error) {
                    $("#tbodyEmployeeWise").find(".loading-row").remove();
                    alert("Unable to load employee efficiency data.");
                },
                complete: function () {
                    efficiencyIsLoading = false;
                    $("#loader").hide();
                    $("#tbodyEmployeeWise").find(".loading-row").remove();
                }
            });
        }



        $(window).scroll(function () {

            if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
                Fn_Get_EmployeeWiseEfficiency(true);
            }
        });
               

    </script>

    <style>
        .table1-wrapper1 {
            max-height: 700px;
            overflow-y: auto;
        }

            .table1-wrapper1 thead th {
                position: sticky;
                top: 0;
                background-color: #E1C16E;
                background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
                color: white;
                z-index: 2;
            }
    </style>

}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-12">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b>Reports</b></a></span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Invidual Employee Details Efficiency Reports</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>

                <span class="pull-right" id="spTotalRowCount" style="color: black; font-weight: 800;"></span>
            </div>

        </div>

        <div class="row" style="margin-top: 1%;" id="dvMain">
            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">From-Date</label>
                                    <input type="text" id="txtFromDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">To-Date</label>
                                    <input type="text" id="txtToDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">Line</label>
                                    <select id="ddlLineName" class="form-control">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">OrderNo</label>
                                    <select id="ddlOrderNo" class="form-control">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">Operator</label>
                                    <select id="ddlAppEmp" class="form-control">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-inline" style="margin-top: 25px;">
                                    <input type="radio" name="rbOrderBy" value="Linewise" /> Linewise &nbsp;&nbsp;
                                    <input type="radio" name="rbOrderBy" value="Operatorwise" /> Operatorwise
                                </div>
                            </div>

                            <div class="col-sm-2">
                                <div class="form-inline">
                                    <div class="form-group">
                                        <button class="btn btn-success" style="margin-top: 20px;" onclick="Fn_Get_EmployeeWiseEfficiency();">Search</button>
                                        <button id="btnExcel" style="display: none; margin-top: 20px;" title="Download Excel" class="btn btn-success"><i class="fa fa-download" onclick="fnExcelReport()"></i></button>

                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="table-responsive table1-wrapper1" id="dvEmployeeWise">
                                <table class="table table-striped table-hover table-responsive text-nowrap" id="tblEmployeeWise">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                            <th>Division</th>
                                            <th>Line Name</th>
                                            <th>WorkDate</th>
                                            <th>Code</th>
                                            <th>EmpName</th>
                                            <th>OrderNo</th>
                                            <th>OpNo</th>
                                            <th>Descriptions</th>
                                            <th>StdRate</th>
                                            <th>StdMin</th>
                                            <th>Qty</th>
                                            <th>ProdMin</th>
                                            <th>Amount</th>
                                            <th>Eff%</th>
                                            <th>StartScanTime</th>
                                            <th>LastScanTime</th>
                                            <th>ManualQty</th>
                                            <th>QrScannQty</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyEmployeeWise"></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>

    </section>
</section>
<script src="~/web/js/select2.min.js"></script>
<script>

    $(function () {
        $("#ddlLineName").select2();
        $("#ddlOrderNo").select2();
        $("#ddlAppEmp").select2();
    });

</script>
