
@{
    ViewBag.Title = "EmployeeMonthlyEff";
}

@{

    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>
    <link href="~/web/css/select2.min.css" rel="stylesheet" />

    <!-- start for Excel js file-->
    <script src="~/web/js/xlsx.full.min.js"></script>
    <script src="~/web/js/xlsx.bundle.js"></script>
    <!-- End for Excel js file-->

    <script type="text/javascript">

        $(document).ready(function () {


            var strFieldName = " CONCAT(EmpName, ' (', Code, ')') AS EmpName ";
            Fn_Fill_DropdownList("ddlAppEmp", "vPieceRateReport", strFieldName, "Code", "");
            Fn_Fill_DropdownList("ddlLineName", "vPieceRateReport", "LineName", "", "");

            $("#txtFromDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());
            $("#txtToDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());


        });


        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }


        var efficiencyIsLoading = false;
        var efficiencyHasMoreData = true;
        var efficiencyPageNumber = 1;
        var efficiencyPageSize = 1000;
        var efficiencyTotalRows = 0;
        var efficiencyLoadedRows = 0;


        var efficiencyAllRecords = [];

        function Fn_Get_Linewise_Employee_MonthlyEff(isScroll) {

            isScroll = isScroll || false;

            // Prevent duplicate requests
            if (efficiencyIsLoading ||
                (isScroll && !efficiencyHasMoreData)) {
                return;
            }

            // Reset for a fresh search
            if (!isScroll) {

                efficiencyPageNumber = 1;
                efficiencyHasMoreData = true;
                efficiencyTotalRows = 0;
                efficiencyLoadedRows = 0;
                efficiencyAllRecords = [];

                $("#tbodyEmployeeWise").empty();
                $("#theadEmployeeWise").empty();

                $("#spTotalRowCount").text("Records Loaded: 0 / 0");
            }

            efficiencyIsLoading = true;
            $("#loader").show();

            var req = {
                QueryType: "Select_Linewise_Employee_MonthlyEff",
                PageNumber: efficiencyPageNumber,
                PageSize: efficiencyPageSize
            };


            if ($("#txtFromDate").val() !== "") {
                req.StartDate = $("#txtFromDate").val();
            }
            if ($("#txtToDate").val() !== "") {
                req.EndDate = $("#txtToDate").val();
            }
            if ($("#ddlLineName").val() !== "0") {
                req.LineName = $("#ddlLineName").val();
            }
            if ($("#ddlAppEmp").val() !== "0") {
                req.Code = $("#ddlAppEmp").val();
            }

            $.ajax({
                url: "/Efficiency/Fn_Get_Linewise_Employee_MonthlyEff",
                type: "POST",
                data: JSON.stringify(req),
                contentType: "application/json; charset=utf-8",
                dataType: "json",

                success: function (data) {

                    var obj = data.message;

                    // Parse API response
                    if (typeof obj === "string") {
                        try {
                            obj = JSON.parse(obj);
                        } catch (e) {
                            Swal.fire({ title: "", text: "Invalid API response:", e, icon: "error" });
                            efficiencyHasMoreData = false;
                            return;
                        }
                    }

                    // Handle empty response
                    if (!Array.isArray(obj) || obj.length === 0) {

                        efficiencyHasMoreData = false;

                        if (!isScroll &&
                            efficiencyAllRecords.length === 0) {
                            $("#theadEmployeeWise").empty();
                            $("#tbodyEmployeeWise").html("<tr><td colspan='100%' class='text-center'>No records found</td></tr>");
                        }

                        return;
                    }

                    // Remove status-only records
                    var records = obj.filter(function (item) {
                        return !item.vErrorMsg ||
                            item.vErrorMsg === "Success";
                    });

                    // Handle response containing no actual records
                    if (records.length === 0) {

                        efficiencyHasMoreData = false;

                        if (!isScroll &&
                            efficiencyAllRecords.length === 0) {
                            $("#theadEmployeeWise").empty();
                            $("#tbodyEmployeeWise").html("<tr><td colspan='100%' class='text-center'>No records found</td></tr>");
                        }

                        return;
                    }


                    efficiencyTotalRows = parseInt(records[0].TotalRows, 10) || efficiencyTotalRows;
                    efficiencyAllRecords = efficiencyAllRecords.concat(records);
                    efficiencyLoadedRows += records.length;
                    efficiencyPageNumber++;

                    if (records.length < efficiencyPageSize || (efficiencyTotalRows > 0 && efficiencyLoadedRows >= efficiencyTotalRows)) {
                        efficiencyHasMoreData = false;
                    }


                    var allRecords = efficiencyAllRecords;
                    function employeeCode(code) {
                        return String(code == null ? "" : code).trim();
                    }

                    var employees = {};
                    $.each(allRecords, function (i, item) {

                        var code = employeeCode(item.Code);

                        if (code === "") {
                            return true;
                        }

                        if (!employees[code]) {
                            employees[code] = {
                                Code: code,
                                EmpName: item.EmpName || code
                            };
                        }
                    });


                    var employeeCodes = Object.keys(employees);
                    var $header = $("<tr></tr>").css({ backgroundImage: "linear-gradient(to bottom, #722F37, #DB5A6A)", color: "white" });
                    $header.append($("<th></th>").text("Line"));
                    $header.append($("<th></th>").text("Date"));

                    $.each(employeeCodes, function (i, code) {

                        var emp = employees[code];

                        var $th = $("<th></th>").addClass("text-center employee-column").attr("data-employee", code);
                        $th.append($("<div></div>").text(emp.EmpName), $("<small></small>").text('(' + code + ')'));
                        $header.append($th);
                    });

                    $("#theadEmployeeWise").empty().append($header);
                    var groupedRows = {};
                    var rowOrder = [];

                    $.each(allRecords, function (i, item) {

                        var line = item.LineName || "";
                        var date = item.WorkDate || "";
                        var code = employeeCode(item.Code);

                        var rowKey = JSON.stringify([line, date]);

                        if (!groupedRows[rowKey]) {

                            groupedRows[rowKey] = {
                                LineName: line,
                                WorkDate: date,
                                Employees: {}
                            };

                            rowOrder.push(rowKey);
                        }

                        var efficiency = parseFloat(item.Efficiency);
                        if (code !== "") {
                            groupedRows[rowKey].Employees[code] = isNaN(efficiency) ? "" : efficiency.toFixed(2) + "%";
                        }
                    });

                    var $tbody = $("#tbodyEmployeeWise").empty();
                    $.each(rowOrder, function (i, rowKey) {

                        var row = groupedRows[rowKey];
                        var $tr = $("<tr></tr>");
                        $tr.append($("<td></td>").text(row.LineName));
                        $tr.append($("<td></td>").text(row.WorkDate));
                        $.each(employeeCodes, function (j, code) {
                            var value = row.Employees[code] || "";
                            $tr.append($("<td></td>").addClass("text-center").attr("data-employee", code).text(value));
                        });

                        $tbody.append($tr);
                    });

                    $("#spTotalRowCount").text("Records Loaded: " + efficiencyLoadedRows + " / " + efficiencyTotalRows);
                    $("#btnExcel").show();
                },
                error: function (xhr, status, error) {
                    Swal.fire({ title: "", text: "Unable to load employee efficiency data. " + error, icon: "error" });
                },
                complete: function () {
                    efficiencyIsLoading = false;
                    $("#loader").hide();
                }
            });
        }

        $(window).off("scroll.employeeEfficiency").on("scroll.employeeEfficiency", function () {
            if ($(window).scrollTop() + $(window).height() >=
                $(document).height() - 150) {

                Fn_Get_Linewise_Employee_MonthlyEff(true);
            }
        });



        function fnExcelReport() {

            var table = document.getElementById('tblEmployeeWise');

            var strFileName = "Employee_Monthly_Efficiency_Summary";
            var strHeader = "Linewise Employee Monthly Efficiency Summary";
            var StartDate = $('#txtFromDate').val();
            var EndDate = $('#txtToDate').val();

            var tableSheet = XLSX.utils.table_to_sheet(table, {
                raw: true
            });

            var tableData = XLSX.utils.sheet_to_json(tableSheet, {
                header: 1,
                defval: ""
            });

            var excelData = [
                [strHeader],
                ["From Date", StartDate],
                ["To Date", EndDate],
                ...tableData
            ];

            var worksheet = XLSX.utils.aoa_to_sheet(excelData);
            worksheet["!merges"] = [
                {
                    s: { r: 0, c: 0 },
                    e: { r: 0, c: 17 }
                }
            ];

            worksheet["!cols"] = [
                { wch: 18 },
                { wch: 18 }
            ];

            worksheet["A1"].s = {
                font: {
                    bold: true,
                    sz: 14,
                    color: { rgb: "000000" }
                },
                alignment: {
                    horizontal: "left",
                    vertical: "center"
                }
            };

            ["A2", "B2", "A3", "B3"].forEach(function (cell) {

                if (worksheet[cell]) {
                    worksheet[cell].s = {
                        font: {
                            bold: true,
                            color: { rgb: "000000" }
                        },
                        alignment: {
                            horizontal: "left",
                            vertical: "center"
                        }
                    };
                }
            });

            for (var r = 0; r < table.rows.length; r++) {

                for (var c = 0; c < table.rows[r].cells.length; c++) {

                    var htmlCell = table.rows[r].cells[c];

                    if (htmlCell.tagName.toLowerCase() === "th") {

                        var cellAddress = XLSX.utils.encode_cell({
                            r: r + 3,
                            c: c
                        });

                        // Create cell even if TH is blank
                        if (!worksheet[cellAddress]) {
                            worksheet[cellAddress] = {
                                t: "s",
                                v: htmlCell.innerText.trim()
                            };
                        }

                        // Apply background, font, alignment and borders
                        worksheet[cellAddress].s = {

                            fill: {
                                patternType: "solid",
                                fgColor: { rgb: "06BBCC" }
                            },

                            font: {
                                bold: true,
                                color: { rgb: "FFFFFF" }
                            },

                            alignment: {
                                horizontal: "center",
                                vertical: "center"
                            },

                            border: {
                                top: {
                                    style: "thin",
                                    color: { rgb: "000000" }
                                },
                                bottom: {
                                    style: "thin",
                                    color: { rgb: "000000" }
                                },
                                left: {
                                    style: "thin",
                                    color: { rgb: "000000" }
                                },
                                right: {
                                    style: "thin",
                                    color: { rgb: "000000" }
                                }
                            }
                        };
                    }
                }
            }

            var workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(
                workbook,
                worksheet,
                "Employee Report"
            );

            XLSX.writeFile(workbook, strFileName + ".xlsx");
        }

    </script>

    <style>
        .table1-wrapper1 {
            max-height: 400px;
            overflow-y: auto;
        }

            .table1-wrapper1 thead th {
                position: sticky;
                top: 0;
                background-color: #E1C16E;
                background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
                color: white;
                z-index: 2;
            }
    </style>

}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-12">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b>Reports</b></a></span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Linewise Employee Monthly Efficiency Summary</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>

                <span class="pull-right" id="spTotalRowCount" style="color: black; font-weight: 800;"></span>
            </div>

        </div>

        <div class="row" style="margin-top: 1%;" id="dvMain">
            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="form-label">From-Date</label>
                                    <input type="text" id="txtFromDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="form-label">To-Date</label>
                                    <input type="text" id="txtToDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">Line</label>
                                    <select id="ddlLineName" class="form-control">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">Operator</label>
                                    <select id="ddlAppEmp" class="form-control">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-inline">
                                    <div class="form-group">
                                        <button class="btn btn-success" style="margin-top: 20px;" onclick="Fn_Get_Linewise_Employee_MonthlyEff();">Search</button>
                                        <button id="btnExcel" style="display: none; margin-top: 20px;" title="Download Excel" class="btn btn-success"><i class="fa fa-download" onclick="fnExcelReport()"></i></button>

                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover" id="tblEmployeeWise">
                                    <thead id="theadEmployeeWise">
                                    </thead>

                                    <tbody id="tbodyEmployeeWise">
                                    </tbody>

                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>

    </section>
</section>
<script src="~/web/js/select2.min.js"></script>
<script>

    $(function () {
        $("#ddlLineName").select2();
        $("#ddlAppEmp").select2();
    });

</script>


