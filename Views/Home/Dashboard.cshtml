<script type="text/javascript">

    $(document).ready(function () {
        var EmpRole = sessionStorage.getItem("EmpRole");

        if (EmpRole == "Admin") {
            $("#WorkerattendenceCount").show();
            $("#ProductionCount").show();
            $("#BreakdownCount").show();
        }
        else {
            $("#WorkerattendenceCount").hide();
            $("#ProductionCount").hide();
            $("#BreakdownCount").hide();
        }

        Fn_Get_DashboardAttendenceEmpOperatorCount();
        Fn_AutoComplete_Textbox("txtOrderNo", "BundleCompile", "OrderNo");
        Fn_Employee_BirthdayWishes();
       
    });


    function Fn_Get_DashboardAttendenceEmpOperatorCount() {

        var clsDashboardEmployeeCount = {};

        var K1EmpOperatorCount = parseInt($("#K1EmpOperatorCount").text()) || 0;
        var K2EmpOperatorCount = parseInt($("#K2EmpOperatorCount").text()) || 0;
        var K3EmpOperatorCount = parseInt($("#K3EmpOperatorCount").text()) || 0;

        $.ajax({
            type: "POST",
            url: "/Home/Fn_Get_DashboardAttendenceEmpOperatorCount",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsDashboardEmployeeCount),
            success: function (data) {
                var obj = JSON.parse(data.message);
                for (var i = 0; i < obj.length; i++) {
                    var count = parseInt(obj[i].EmployeeCount) || 0;
                    if (obj[i].UnitName == "K1" || obj[i].UnitName == "k1") {
                        K1EmpOperatorCount += count;
                    }
                    if (obj[i].UnitName == "K2" || obj[i].UnitName == "k2") {
                        K2EmpOperatorCount += count;
                    }
                    if (obj[i].UnitName == "K3" || obj[i].UnitName == "k3") {
                        K3EmpOperatorCount += count;
                    }
                }
                $("#K1EmpOperatorCount").text(K1EmpOperatorCount);
                $("#K2EmpOperatorCount").text(K2EmpOperatorCount);
                $("#K3EmpOperatorCount").text(K3EmpOperatorCount);
            },
            error: function (err) {
                alert(err);
            }
        });
    }

    var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"];
    var orderQty = [120, 190, 300, 250, 220, 310];
    var bg = ["green", "blue", "orange", "brown", "red"];

    function Fn_Get_Order_Chart(orderNo) {

        var clsOrderMaster = {};
        if (orderNo != "") {
            clsOrderMaster.OrderNo = orderNo;
        }

        $.ajax({
            type: "POST",
            url: "/Order/Fn_Get_Order_Chart",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsOrderMaster),
            success: function (data) {
                var months = [];
                var orderQty = [];
                var obj = JSON.parse(data.message);
                $.each(obj, function (i, item) {
                    months.push(item.CreatedOn);
                    orderQty.push(item.Qty);
                });

                renderChart(months, orderQty);
            }
        });

    }

    let orderChart;
    function renderChart(months, orderQty) {
        var ctx = document.getElementById("orderChart");

        if (orderChart) {
            orderChart.destroy();
        }

        orderChart = new Chart(ctx, {
            type: "bar", // can use 'line' also
            data: {
                labels: months,
                datasets: [{
                    label: "Order Qty",
                    data: orderQty,
                    /* backgroundColor: "rgba(54, 162, 235, 0.6)"*/
                    backgroundColor: bg
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    }
    

    function Fn_AutoComplete_Textbox(txtName, strTBLName, strFieldName) {
        var clsRequestDropdown = {};
        clsRequestDropdown.vFieldName = strFieldName;
        clsRequestDropdown.vTBLName = strTBLName;

        $("#" + txtName).autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '/Production/Fn_AutoComplete_Textbox',
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term, strTBLName: strTBLName, strFieldName: strFieldName },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        response($.map(obj, function (item) {
                            return { label: item.SearchKeyword, value: item.SearchKeyword };
                        }));
                    }
                });
            },
            select: function (event, ui) {
                var str = ui.item.value;
                Fn_Get_Order_Chart(str);
            }
        });
    }


    function Fn_Employee_BirthdayWishes() {

        var clsEmployee = {};
        clsEmployee.nEmpId = sessionStorage.getItem("LogInID");
        clsEmployee.vEmpName = sessionStorage.getItem("UserName");

        $.ajax({
            type: "POST",
            url: "/Home/Fn_Employee_BirthdayWishes",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsEmployee),
            success: function (Result) {
                var obj = JSON.parse(Result.message)
                if (obj.vErrorMsg == "Success") {
                    $("#divEmpBirthdayWishes").show();
                    $("#EmpName").html(obj.vEmpName);
                    var bYear = (obj.DOB).substring(0, 4);
                    var d = new Date();
                    var currentYear = d.getFullYear();
                    var ageYear = currentYear - bYear + ' Year';

                    Swal.fire({
                        title: 'Birthday Wishes',
                        text: 'Happy Birthday' + ' ' + obj.vEmpName,
                        imageUrl: '/Images/birthday.jpg',
                        imageWidth: 400,
                        imageHeight: 200,
                        imageAlt: 'birthday image',
                    });
                }
            },
            error: function (err) {
                swal("", err, "error");
            }
        });
    }


</script>

