
@{
    ViewBag.Title = "FabricInhouse";
}

@{

    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>

    <link href="~/web/css/select2.min.css" rel="stylesheet" />

    <script type="text/javascript">

        $(document).ready(function () {


            Fn_Fill_DropdownList("ddlSearchStyleCode", "Fabric_Order", "StyleCode", "", "");
            Fn_Fill_DropdownList("ddlStyleCode", "Fabric_Order", "StyleCode", "", "");

            $("#txtFromDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());

            $("#txtToDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());

        });

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

        function Fn_OnChange_ddlSearchStyleCode() {

            var strCriteria = "";
            var ddlSearchStyleCode = $("#ddlSearchStyleCode").val();
            if (ddlStyleCode != "0") {
                strCriteria = " AND StyleCode='" + ddlSearchStyleCode + "'";
                Fn_Fill_DropdownList("ddlSearchItemCode", "Fabric_Order", "ItemCode", "", strCriteria);
            }
        }

        function Fn_OnchangeDDLStyleCode() {
            var strCriteria = "";
            var ddlStyleCode = $("#ddlStyleCode").val();
            if (ddlStyleCode != "0") {
                strCriteria = " AND StyleCode='" + ddlStyleCode + "'";
                Fn_Fill_DropdownList("ddlItemCode", "Fabric_Order", "ItemCode", "", strCriteria);
            }
        }

    </script>



}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-5">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Fabric Inhouse</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>
            </div>
            <div class="col-sm-4">
                <span id="spnStyle" style="font-weight: 800;"></span>
            </div>
            <div class="col-sm-3">
                <a href="javascript: void(0);" class="btn btn-primary pull-right" data-toggle="modal" data-target="#AddFabricOrderModal"><i class="fa fa-plus"></i> Add Inhouse Fabric</a>
                &nbsp;&nbsp;<a href="javascript: void(0);" class="btn btn-primary pull-right"><i class="fa fa-cloud-upload"></i></a>
            </div>
        </div>

        <div class="row" style="margin-top: 1%;" id="dvAddOrder">

            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label>Style</label>
                                    <select id="ddlSearchStyleCode" class="form-control" onchange="Fn_OnChange_ddlSearchStyleCode();" style="width: 100%;">
                                        <option value="0">--Select Style--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-5">
                                <div class="form-group">
                                    <label>Fabric</label>
                                    <select id="ddlSearchItemCode" class="form-control" style="width: 100%;">
                                        <option value="0">--Select Fabric--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Lot</label>
                                    <select id="ddlSearchLotNo" class="form-control" style="width: 100%;">
                                        <option value="0">--Select Lot--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="form-label">From-Date</label>
                                    <input type="text" id="txtFromDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="form-label">To-Date</label>
                                    <input type="text" id="txtToDate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <button class="btn btn-primary" style="margin-top: 23px;"><i class="fa fa-search"> Show</i></button>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="table-responsive">
                                <table class="table table-responsive text-nowrap">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                            <td>Style</td>
                                            <td>Order</td>
                                            <td>OrderColor</td>
                                            <td>ItemCode</td>
                                            <td>Fab.Color</td>
                                            <td>Lot Rec.</td>
                                            <td>Lot</td>
                                            <td>Action</td>
                                            <td>Roll</td>
                                            <td>RequiredQty</td>
                                            <td>ActualQty</td>
                                            <td>Rem.Qty</td>
                                            <td>SupplierQty</td>
                                            <td>Difference</td>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>
</section>
<!-- Add Fabric Moded -->
<div id="AddFabricOrderModal" class="modal fade">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content  modal-dialog-centered modal-lg">
            <div class="modal-header">
                <div class="row">
                    <div class="col-sm-10">
                        <h4 class="modal-title">Add Fabric InHouse</h4>
                    </div>
                    <div class="col-sm-2">
                        <button type="button" class="close" style="color:#fff;" data-dismiss="modal" onclick="Fn_Reset_Control();">&times;</button>
                    </div>
                </div>
            </div>
            <div class="modal-body">
                <div class="wrapper">
                    <div class="row">
                        <span style="display: flex; border-bottom: 1px solid #d9d9d9; color: #4f46e5; margin-bottom: 10px; padding-bottom: 8px;">Style & Fabric</span>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Style No. <span class="text-danger">*</span></label>
                                <select id="ddlStyleCode" class="form-control" onchange="Fn_OnchangeDDLStyleCode();" style="width: 100%;">
                                    <option value="0">--Select Style--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="form-group">
                                <label>Fabric <span class="text-danger">*</span></label>
                                <select id="ddlItemCode" class="form-control" style="width: 100%;">
                                    <option value="0">--Select Fabric--</option>
                                </select>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <span style="display: flex; border-bottom: 1px solid #d9d9d9; color: #4f46e5; margin-bottom: 10px; padding-bottom: 8px;">Lot Details</span>

                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>LotNo <span class="text-danger">*</span></label>
                                <input type="text" id="txtLotNo" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Total Roll <span class="text-danger">*</span></label>
                                <input type="text" id="txtTotalRoll" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Supplier Qty (Meter/Kg)</label>
                                <input type="text" id="txtSupplierQty" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <input type="button" id="btnAddFabric" class="btn btn-primary" value="Save" onclick="Fn_Add_FabricOrder();" />
                <button type="button" class="btn btn-default" data-dismiss="modal" onclick="Fn_Reset_Control();">Close</button>
            </div>
        </div>

    </div>
</div>
<!--End Season -->
<script src="~/web/js/select2.min.js"></script>
<script type="text/javascript">
    $(function () {

        $('#ddlSearchStyleCode').select2();
        $('#ddlSearchItemCode').select2();
        $('#ddlSearchStyleLotNo').select2();

        $('#ddlStyleCode').select2({
            dropdownParent: $('#AddFabricOrderModal') // modal id
        });
        $('#ddlItemCode').select2({
            dropdownParent: $('#AddFabricOrderModal') // modal id
        });
        
    });



</script>