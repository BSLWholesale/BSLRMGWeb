
@{
    ViewBag.Title = "FabricInspection";
}

@{

    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>

    <link href="~/web/css/select2.min.css" rel="stylesheet" />

    <script type="text/javascript">

        $(document).ready(function () {

            Fn_Fill_DropdownList("ddlStyleCode", "Fabric_Order", "StyleCode", "", "");

            $("#txtSearchRoll").on("keyup", function () {
                var value = $(this).val().toLowerCase();

                $("#tblSelectRoll tbody tr").filter(function () {
                    $(this).toggle(
                        $(this).find("td:eq(1)").text().toLowerCase().indexOf(value) > -1
                    );
                });
            });

            $("#chkAll").change(function () {
                $(".item").prop("checked", this.checked);
            });

        });

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

        function Fn_OnChange_ddlStyleCode() {

            var strCriteria = "";
            var ddlStyleCode = $("#ddlStyleCode").val();
            if (ddlStyleCode != "0") {
                strCriteria = " AND StyleCode='" + ddlStyleCode + "'";
                Fn_Fill_DropdownList("ddlItemCode", "Fabric_Order", "ItemCode", "", strCriteria);
            }
        }

        function Fn_OnchangeDDLStyleCode() {
            var strCriteria = "";
            var ddlStyleCode = $("#ddlStyleCode").val();
            if (ddlStyleCode != "0") {
                strCriteria = " AND StyleCode='" + ddlStyleCode + "'";
                Fn_Fill_DropdownList("ddlItemCode", "Fabric_Order", "ItemCode", "", strCriteria);
            }
        }

        function Fn_Onchange_ddlItemCode() {
            var strCriteria = "";
            var ddlStyleCode = $("#ddlStyleCode").val();
            var ddlItemCode = $("#ddlItemCode").val();
            if (ddlItemCode != "0") {
                strCriteria = " AND StyleCode='" + ddlStyleCode + "'";
                Fn_Fill_DropdownList("ddlLotNo", "Fabric_Inhouse", "LotNo", "", strCriteria);
            }
        }

        function Fn_Onchange_ddlLotNo() {
            debugger;
            var ddlSearchLotNo = $("#ddlLotNo").val();
            if (ddlSearchLotNo == "0") {
                $("#dvAddRoll").hide();
            }
            else {
                $("#dvAddRoll").show();
                Fn_Get_Fabric_Roll();
            }
        }

        function Fn_Reset_Control() {

            $("#ddlStyleCode").select2("val", "0");
            $("#ddlItemCode").select2("val", "0");
            $("#txtLotNo").val("");
            $("#txtTotalRoll").val("");
            $("#txtSupplierQty").val("");
        }

        function Fn_Get_Fabric_Roll() {

            var FabricInhouse = {};
            FabricInhouse.CreatedBy = sessionStorage.getItem("LogInID");
            FabricInhouse.StyleCode = $("#ddlStyleCode").val();
            FabricInhouse.ItemCode = $("#ddlItemCode").val();
            FabricInhouse.LotNo = $("#ddlLotNo").val();

            $("#tbodySelectRoll").html('');
            var html = '';
            $.ajax({
                type: "POST",
                url: "/Fabric/Fn_Get_Fabric_Roll",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(FabricInhouse),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {

                        for (var i = 0; i < obj.length; i++) {

                            html += "<tr>";
                            html += "<td><input type='checkbox' id='chk_" + obj[i].InHouseId + "' class='item'></td>";
                            html += "<td>" + obj[i].RollNo + "</td>";
                            html += "<td>" + obj[i].Quantity + "</td>";
                            html += "</tr>";

                        }
                    }
                    else {
                        html += "<tr><td colspan='3' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                    }
                    $("#tbodySelectRoll").append(html);
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });

                }
            });
        }

        

    </script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        /* Popup */
        .popup {
            position: fixed;
            top: 0;
            right: -450px;
            width: 450px;
            height: 100vh;
            /*height: 550px;*/
            background: #fff;
            box-shadow: -4px 0 15px rgba(0, 0, 0, 0.2);
            transition: right 0.3s ease;
            z-index: 1012;
            /* Header + body + footer */
            display: flex;
            flex-direction: column;
        }

            .popup.active {
                right: 0;
            }

        /* Header */
        .popup-header {           
            height: 50px;
            padding: 0 20px;
            background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

            .popup-header h2 {
                margin: 0;
                font-size: 16px;
            }

        .close-btn {
            background: none;
            border: none;
            color: white;
            font-size: 28px;
            cursor: pointer;
        }

        /* Body */
        .popup-body {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        /* Footer */
        .popup-footer {
            height: 70px;
            padding: 0 20px;
            border-top: 1px solid #ddd;
            background: #f8f8f8;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-shrink: 0;
        }
        

        /* Mobile */
        @@media (max-width: 500px) {
            .popup {
                width: 100%;
                right: -100%;
            }
        }
    </style>
}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-5">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Fabric Inspection</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>
            </div>
            <div class="col-sm-4">
                <span id="spnStyle" style="font-weight: 800;"></span>
            </div>
            <div class="col-sm-3">

            </div>
        </div>

        <div class="row" style="margin-top: 1%;">

            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label>Style</label>
                                    <select id="ddlStyleCode" class="form-control" onchange="Fn_OnChange_ddlStyleCode();" style="width: 100%;">
                                        <option value="0">--Select Style--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label>Fabric</label>
                                    <select id="ddlItemCode" class="form-control" onchange="Fn_Onchange_ddlItemCode();" style="width: 100%;">
                                        <option value="0">--Select Fabric--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Lot</label>
                                    <select id="ddlLotNo" class="form-control" onchange="Fn_Onchange_ddlLotNo();" style="width: 100%;">
                                        <option value="0">--Select Lot--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-1" id="dvAddRoll">
                                <div class="form-group">
                                    <label>Roll</label>
                                    <button type="button" id="btnAddRoll" class="btn btn-primary" onclick="openPopup()"><i class="fa fa-plus-circle"> Add</i></button>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-warning"><i class="fa fa-file"></i> Combined</button>

                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="margin-top: 1%;">

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="row" style="padding-bottom: 0px;">
                            <div class="table-responsive">
                                <table class="table table-hover table-responsive">
                                    <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                        <th> <i class="fa fa-database "></i></th>
                                        <th><span class="pull-right">Batches</span></th>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div class="row" style="margin-top: -20px">
                            <div class="table-responsive">
                                <table class="table table-hover table-responsive">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                            <th>Batch</th>
                                            <th><span class="pull-right">Print</span></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyBatchList"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header" style="background: linear-gradient(to bottom, #722F37, #DB5A6A); color: white; padding: 10px !important; width: 100%;">
                        <i class="fa fa-reorder pull-left"></i> Rolls

                    </div>
                    <div class="card-body">
                        <div class="row">
                            <input type="text" id="txtSearch" class="form-control" placeholder="Search Roll..." />
                        </div>
                        <div class="row">
                            <div class="table-responsive">
                                <table class="table table-hover table-responsive">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                            <th>Roll No</th>
                                            <th>Qty</th>
                                            <th>Status</th>
                                            <th>Report</th>
                                            <th>Start</th>
                                            <th>Print</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>
    </section>
</section>
<!-- model popup start-->

<div id="popup" class="popup">

    <!-- Header -->
    <div class="popup-header">
        <h2>Select Rolls for Inspection</h2>

        <button class="close-btn" onclick="closePopup()">
            &times;
        </button>
    </div>

    <!-- Body -->
    <div class="popup-body">


        <div class="row">
            <div class="col-sm-12">
                <input type="text" id="txtSearchRoll" class="form-control" placeholder="Search Roll..." />
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-12">
                <div class="table-responsive">
                    <table class="table table-hover table-responsive" id="tblSelectRoll">
                        <thead>
                            <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                <th><input type="checkbox" id="chkAll" value="All" /> All</th>
                                <th>Roll</th>
                                <th>Qty</th>
                            </tr>
                        </thead>
                        <tbody id="tbodySelectRoll"></tbody>
                    </table>
                </div>
                
            </div>
        </div>


    </div>


    <!-- Footer -->
    <div class="popup-footer">
        <button class="btn btn-primary" onclick="saveData()">
            Save
        </button>
        <button class="btn btn-cancel" onclick="closePopup()">
            Cancel
        </button>
    </div>

</div>

<script>
    function openPopup() {
        document.getElementById("popup").classList.add("active");
    }

    function closePopup() {
        document.getElementById("popup").classList.remove("active");
    }
</script>

<!-- End popup -->
