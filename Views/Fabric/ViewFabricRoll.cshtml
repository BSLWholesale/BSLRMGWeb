
@{
    ViewBag.Title = "ViewFabricRoll";
}

@{

    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>

    <link href="~/web/css/select2.min.css" rel="stylesheet" />

    <script type="text/javascript">

        $(document).ready(function () {


            //Fn_Fill_DropdownList("ddlSearchStyleCode", "Fabric_Order", "StyleCode", "", "");
            //Fn_Fill_DropdownList("ddlStyleCode", "Fabric_Order", "StyleCode", "", "");

            Fn_Get_Fabric_Roll();
        });

        function Fn_Upload_Fabirc_Inhouse() {

            var FabricInhouse = {};
            FabricInhouse.CreatedBy = sessionStorage.getItem("LogInID");
            FabricInhouse.StyleCode = sessionStorage.getItem("stylecode");
            FabricInhouse.ItemCode = sessionStorage.getItem("itemcode");


            let formData = new FormData();
            let file = $("#fsUploadLotFile").get(0).files[0];

            formData.append("file", file);
            formData.append("CreatedBy", FabricInhouse.CreatedBy);
            formData.append("StyleCode", FabricInhouse.StyleCode);
            formData.append("ItemCode", FabricInhouse.ItemCode);
            if (!file) {
                Swal.fire({ title: "", text: "Please upload file", icon: "error" });
            }
            else if (FabricInhouse.StyleCode == "0") {
                Swal.fire({ title: "", text: "Please Select StyleCode", icon: "error" });
            }
            else if (FabricInhouse.ItemCode == "0") {
                Swal.fire({ title: "", text: "Please Select ItemCode", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Fabric/Fn_Upload_Fabirc_Inhouse",
                    data: formData,
                    processData: false,
                    contentType: false,
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {

                            Swal.fire({ title: "", text: "File uploaded successfully", icon: "success" });
                            const EmpDataExcelFile = document.getElementById('fsUploadLotFile');
                            EmpDataExcelFile.value = '';
                            Fn_Get_Fabric_Roll();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }

                    },
                    complete: function (data) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }

        }

        function Fn_Get_Fabric_Roll() {

            var style = sessionStorage.getItem("stylecode");
            var itemcode = sessionStorage.getItem("itemcode");

            var FabricInhouse = {};
            FabricInhouse.CreatedBy = sessionStorage.getItem("LogInID");
            FabricInhouse.StyleCode = style;
            FabricInhouse.ItemCode = itemcode;

            $("#tbody").html('');
            var html = '';
            $.ajax({
                type: "POST",
                url: "/Fabric/Fn_Get_Fabric_Roll",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(FabricInhouse),
                beforeSend: function () {
                    $("#loader").show();
                    $("#dvMain").hide();
                },
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {

                        var totalQty = 0;

                        for (var i = 0; i < obj.length; i++) {

                            totalQty += parseFloat(obj[i].Quantity) || 0;

                            html += "<tr id='row_" + obj[i].InHouseId + "'>";
                            html += "<td id='RollNo_row_" + obj[i].InHouseId + "'>" + obj[i].RollNo + "</td>";
                            html += "<td id='Quantity_row_" + obj[i].InHouseId + "'>" + obj[i].Quantity + "</td>";
                            html += "<td id='Unit_row_" + obj[i].InHouseId + "'>" + obj[i].Unit + "</td>";
                            html += "<td id='Width_row_" + obj[i].InHouseId + "'>" + obj[i].Width + "</td>";
                            html += "<td id='ShadeName_row_" + obj[i].InHouseId + "'>" + obj[i].ShadeName + "</td>";
                            html += "<td id='GSM_row_" + obj[i].InHouseId + "'>" + obj[i].GSM + "</td>";
                            html += "<td id='Shrinkage_row_" + obj[i].InHouseId + "'>" + obj[i].Shrinkage + "</td>";
                            html += "<td id='row_" + obj[i].InHouseId + "'>";
                            html += "<button id='edit_button" + obj[i].InHouseId + "' onclick='Fn_Edit_OB_Row(" + obj[i].InHouseId + ")' class='btn btn-xs btn-info'><i class='fa fa-edit'></i></button>";
                            html += "<button id='cancel_button" + obj[i].InHouseId + "' onclick='Fn_Cancel_OB_Row(" + obj[i].InHouseId + ")' style='display:none;' class='btn btn-xs btn-warning'><i class='fa fa-times'></i></button>";
                            html += "<button id='save_button" + obj[i].InHouseId + "' onclick='Fn_Save_OB_Row(" + obj[i].InHouseId + ")' style='display:none;' class='btn btn-xs btn-success'><i class='fa fa-check'></i></button>";
                            html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-danger deleteOBRow'><i class='fa fa-trash' ></i></a>";
                            html += "</td>";
                            html += "</tr>";

                        }

                        // Total row
                        html += "<tr style='font-weight:bold;background:#f5f5f5;'>";
                        html += "<td>Total</td>";
                        html += "<td>" + totalQty + "</td>";
                        html += "<td></td><td></td><td></td><td></td><td></td><td></td>";
                        html += "</tr>";
                    }
                    else {
                        html += "<tr><td colspan='8' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                    }
                    $("#tbody").append(html);
                },
                complete: function (data) {
                    $("#loader").hide();
                    $("#dvMain").show();
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });

                }
            });
        }

        function Fn_Edit_OB_Row(no) {

            document.getElementById("edit_button" + no).style.display = "none";
            document.getElementById("save_button" + no).style.display = "inline-block";
            document.getElementById("cancel_button" + no).style.display = "inline-block";


            var widths = {
                Quantity: "80px",
                Width: "80px",
                ShadeName: "80px",
                GSM: "80px",
                Shrinkage: "80px"
            };

            var cells = ["Quantity", "Width", "ShadeName", "GSM", "Shrinkage"];
            cells.forEach(function (type) {
                var cell = document.getElementById(type + "_row_" + no);

                if (cell) {
                    var currentValue = cell.innerText.trim(); // safer than innerHTML
                    cell.innerHTML =
                        "<input type='text' style='width:" + widths[type] + ";' id='" + type + "_text" + no + "' value='" + currentValue + "'>";
                }
            });
        }

        function Fn_Cancel_OB_Row11(no) {

            var cells = ["Quantity", "Width", "ShadeName", "GSM", "Shrinkage"];

            cells.forEach(function (type) {

                var input = document.getElementById(type + "_text" + no);
                var cell = document.getElementById(type + "_row_" + no);

                if (cell) {

                    // If input exists, ignore changes and restore original value from row data
                    var originalValue = $("#row_" + no).data(type.toLowerCase());

                    cell.innerHTML = originalValue;
                }
            });


            document.getElementById("edit_button" + no).style.display = "inline-block";
            document.getElementById("save_button" + no).style.display = "none";
            document.getElementById("cancel_button" + no).style.display = "none";
        }

        function Fn_Cancel_OB_Row(no) {

            var cells = ["Quantity", "Width", "ShadeName", "GSM", "Shrinkage"];

            cells.forEach(function (type) {

                var input = document.getElementById(type + "_text" + no);
                var cell = document.getElementById(type + "_row_" + no);

                if (input && cell) {
                    // Set textbox value back to td
                    cell.innerHTML = input.value;
                }
            });

            $("#edit_button" + no).show();
            $("#save_button" + no).hide();
            $("#cancel_button" + no).hide();
        }

        function Fn_Save_OB_Row(no) {

            var FabricInhouseList = {};

            var cells = ["Quantity", "Width", "ShadeName", "GSM", "Shrinkage"];

            cells.forEach(function (type) {
                var input = document.getElementById(type + "_text" + no);
                var cell = document.getElementById(type + "_row_" + no);

                //if (input && cell) {
                //    cell.innerHTML = input.value;
                //    FabricInhouseList.Quantity = input.value
                //    FabricInhouseList.OpNo = no;
                //}
                FabricInhouseList.InHouseId = no;
                FabricInhouseList.Quantity = document.getElementById("Quantity_text" + no).value;
                FabricInhouseList.Width = document.getElementById("Width_text" + no).value;
                FabricInhouseList.ShadeName = document.getElementById("ShadeName_text" + no).value;
                FabricInhouseList.GSM = document.getElementById("GSM_text" + no).value;
                FabricInhouseList.Shrinkage = document.getElementById("Shrinkage_text" + no).value;

                Swal.fire({
                    title: 'Are your sure?',
                    text: "Do you want to update ?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes',
                }).then((result) => {
                    if (result.isConfirmed) {
                        FabricInhouseList.CreatedBy = sessionStorage.getItem("LogInID");
                        $.ajax({
                            type: "POST",
                            url: "/Fabric/Fn_Update_Fabric_RollNo",
                            contentType: "application/json;charset=utf-8",
                            dataType: "json",
                            data: JSON.stringify(FabricInhouseList),
                            success: function (data) {
                                var obj = JSON.parse(data.message);
                                if (obj.vErrorMsg == "Success") {
                                    Swal.fire({ title: "", text: "RollNo updated successfully.", icon: "success" });
                                    document.getElementById("edit_button" + no).style.display = "inline-block";
                                    document.getElementById("save_button" + no).style.display = "none";
                                    return true;
                                }
                                else {
                                    Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                                }
                            },
                            error: function (err) {
                                alert(err);
                            }
                        });
                    }
                    else {
                        Fn_Cancel_OB_Row(no);
                        return false;
                    }
                });

            });
        }
      

    </script>

}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-5">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Fabric Inhouse</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>
            </div>
            <div class="col-sm-4">
                <span id="spnStyle" style="font-weight: 800;"></span>
            </div>
            <div class="col-sm-3">
                <a href="javascript: void(0);" data-toggle="modal" data-target="#myModal" class="btn btn-primary pull-right" style="margin-right: 5px;">
                    <i class="fa fa-cloud-upload"></i>
                </a>
            </div>
        </div>

        <div class="row" style="margin-top: 1%;">

            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-8">
                                <div class="form-group">
                                    <label>Search By Roll No</label>
                                    <select id="ddlSearchStyleCode" class="form-control" onchange="Fn_OnChange_ddlSearchStyleCode();" style="width: 100%;">
                                        <option value="0">--Select Style--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <button class="btn btn-primary" style="margin-top: 20px;"><i class="fa fa-refresh"></i> Refresh</button>
                                    <button class="btn btn-primary" style="margin-top: 20px;"><i class="fa fa-qrcode"></i> Print QRCode</button>
                                </div>
                            </div>

                        </div>


                        <div class="row">
                            <div class="table-responsive">
                                <table class="table table-responsive text-nowrap">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                            <td>RollNO</td>
                                            <td>Quantity</td>
                                            <td>Unit</td>
                                            <td>Width</td>
                                            <td>Shade</td>
                                            <td>GSM</td>
                                            <td>Shrin.</td>
                                            <td>Action</td>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>
    </section>
</section>

<!-- Start Upload modal -->
<div class="modal" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">
                    <i class="fa fa-cloud-upload"></i> Upload Roll Details From Excel
                </h4>
            </div>
            <!-- Modal body -->
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-9">
                        <div class="form-group">
                            <label>File Upload</label>
                            <input type="file" id="fsUploadLotFile" name="fsUploadLotFile" accept=".xlsx,.xls" class="form-control">
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <button class="btn btn-primary" style="margin-top:20px;" onclick="Fn_Upload_Fabirc_Inhouse();"><i class="fa fa-upload"></i> Updoad</button>
                    </div>
                </div>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <a href="~/DOC/INHOUSE_TEMPLATE.xlsx" class="pull-left" download><i class="fa fa-upload"></i> Sample Template</a>
                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- End Upload model-->