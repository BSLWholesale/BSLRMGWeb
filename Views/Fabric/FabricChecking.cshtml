<script>

    const tabs = document.querySelectorAll(".tab");
    const tabContents = document.querySelectorAll(".tab-content");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const buttonArea = document.getElementById("buttonArea");
    const form = document.getElementById("productForm");

    let currentTab = 0;
    const totalTabs = tabs.length;

    function showTab(tabIndex) {

        if (tabIndex < 0) {
            tabIndex = 0;
        }

        if (tabIndex >= totalTabs) {
            tabIndex = totalTabs - 1;
        }

        currentTab = tabIndex;

        tabs.forEach(function (tab) {

            tab.classList.remove("active");

        });

        tabContents.forEach(function (content) {

            content.classList.remove("active");

        });

        tabs[currentTab].classList.add("active");

        tabContents[currentTab].classList.add("active");

        if (currentTab === 0) {
            prevBtn.disabled = true;
        }
        else {
            prevBtn.disabled = false;
        }

        if (currentTab === totalTabs - 1) {
            nextBtn.innerHTML = "Complete ✓";
        }
        else {
            nextBtn.innerHTML = "Next &gt;";
        }

    }


    /* ==========================================
       NEXT / COMPLETE BUTTON
    ========================================== */

    nextBtn.addEventListener("click", function () {
        if (currentTab < totalTabs - 1) {

            showTab(currentTab + 1);

        }
        else {
            completeForm();
        }

    });

    prevBtn.addEventListener("click", function () {

        if (currentTab > 0) {
            showTab(currentTab - 1);
        }

    });


    tabs.forEach(function (tab, index) {

        tab.addEventListener("click", function () {
            showTab(index);
        });

    });



    function completeForm() {

        /*
         * Get all form data
         */

        const formData = new FormData(form);


        /*
         * Create an object
         */

        const data = {};

        formData.forEach(function (value, key) {

            data[key] = value;

        });


        /*
         * Display data in browser console
         */

        console.log("FORM DATA:");

        console.log(data);


        /*
         * You can send data to your backend here.
         *
         * Example:
         *
         * fetch("save.php", {
         *     method: "POST",
         *     body: formData
         * });
         */


        /*
         * Hide all tab content
         */

        tabContents.forEach(function (content) {

            content.classList.remove("active");

        });


        /*
         * Hide tabs
         */

        document.getElementById("tabs")
            .style.display = "none";


        /*
         * Hide buttons
         */

        buttonArea.style.display = "none";

    }

    showTab(0);

</script>


<script>
    function selectLocation(selectedInput) {
        // Get all location inputs 
        var tabs = document.querySelectorAll('.location-tab');
        // Reset all tabs 
        tabs.forEach(function (tab) {
            tab.style.backgroundColor = '#f1f1f1'; tab.style.color = '#333';
        });
        // Set selected tab 
        selectedInput.style.backgroundColor = '#007bff'; selectedInput.style.color = 'white';
    }
</script>