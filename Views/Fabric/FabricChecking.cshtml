
@{
    ViewBag.Title = "FabricChecking";
}

@{

    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>

    <link href="~/web/css/select2.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />

    <script type="text/javascript">

        $(document).ready(function () {

            const params = new URLSearchParams(window.location.search);
            var pBatch = params.get("pBatch");
            var pRoll = params.get("pRoll");
            var pQty = params.get("pQty");
            var pBatchDetailId = params.get("DetailId");

            var ddlStyleCode = sessionStorage.getItem("ddlStyleCode");
            var ddlItemCode = sessionStorage.getItem("ddlItemCode");
            var ddlLotNo = sessionStorage.getItem("ddlLotNo");

            $("#spnStyleCode").html(ddlStyleCode);
            $("#spnFabric").html(ddlItemCode);
            $("#spnLot").html(ddlLotNo);

            $("#spnBatch").html("Batch-" + pBatch);
            $("#spnRoll").html(pRoll);
            $("#spnQty").html(pQty);

            Fn_Get_Fabric_Defect_Inspection();
        });

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

        function Fn_Get_Fabric_Defects_Master() {

            var clsQADefects = {};
            clsQADefects.CreatedBy = sessionStorage.getItem("LogInID");

            $("#tbodyDefect").html('');
            var html = '';
            $.ajax({
                type: "POST",
                url: "/Fabric/Fn_Get_Fabric_Defects_Master",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsQADefects),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        for (var i = 0; i < obj.length; i++) {
                            html += "<tr>";
                            html += "<td><input type='checkbox' id='chk_" + obj[i].ID + "' class='item' value='" + obj[i].ID + "' /></td>";
                            html += "<td>" + obj[i].Defects + "</td>";
                            html += "</tr>";
                        }
                    }
                    else {
                        html += "<tr><td colspan='2' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                    }
                    $("#tbodyDefect").append(html);
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });

                }
            });
        }

        function Fn_Add_Fabric_Defect_Inspection() {

            const params = new URLSearchParams(window.location.search);
            var pBatchDetailId = params.get("DetailId");

            var Fabric_Defect_Inspection = {};
            Fabric_Defect_Inspection.BatchDetailId = pBatchDetailId;
            Fabric_Defect_Inspection.CreatedBy = sessionStorage.getItem("LogInID");
            Fabric_Defect_Inspection.DefectLocation = $(".location-tab.active").val();
            Fabric_Defect_Inspection.PositionMTR = $("#txtPositionMTR").val();
            Fabric_Defect_Inspection.PenaltyPoints = $("#ddlPenaltyPoints").val();
            Fabric_Defect_Inspection.FabDefect_Image = $("#fsPhoto").val();

            var strDefectList = "";
            $('#tbodyDefect .item:checked').each(function () {

                var DefectId = $(this).val();
                if (strDefectList !== "") {
                    strDefectList += ",";
                }
                strDefectList += DefectId;
            });

            Fabric_Defect_Inspection.DefectList = strDefectList;

            var formData = new FormData();

            formData.append("BatchDetailId", Fabric_Defect_Inspection.BatchDetailId);
            formData.append("CreatedBy", Fabric_Defect_Inspection.CreatedBy);
            formData.append("DefectLocation", Fabric_Defect_Inspection.DefectLocation);
            formData.append("PositionMTR", Fabric_Defect_Inspection.PositionMTR);
            formData.append("PenaltyPoints", Fabric_Defect_Inspection.PenaltyPoints);
            formData.append("DefectList", Fabric_Defect_Inspection.DefectList);

            // Get selected image
            var photoFile = $("#fsPhoto")[0].files[0];

            if (photoFile) {
                formData.append("FabDefect_Image", photoFile);
            }


            if (pBatchDetailId == 0 || pBatchDetailId == null) {
                Swal.fire({ title: "", text: "BatchDetailId not supplyed.", icon: "error" });
            }
            else if (strDefectList == "") {
                Swal.fire({ title: "", text: "Please select at least one defect.", icon: "error" });
            }
            else if ($("#txtPositionMTR").val() == "") {
                Swal.fire({ title: "", text: "Please enter position(MTR)", icon: "error" });
            }
            else if ($("#ddlPenaltyPoints").val() == "0") {
                Swal.fire({ title: "", text: "Please select penalty points ", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Fabric/Fn_Add_Fabric_Defect_Inspection",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Fn_Reset_control();
                            Swal.fire({ title: "", text: "Fabric Defect Inspection Added Successfully.", icon: "success" });
                            Fn_Get_Fabric_Defect_Inspection();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: "Error while saving inspection.", icon: "error" });
                    }
                });
            }


        }

        function Fn_Reset_control() {


            $("#txtPositionMTR").val("");
            $("#ddlPenaltyPoints").val(0);
            $("#fsPhoto").val();
            $('.item').prop('checked', false);
            document.getElementById("fsPhoto").value = "";

            $("#txtActualLength").val("");
            $("#txtActualWeight").val("");
            $("#txtActualWidth").val("");
            $("#txtGSM").val("");
            $("#txtSupplierWeight").val("");
            $("#txtSupplierLength").val("");
            $("#txtStart").val("");
            $("#txtMid").val("");
            $("#txtEnd").val("");
            $("#txtBowing").val("");
            $("#txtSkewing").val("");
            $("#ddlShade").val(0);
            $("#txtDescription").val("");
        }

        function Fn_Get_Fabric_Defect_Inspection() {

            const params = new URLSearchParams(window.location.search);
            var pBatchDetailId = params.get("DetailId");

            var Fabric_Defect_Inspection = {};
            Fabric_Defect_Inspection.BatchDetailId = pBatchDetailId;
            Fabric_Defect_Inspection.CreatedBy = sessionStorage.getItem("LogInID");


            $("#dvDefect").html('');
            var html = ''; var rCount = 0;
            $.ajax({
                type: "POST",
                url: "/Fabric/Fn_Get_Fabric_Defect_Inspection",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(Fabric_Defect_Inspection),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        for (var i = 0; i < obj.length; i++) {

                            html += "<div class='row' style='padding: 15px; background: #eaeaea; margin: 5px auto 0; width: 96%; border-radius: 10px; border-left: 4px solid #722F37;'>";
                            html += "<div class='col-sm-10' style='color: black; font-weight: 800;'>" + obj[i].DefectList + "</div>";

                            html += "<div class='col-sm-2'>";
                            html += "<a href='javascript:void(0);' class='btn btn-xs btn-danger' title='delete'>";
                            html += "<i class='fa fa-trash' onclick=\"Fn_Delete_Fabric_Defect_Inspection(" + obj[i].FabDefectId + ", " + obj[i].BatchDetailId + ")\"></i>";
                            html += "</a>";
                            html += "</div>";

                            html += "<div class='col-sm-4' style='margin-top: 10px;'>";
                            html += "<span style='background: #fff; padding: 5px 10px;'><i class='fa fa-location-dot'></i>" + obj[i].PositionMTR + "m</span>";
                            html += "</div>";

                            html += "<div class='col-sm-4' style='margin-top: 10px;'>";
                            html += "<span style='background: #fff; padding: 5px 10px;'><i class='fa fa-star fa-xs'></i> " + obj[i].PenaltyPoints + " pt</span>";
                            html += "</div>";

                            html += "<div class='col-sm-4' style='margin-top: 10px;'>";
                            html += "<span style='background: #fff; padding: 5px 10px;'>" + obj[i].DefectLocation + "</span>";
                            html += "</div>";
                            
                            html += "<div class='col-sm-4' style='margin-top: 10px;'>";
                            html += "<div onclick=\"openCameraPopup('" + obj[i].FabDefect_Image + "')\" style='width: 50px; height: 50px; border: 2px dotted #999; border-radius: 10px; display: flex; justify-content: center; align-items: center; background: #fff; cursor: pointer;'>";
                            html += "<i class='fa fa-camera fa-2x' style='color: #722F37;'></i>";
                            html += "</div>";
                            html += "</div>";
                            html += "</div>";
                            rCount++;
                        }
                    }
                    else {
                        html += "<div class='defect-icon'>";
                        html += "    <div class='fabric fabric-one'></div>";
                        html += "    <div class='fabric fabric-two'></div>";
                        html += "</div>";
                        html += "<div class='defect-message text-center'>No defects are added for this<br> fabric and lot";
                        html += "</div>";
                    }
                    $("#dvDefect").append(html);
                    $(".spnCountDefect").html(rCount);
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });

                }
            });
        }

        function Fn_Delete_Fabric_Defect_Inspection(pFabDefectId, pBatchDetailId) {
            

            var Fabric_Defect_Inspection = {};
            Fabric_Defect_Inspection.FabDefectId = pFabDefectId;
            Fabric_Defect_Inspection.BatchDetailId = pBatchDetailId;
            Fabric_Defect_Inspection.CreatedBy = sessionStorage.getItem("LogInID");

            $.ajax({
                type: "POST",
                url: "/Fabric/Fn_Delete_Fabric_Defect_Inspection",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(Fabric_Defect_Inspection),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj.vErrorMsg == "Success") {
                        Swal.fire({ title: "", text: "Deleted Record Successfully", icon: "success" });
                        Fn_Get_Fabric_Defect_Inspection();
                    }
                    else {
                        Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                    }                    
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });

                }
            });
        }

        function Fn_Add_Fabric_Defect_CheckPoint() {

            const params = new URLSearchParams(window.location.search);
            var pBatchDetailId = params.get("DetailId");

            var Fabric_Defect_CheckPoint = {};
            Fabric_Defect_CheckPoint.BatchDetailId = pBatchDetailId;
            Fabric_Defect_CheckPoint.CreatedBy = sessionStorage.getItem("LogInID");
            Fabric_Defect_CheckPoint.ActualLength = $("#txtActualLength").val();
            Fabric_Defect_CheckPoint.ActualWeight = $("#txtActualWeight").val();
            Fabric_Defect_CheckPoint.ActualWidth = $("#txtActualWidth").val();
            Fabric_Defect_CheckPoint.GSM = $("#txtGSM").val();
            Fabric_Defect_CheckPoint.SupplierWeight = $("#txtSupplierWeight").val();
            Fabric_Defect_CheckPoint.SupplierLength = $("#txtSupplierLength").val();
            Fabric_Defect_CheckPoint.CutStart = $("#txtStart").val();
            Fabric_Defect_CheckPoint.CutMid = $("#txtMid").val();
            Fabric_Defect_CheckPoint.CutEnd = $("#txtEnd").val();
            Fabric_Defect_CheckPoint.Bowing = $("#txtBowing").val();
            Fabric_Defect_CheckPoint.Skewing = $("#txtSkewing").val();
            Fabric_Defect_CheckPoint.Shade = $("#ddlShade").val();
            Fabric_Defect_CheckPoint.Descriptions = $("#txtDescription").val();

            if ($("#txtActualLength").val() == "" || $("#txtActualLength").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter Actual Length", icon: "error" });
            }
            else if ($("#txtActualWidth").val() == "" || $("#txtActualWidth").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter Actual Width", icon: "error" });
            }
            else if ($("#txtSupplierLength").val() == "" || $("#txtSupplierLength").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter SupplierLength", icon: "error" });
            }
            else if ($("#txtStart").val() == "" || $("#txtStart").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter Cut Start", icon: "error" });
            }
            else if ($("#txtMid").val() == "" || $("#txtMid").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter Cut Mid", icon: "error" });
            }
            else if ($("#txtEnd").val() == "" || $("#txtEnd").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter Cut End", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Fabric/Fn_Add_Fabric_Defect_CheckPoint",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(Fabric_Defect_CheckPoint),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Swal.fire({ title: "", text: "Saved Successfully.", icon: "success" });
                            Fn_Reset_control();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });

                    }
                });
            }
            
        }

    </script>

    <style>
        .defect-container {
            border-radius: 20px;
            overflow: hidden;
            background: #fff;
        }

        .defect-header {
            height: 50px;
            background-color: #E1C16E;
            background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
            color: white;
            padding-left: 50px;
            padding-top: 15px;
        }

        .defect-body {
            height: 350px;
            background: #fff;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .defect-card {
            position: relative;
            background: #ffffff;
            margin: 12px 0;
            padding: 25px 28px;
            border-left: 6px solid #d7193f;
            border-radius: 18px;
            min-height: 230px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .defect-icon {
            /*width: 100px;*/
            height: 110px;
            position: relative;
            margin-top: 10%;
        }

        .fabric {
            position: absolute;
            width: 62px;
            height: 82px;
            border: 2px solid #d0d3d7;
            border-radius: 8px;
        }

        .fabric-one {
            top: 8px;
            left: 35%;
            transform: rotate(-4deg);
        }

        .fabric-two {
            top: 22px;
            left: 45%;
            transform: rotate(4deg);
        }

        .defect-message {
            color: #9da0a5;
            font-size: 15px;
            line-height: 1.35;
        }

        .add-defect-btn {
            height: 50px;
            width: 100%;
            border: 0;
            border-radius: 0 0 20px 20px;
            background: #ffd400;
            color: #272727;
            font-size: 15px;
        }

        /*Added css for tab*/



    </style>

    <style>
        /* ==============================
           TABS
        ============================== */

        .tabs {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
            overflow-x: auto;
        }

        .tab {
            border: none;
            outline: none;
            background: transparent;
            padding: 15px 25px;
            border-radius: 12px;
            color: #263247;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: 0.25s ease;
        }

            .tab:hover {
                color: white;
                /*background: linear-gradient( 90deg, #1581ed, #2939e8 );*/
                background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
            }

            .tab.active {
                color: white;
                background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
                box-shadow: 0 5px 15px rgba(114, 47, 55, 0.35);
                /*background: linear-gradient( 90deg, #1581ed, #2939e8 );
                box-shadow: 0 5px 15px rgba(40, 70, 230, 0.20);*/
            }

        /* ==============================
           TAB CONTENT
        ============================== */

        .tab-content {
            display: none;
        }

            .tab-content.active {
                display: block;
            }



        /* ==============================
           BUTTON AREA
        ============================== */

        .button-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 45px;
        }

        /* ==============================
           BUTTONS
        ============================== */


        /* PREVIOUS */

        .btn-prev {
            min-width: 120px;
            /*background: transparent;*/
            background: #eef1f6;
            color: #182238;
        }

            .btn-prev:hover:not(:disabled) {
                background: #eef1f6;
            }

            .btn-prev:disabled {
                opacity: 0.35;
                cursor: not-allowed;
            }

        /* NEXT */

        .btn-next {
            min-width: 260px;
            color: white;
            background: linear-gradient( 90deg, #1682ed, #2939e8 );
            box-shadow: 0 5px 15px rgba(38, 72, 225, 0.20);
        }

            .btn-next:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(38, 72, 225, 0.30);
            }

            .btn-next:active {
                transform: translateY(0);
            }

        /* ==============================
           MOBILE
        ============================== */

        @@media (max-width: 700px) {


            .tabs {
                gap: 5px;
            }

            .tab {
                padding: 12px 15px;
                font-size: 14px;
            }

            .button-area {
                margin-top: 30px;
            }

            .btn-next {
                min-width: 160px;
            }
        }
    </style>

    /* start for popup style css */
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        /* Popup */
        .popup {
            position: fixed;
            top: 0;
            right: -450px;
            width: 450px;
            height: 100vh;
            /*height: 550px;*/
            background: #fff;
            box-shadow: -4px 0 15px rgba(0, 0, 0, 0.2);
            transition: right 0.3s ease;
            z-index: 1012;
            /* Header + body + footer */
            display: flex;
            flex-direction: column;
        }

            .popup.active {
                right: 0;
            }

        /* Header */
        .popup-header {
            height: 50px;
            padding: 0 20px;
            background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

            .popup-header h2 {
                margin: 0;
                font-size: 16px;
            }

        .close-btn {
            background: none;
            border: none;
            color: white;
            font-size: 28px;
            cursor: pointer;
        }

        /* Body */
        .popup-body {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        /* Footer */
        .popup-footer {
            height: 70px;
            padding: 0 20px;
            border-top: 1px solid #ddd;
            background: #f8f8f8;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-shrink: 0;
        }


        /* Mobile */
        @@media (max-width: 500px) {
            .popup {
                width: 100%;
                right: -100%;
            }
        }
    </style>

    /////////////// Camera opne popup image
    
    <style>
        
        /* Popup */
        .camera-popup {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
        }

        /* Popup content */
        .camera-popup-content {
            background: #fff;
            width: 400px;
            max-width: 90%;
            margin: 10% auto;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            position: relative;
        }

        /* Close */
        .close-popup {
            position: absolute;
            right: 15px;
            top: 5px;
            font-size: 30px;
            cursor: pointer;
        }

        /* Image preview */
        .image-preview {
            width: 100%;
            height: 250px;
            border: 2px dotted #aaa;
            border-radius: 10px;
            margin: 15px 0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .image-preview img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }
    </style>
}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-5">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Fabric Inspection</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>
            </div>
            <div class="col-sm-4">
                <span id="spnStyle" style="font-weight: 800;"></span>
            </div>
            <div class="col-sm-3">

            </div>
        </div>

        <div class="row" style="margin-top: 1%;">
            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="table-responsive">
                                <table class="table" style="margin-bottom: 0px">
                                    <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                        <td>
                                            <div class="form-group" style="background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 5px; padding: 5px;">
                                                Style<br />
                                                <span id="spnStyleCode"></span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="form-group" style="background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 5px; padding: 5px;">
                                                Fabric<br />
                                                <span id="spnFabric"></span>
                                            </div>
