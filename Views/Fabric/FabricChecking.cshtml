<script>

    /* ==========================================
       GET ELEMENTS
    ========================================== */

    const tabs = document.querySelectorAll(".tab");

    const tabContents =
        document.querySelectorAll(".tab-content");

    const prevBtn =
        document.getElementById("prevBtn");

    const nextBtn =
        document.getElementById("nextBtn");

    const buttonArea =
        document.getElementById("buttonArea");

    const successScreen =
        document.getElementById("successScreen");

    const form =
        document.getElementById("productForm");


    /* ==========================================
       CURRENT TAB
    ========================================== */

    let currentTab = 0;

    const totalTabs = tabs.length;


    /* ==========================================
       SHOW TAB FUNCTION
    ========================================== */

    function showTab(tabIndex) {

        /*
         * Make sure index is valid
         */

        if (tabIndex < 0) {
            tabIndex = 0;
        }

        if (tabIndex >= totalTabs) {
            tabIndex = totalTabs - 1;
        }


        /*
         * Save current tab
         */

        currentTab = tabIndex;


        /*
         * Remove active class
         * from all tabs
         */

        tabs.forEach(function (tab) {

            tab.classList.remove("active");

        });


        /*
         * Remove active class
         * from all content
         */

        tabContents.forEach(function (content) {

            content.classList.remove("active");

        });


        /*
         * Activate current tab
         */

        tabs[currentTab].classList.add("active");

        tabContents[currentTab]
            .classList.add("active");


        /*
         * Previous button
         */

        if (currentTab === 0) {

            prevBtn.disabled = true;

        } else {

            prevBtn.disabled = false;

        }


        /*
         * Next button
         *
         * If this is the LAST tab,
         * change Next to Complete.
         */

        if (currentTab === totalTabs - 1) {

            nextBtn.innerHTML = "Complete ✓";

        } else {

            nextBtn.innerHTML = "Next &gt;";

        }

    }


    /* ==========================================
       NEXT / COMPLETE BUTTON
    ========================================== */

    nextBtn.addEventListener("click", function () {

        /*
         * If current tab is NOT the last tab,
         * move to next tab.
         */

        if (currentTab < totalTabs - 1) {

            showTab(currentTab + 1);

        }

        /*
         * Otherwise we are on the last tab.
         * Complete the form.
         */

        else {

            completeForm();

        }

    });


    /* ==========================================
       PREVIOUS BUTTON
    ========================================== */

    prevBtn.addEventListener("click", function () {

        if (currentTab > 0) {

            showTab(currentTab - 1);

        }

    });


    /* ==========================================
       TAB CLICK
    ========================================== */

    tabs.forEach(function (tab, index) {

        tab.addEventListener("click", function () {

            showTab(index);

        });

    });


    /* ==========================================
       COMPLETE FORM
    ========================================== */

    function completeForm() {

        /*
         * Get all form data
         */

        const formData = new FormData(form);


        /*
         * Create an object
         */

        const data = {};

        formData.forEach(function (value, key) {

            data[key] = value;

        });


        /*
         * Display data in browser console
         */

        console.log("FORM DATA:");

        console.log(data);


        /*
         * You can send data to your backend here.
         *
         * Example:
         *
         * fetch("save.php", {
         *     method: "POST",
         *     body: formData
         * });
         */


        /*
         * Hide all tab content
         */

        tabContents.forEach(function (content) {

            content.classList.remove("active");

        });


        /*
         * Hide tabs
         */

        document.getElementById("tabs")
            .style.display = "none";


        /*
         * Hide buttons
         */

        buttonArea.style.display = "none";


        /*
         * Show success screen
         */

        successScreen.classList.add("show");

    }


    /* ==========================================
       INITIALIZE
    ========================================== */

    showTab(0);

</script>

