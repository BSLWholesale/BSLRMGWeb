            background: none;
            border: none;
            color: white;
            font-size: 28px;
            cursor: pointer;
        }

        /* Body */
        .popup-body {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        /* Footer */
        .popup-footer {
            height: 70px;
            padding: 0 20px;
            border-top: 1px solid #ddd;
            background: #f8f8f8;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-shrink: 0;
        }


        /* Mobile */
        @@media (max-width: 500px) {
            .popup {
                width: 100%;
                right: -100%;
            }
        }
    </style>
