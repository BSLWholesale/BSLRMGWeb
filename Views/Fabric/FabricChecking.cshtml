    <style>
    /* ==============================
           TABS
        ============================== */

        .tabs {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
            overflow-x: auto;
        }

        .tab {
            border: none;
            outline: none;
            background: transparent;
            padding: 16px 25px;
            border-radius: 12px;
            color: #263247;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: 0.25s ease;
        }

        .tab:hover {
            background: #edf1ff;
        }

        .tab.active {
            color: white;

            background: linear-gradient(
                90deg,
                #1581ed,
                #2939e8
            );

            box-shadow: 0 5px 15px rgba(40, 70, 230, 0.20);
        }        

        /* ==============================
           TAB CONTENT
        ============================== */

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

       

        /* ==============================
           BUTTON AREA
        ============================== */

        .button-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 45px;
        }

        /* ==============================
           BUTTONS
        ============================== */

        .btn {
            height: 55px;
            border: none;
            border-radius: 12px;
            padding: 0 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.25s ease;
        }

        /* PREVIOUS */

        .btn-prev {
            min-width: 120px;
            background: transparent;
            color: #182238;
        }

        .btn-prev:hover:not(:disabled) {
            background: #eef1f6;
        }

        .btn-prev:disabled {
            opacity: 0.35;

            cursor: not-allowed;
        }

        /* NEXT */

        .btn-next {
            min-width: 260px;
            color: white;
            background: linear-gradient(
                90deg,
                #1682ed,
                #2939e8
            );

            box-shadow:
                0 5px 15px rgba(38, 72, 225, 0.20);
        }

        .btn-next:hover {
            transform: translateY(-1px);

            box-shadow:
                0 8px 20px rgba(38, 72, 225, 0.30);
        }

        .btn-next:active {
            transform: translateY(0);
        }

        /* ==============================
           SUCCESS SCREEN
        ============================== */

        .success-screen {
            display: none;
            text-align: center;
            padding: 70px 20px;
        }

        .success-screen.show {
            display: block;
        }

        .success-icon {
            width: 75px;
            height: 75px;
            margin: 0 auto 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #22b573;
            color: white;
            font-size: 40px;
            font-weight: bold;
        }

        .success-screen h2 {
            margin: 0 0 10px;
            font-size: 28px;
            color: #18243b;
        }

        .success-screen p {
            margin: 0;
            color: #707887;
            font-size: 16px;
        }

        /* ==============================
           MOBILE
        ============================== */

        @@media (max-width: 700px) {
            

            .tabs {
                gap: 5px;
            }

            .tab {
                padding: 12px 15px;

                font-size: 14px;
            }
            
            .button-area {
                margin-top: 30px;
            }

            .btn-next {
                min-width: 160px;
            }

            .btn {
                height: 50px;
                padding: 0 20px;
                font-size: 14px;
            }
        }
    </style>
}

