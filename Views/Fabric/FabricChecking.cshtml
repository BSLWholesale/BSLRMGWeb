    <style>
        /* ==============================
           TABS
        ============================== */

        .tabs {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
            overflow-x: auto;
        }

        .tab {
            border: none;
            outline: none;
            background: transparent;
            padding: 15px 25px;
            border-radius: 12px;
            color: #263247;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: 0.25s ease;
        }

            .tab:hover {
                color: white;
                /*background: linear-gradient( 90deg, #1581ed, #2939e8 );*/
                background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
            }

            .tab.active {
                color: white;
                background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
                box-shadow: 0 5px 15px rgba(114, 47, 55, 0.35);
                /*background: linear-gradient( 90deg, #1581ed, #2939e8 );
                box-shadow: 0 5px 15px rgba(40, 70, 230, 0.20);*/
            }

        /* ==============================
           TAB CONTENT
        ============================== */

        .tab-content {
            display: none;
        }

            .tab-content.active {
                display: block;
            }



        /* ==============================
           BUTTON AREA
        ============================== */

        .button-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 45px;
        }

        /* ==============================
           BUTTONS
        ============================== */


        /* PREVIOUS */

        .btn-prev {
            min-width: 120px;
            /*background: transparent;*/
            background: #eef1f6;
            color: #182238;
        }

            .btn-prev:hover:not(:disabled) {
                background: #eef1f6;
            }

            .btn-prev:disabled {
                opacity: 0.35;
                cursor: not-allowed;
            }

        /* NEXT */

        .btn-next {
            min-width: 260px;
            color: white;
            background: linear-gradient( 90deg, #1682ed, #2939e8 );
            box-shadow: 0 5px 15px rgba(38, 72, 225, 0.20);
        }

            .btn-next:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(38, 72, 225, 0.30);
            }

            .btn-next:active {
                transform: translateY(0);
            }

        /* ==============================
           MOBILE
        ============================== */

        @@media (max-width: 700px) {


            .tabs {
                gap: 5px;
            }

            .tab {
                padding: 12px 15px;
                font-size: 14px;
            }

            .button-area {
                margin-top: 30px;
            }

            .btn-next {
                min-width: 160px;
            }
        }
    </style>

    /* start for popup style css */
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        /* Popup */
        .popup {
            position: fixed;
            top: 0;
            right: -450px;
            width: 450px;
            height: 100vh;
            /*height: 550px;*/
            background: #fff;
            box-shadow: -4px 0 15px rgba(0, 0, 0, 0.2);
            transition: right 0.3s ease;
            z-index: 1012;
            /* Header + body + footer */
            display: flex;
            flex-direction: column;
        }

            .popup.active {
                right: 0;
            }

        /* Header */
        .popup-header {
            height: 50px;
            padding: 0 20px;
            background-image: linear-gradient(to bottom, #722F37, #DB5A6A);
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

