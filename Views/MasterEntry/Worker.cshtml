        function Fn_Mandatory_Fields() {

            var EmpUser = $("#ddlEmpUser").val();

            // Remove all previously added * symbols
            $(".required-star").remove();

            // Common mandatory fields for every role
            var mandatoryFields = [
                "txtCode",
                "txtName",
                "ddlEmpDesignation",
                "ddlEmpUser"
            ];

            // Supervisor mandatory fields
            if (EmpUser == "Supervisor") {

                mandatoryFields = mandatoryFields.concat([
                    "ddlUnit",
                    "ddlGrouping",
                    "ddlProductSection",
                    "ddlSection",
                    "txtMobile",
                    "txtAddress",
                    "ddlGender",
                    "txtShift",
                    "txtPin",
                    "ddlPayRoll",
                    "txtDOJ",
                    "txtDOB"
                ]);
            }

            // Operator and QC mandatory fields
            else if (EmpUser == "Operator" || EmpUser == "QC") {

                mandatoryFields = mandatoryFields.concat([
                    "ddlUnit",
                    "ddlGrouping",
                    "ddlProductSection",
                    "ddlSection",
                    "ddlSubSection",
                    "txtMobile",
                    "txtAddress",
                    "txtMainOperation",
                    "txtMainOpCapHr",
                    "ddlGender",
                    "txtShift",
                    "txtPin",
                    "ddlPayRoll",
                    "txtDOJ",
                    "txtDOB",
                    "ddlCategory"
                ]);
            }

            // Display * beside mandatory field labels
            $.each(mandatoryFields, function (index, fieldId) {

                $("#" + fieldId)
                    .closest(".form-group")
                    .find("label")
                    .first()
                    .append(' <span class="required-star" style="color:red;">*</span>');

            });
        }


        function Fn_Insert_New_Worker() {

            var clsWorker = {};

            var strMSG = "";

            if ($("#btnSubmit").val() == "Submit") {
                strMSG = "Worker details added successfully";
            }

            // Validate mandatory fields according to Employee User
            if (!Fn_Validate_Worker()) {
                return false;
            }

            clsWorker.Code = $("#txtCode").val().trim();
            clsWorker.Name = $("#txtName").val().trim();
            clsWorker.EmpDesignation = $("#ddlEmpDesignation").val();
            clsWorker.EmpUser = $("#ddlEmpUser").val();
            clsWorker.Unit = $("#ddlUnit").val();
            clsWorker.Grouping = $("#ddlGrouping").val();
            clsWorker.ProductSection = $("#ddlProductSection").val();
            clsWorker.Section = $("#ddlSection").val();
            clsWorker.SubSection = $("#ddlSubSection").val();
            clsWorker.Mobile = $("#txtMobile").val().trim();
            clsWorker.Address = $("#txtAddress").val().trim();
            clsWorker.NativeAddress = $("#txtNativeAddress").val().trim();
            clsWorker.MainOperation = $("#txtMainOperation").val().trim();
            clsWorker.MainOpCapHr = $("#txtMainOpCapHr").val().trim();
            clsWorker.SecondOperation = $("#txtSecondOperation").val().trim();
            clsWorker.SecondOpCapHr = $("#txtSecondOpCapHr").val().trim();
            clsWorker.ThirdOperation = $("#txtThirdOperation").val().trim();
            clsWorker.ThirdOpCapHr = $("#txtThirdOpCapHr").val().trim();
            clsWorker.FourthOperation = $("#txtFourthOperation").val().trim();
            clsWorker.FourthOpCapHr = $("#txtFourthOpCapHr").val().trim();
            clsWorker.FifthOperation = $("#txtFifthOperation").val().trim();
            clsWorker.FifthOpCapHr = $("#txtFifthOpCapHr").val().trim();
            clsWorker.SixthOperation = $("#txtSixthOperation").val().trim();
            clsWorker.SixthOpCapHr = $("#txtSixthOpCapHr").val().trim();
            clsWorker.SeventhOperation = $("#txtSeventhOperation").val().trim();
            clsWorker.SeventhOpCapHr = $("#txtSeventhOpCapHr").val().trim();
            clsWorker.Gender = $("#ddlGender").val();
            clsWorker.Shift = $("#txtShift").val().trim();
            clsWorker.Pin = $("#txtPin").val().trim();
            clsWorker.PayRoll = $("#ddlPayRoll").val();
            clsWorker.DOJ = $("#txtDOJ").val().trim();
            clsWorker.DOB = $("#txtDOB").val().trim();
            clsWorker.Category = $("#ddlCategory").val();

            // Validate uploaded image
            var vfileImageUpload = document.getElementById("fileImageUpload");

            if (vfileImageUpload.files.length > 0) {

                var fileName = vfileImageUpload.files[0].name;
                var fileExtension = fileName.split(".").pop().toLowerCase();

                //if (fileExtension !== "jpeg") {
                //    Swal.fire({ title: "", text: "Only .jpeg image files are allowed", icon: "error" });
                //    return false;
                //}
            }

            clsWorker.CreatedBy = sessionStorage.getItem("LogInID");

            var formdata = new FormData();

            formdata.append("Code", clsWorker.Code);
            formdata.append("Name", clsWorker.Name);
            formdata.append("EmpDesignation", clsWorker.EmpDesignation);
            formdata.append("EmpUser", clsWorker.EmpUser);
            formdata.append("Unit", clsWorker.Unit);
            formdata.append("Grouping", clsWorker.Grouping);
            formdata.append("ProductSection", clsWorker.ProductSection);
            formdata.append("Section", clsWorker.Section);
            formdata.append("SubSection", clsWorker.SubSection);
            formdata.append("Mobile", clsWorker.Mobile);
            formdata.append("Address", clsWorker.Address);
            formdata.append("NativeAddress", clsWorker.NativeAddress);
            formdata.append("MainOperation", clsWorker.MainOperation);
            formdata.append("MainOpCapHr", clsWorker.MainOpCapHr);
            formdata.append("SecondOperation", clsWorker.SecondOperation);
            formdata.append("SecondOpCapHr", clsWorker.SecondOpCapHr);
            formdata.append("ThirdOperation", clsWorker.ThirdOperation);
            formdata.append("ThirdOpCapHr", clsWorker.ThirdOpCapHr);
            formdata.append("FourthOperation", clsWorker.FourthOperation);
            formdata.append("FourthOpCapHr", clsWorker.FourthOpCapHr);
            formdata.append("FifthOperation", clsWorker.FifthOperation);
            formdata.append("FifthOpCapHr", clsWorker.FifthOpCapHr);
            formdata.append("SixthOperation", clsWorker.SixthOperation);
            formdata.append("SixthOpCapHr", clsWorker.SixthOpCapHr);
            formdata.append("SeventhOperation", clsWorker.SeventhOperation);
            formdata.append("SeventhOpCapHr", clsWorker.SeventhOpCapHr);
            formdata.append("Gender", clsWorker.Gender);
            formdata.append("Shift", clsWorker.Shift);
            formdata.append("Pin", clsWorker.Pin);
            formdata.append("PayRoll", clsWorker.PayRoll);
            formdata.append("DOJ", clsWorker.DOJ);
            formdata.append("DOB", clsWorker.DOB);
            formdata.append("Category", clsWorker.Category);
            formdata.append("CreatedBy", clsWorker.CreatedBy);

            // Append uploaded image
            for (var i = 0; i < vfileImageUpload.files.length; i++) {
                clsWorker.EmpImageFile = vfileImageUpload.files[i].name;
                formdata.append("EmpImageFile", vfileImageUpload.files[i]);
            }

            // AJAX request
            $.ajax({
                type: "POST",
                url: "/MasterEntry/Fn_Insert_New_Worker",
                contentType: false,
                processData: false,
                data: formdata,
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj.vErrorMsg == "Success") {
                        Swal.fire({ title: "", text: strMSG, icon: "success" });
                        Fn_Reset_Control();
                        $("#btnSubmit").val("Submit");
                    }
                    else {
                        Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                    }
                },
                error: function (err) {
                    Swal.fire({ title: "", text: "An error occurred while saving worker details.", icon: "error" });
                }
            });

            return false;
        }


