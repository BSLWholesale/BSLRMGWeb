        function Fn_Get_Worker(id, edit) {

            var clsWorker = {};
            clsWorker.CreatedBy = sessionStorage.getItem("LogInID");
            if (edit == "Yes") {
                clsWorker.ID = id;
            }
            if ($("#txtSearch").val() != "") {
                clsWorker.Code = $("#txtSearch").val();
            }

            $("#dvWorkerRow").html('');
            var html = '';

            $.ajax({
                type: "POST",
                url: "/MasterEntry/Fn_Get_Worker",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsWorker),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        if (edit == "Yes") {
                            $("#hdnID").val(obj[0].ID);
                            $("#txtCode").val(obj[0].Code);
                            $("#txtName").val(obj[0].Name);
                            $("#txtFatherName").val(obj[0].FatherName);
                            $("#ddlGender").val(obj[0].Gender);
                            $("#txtGrade").val(obj[0].Grade);
                            $("#txtShift").val(obj[0].Shift);
                            $("#txtPin").val(obj[0].Pin);
                            $("#ddlOperatorType").val(obj[0].OperatorType);
                            if (obj[0].OperatorType == "Operator" || obj[0].OperatorType == "Supervisor") {
                                $("#txtLineName").val(obj[0].LineName);
                                $("#dvLineName").show();
                            }
                            else {
                                $("#dvLineName").hide();
                            }
                            $("#txtMobile").val(obj[0].Mobile);
                            $("#txtContractor").val(obj[0].Contractor);
                            $("#ddlPayRoll").val(obj[0].PayRoll);

                            if (obj[0].IsTrainee == true) {
                                $("#chkIsTrainee").prop('checked', true);
                            } else {
                                $("#chkIsTrainee").prop('checked', false);
                            }


                            if (obj[0].IsTemporary == true) {
                                $("#chkIsTemporary").prop('checked', true);
                            } else {
                                $("#chkIsTemporary").prop('checked', false);
                            }


                            $("#txtPermanentSection").val(obj[0].PermanentSection);
                            // $("#txtDOJ").val(obj[0].DOJ);

                            $("#dvAddWorker").show();
                            $("#dvViewWorker").hide();
                        }
                        else {
                            for (var i = 0; i < obj.length; i++) {
                                html += "<div class='col-sm-3'>";
                                html += "<div class='card'>";
                                html += "<div class='card-header' style='border-bottom: 1px solid #797979; margin-bottom: 5px'>";
                                html += "<span style='font-weight: 800;'>" + obj[i].Code + "</span>";
                                html += "</div>";
                                html += "<div class='card-body'>";
                                html += "<table>";
                                html += "<tr>";
                                html += "<tr><td>Name :" + obj[i].Name + "</td></tr>";
                                html += "<tr><td>Father :" + obj[i].FatherName + "</td></tr>";
                                html += "<tr><td>Grade :" + obj[i].Grade + "</td></tr>";
                                html += "<tr><td>Shift :" + obj[i].Shift + "</td></tr>";
                                html += "<tr><td>Type :" + obj[i].OperatorType + "</td></tr>";
                                html += "<tr><td>Section :" + obj[i].PermanentSection + "</td></tr>";
                                html += "<tr><td>Pin :" + obj[i].Pin + "</td></tr>";
                                html += "<tr><td>Mobile :" + obj[i].Mobile + "</td></tr>";
                                html += "<tr><td>PayRoll :" + obj[i].PayRoll + "</td></tr>";
                                // html += "<td>" + obj[i].DOJ + "</td>";
                                html += "</table>";
                                html += "</div>";
                                html += "<div class='card-footer' style='border-top: 1px solid #797979; margin-top: 5px'>";
                                html += "<table style='margin-top: 5px'>";
                                html += "<tr><td colspan='2'>";
                                html += "<a href='javascript: void (0);' class='btn btn-xs btn-info'><i class='fa fa-edit' onclick='Fn_Edit_Worker(" + obj[i].ID + ")'></i></a>";
