        function Fn_Make_Worker_QRCode(id) {

            var clsWorker = {};
            clsWorker.CreatedBy = sessionStorage.getItem("LogInID");
            clsWorker.ID = id;
            //$('#QRRow').html('');
            //var html = '';
            $.ajax({
                type: "POST",
                url: "/MasterEntry/Fn_Get_Worker",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsWorker),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        $('#qrcode-container').html('')
                        $("#spnCode").html("Code: " + obj[0].Code);
                        $("#spnName").html(obj[0].Name);
                        $("#spnFather").html(obj[0].FatherName);
                        $("#spnGrade").html("Grade: " + obj[0].Grade);
                        $("#spnShift").html("Shift: " + obj[0].Shift);
                        $("#spnType").html("Type: " + obj[0].OperatorType);

                        var text = "Login-" + obj[0].Pin;

                        var qrcode = new QRCode(document.getElementById("qrcode-container"), {
                            width: 150,
                            height: 150,
                            margin: 2
                        });
                        qrcode.makeCode(text);

                    }
                    else {
                        html += "<h4 class='text-center'>" + obj[0].vErrorMsg + "</h4>";
                    }
                    /* $('#QRRow').append(html);*/
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });
                }
            });
        }

        function printSingleQR(divId) {
            var printContents = document.getElementById(divId).innerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = printContents;

            window.print();

            document.body.innerHTML = originalContents;
        }


        function Fn_Delete_Worker(Code) {
            Swal.fire({ title: "", text: 'you are not authorized.', icon: "error" });
        }


        function Fn_OnChange_ddlOperatorType() {
            var ddlOperatorType = $("#ddlOperatorType").val();
            if (ddlOperatorType == "Operator" || ddlOperatorType == "Supervisor") {
                $("#dvLineName").show();
            }
            else {
                $("#dvLineName").hide();
            }
        }


        function Fn_NavigateToAddWorker() {

            var AddWorker = $("#btnAddWorker").val();
            AddWorker = window.location.replace("@Url.Action("Worker", "MasterEntry")");
            return true;

        }


        function Fn_NavigateToEditWorker(Code) {

            window.location.href = "/MasterEntry/EditWorkerDetails?EID=" + Code;

        }


    </script>


