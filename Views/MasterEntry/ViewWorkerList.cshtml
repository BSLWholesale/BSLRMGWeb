        function Fn_Get_Worker() {

            var clsWorker = {};
            clsWorker.CreatedBy = sessionStorage.getItem("LogInID");

            if ($("#txtSearch").val() != "") {
                clsWorker.Code = $("#txtSearch").val();
            }

            var html = '';
            $("#dvWorkerRow").html('');
            
            $.ajax({
                type: "POST",
                url: "/MasterEntry/Fn_Get_Worker",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsWorker),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        for (var i = 0; i < obj.length; i++) {
                            html += "<div class='col-sm-3'>";
                            html += "<div class='card'>";
                            html += "<div class='card-header' style='border-bottom: 1px solid #797979; margin-bottom: 5px'>";
                            html += "<span style='font-weight: 800;'>" + obj[i].Code + "</span>";
                            html += "</div>";
                            html += "<div class='card-body'>";
                            html += "<table>";
                            html += "<tr>";
                            html += "<tr><td>Name :" + obj[i].Name + "</td></tr>";
                            html += "<tr><td>Grade :" + obj[i].Grade + "</td></tr>";
                            html += "<tr><td>Shift :" + obj[i].Shift + "</td></tr>";
                            html += "<tr><td>Type :" + obj[i].OperatorType + "</td></tr>";
                            html += "<tr><td>Pin :" + obj[i].Pin + "</td></tr>";
                            html += "<tr><td>Mobile :" + obj[i].Mobile + "</td></tr>";
                            html += "<tr><td>PayRoll :" + obj[i].PayRoll + "</td></tr>";
                            html += "</table>";
                            html += "</div>";
                            html += "<div class='card-footer' style='border-top: 1px solid #797979; margin-top: 5px'>";
                            html += "<table style='margin-top: 5px'>";
                            html += "<tr><td colspan='2'>";
                            html += "<a href='javascript: void (0);' class='btn btn-xs btn-info'><i class='fa fa-edit' onclick='Fn_NavigateToEditWorker(" + obj[i].Code + ")'></i></a>";
                            html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-danger disable'><i class='fa fa-trash' onclick=\"Fn_Delete_Worker('" + obj[i].Code + "')\"></i></a>";
                            html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs btn-primary'><i class='fa fa-qrcode' onclick='Fn_Make_Worker_QRCode(" + obj[i].Code + ")' data-toggle='modal' data-target='#SeasonModal'></i></a>";
                            html += "</td></tr></table>";
                            html += "</div>";
                            html += "</div>";
                            html += "</div>";
                        }
                    }
                    else {
                        //html += "<h4 class='text-center'>" + obj[0].vErrorMsg + "</h4>";
                        html += "<h4 class='text-center'>No Worker records found</h4>";
                    }
                    $("#dvWorkerRow").append(html);
                },
                error: function (err) {
                    /*Swal.fire({ title: "", text: err, icon: "error" });*/
                    alert(err);
                }
            });
        }

