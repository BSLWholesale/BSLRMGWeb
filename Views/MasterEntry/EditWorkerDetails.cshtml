        $(document).ready(function () {

            $("#divEditWorker").show();
            $("#divWorkerAttendance").hide();

            const urlParams = new URLSearchParams(window.location.search);
            const EmpID = urlParams.get('EID');
            if (EmpID != null || EmpID != "") {
                Fn_Fetch_WorkerDetails_ByID(EmpID);
            }

            $("#txtDOJ").datepicker({
                dateFormat: "dd-M-yy"
            });

            $("#txtDOJ").datepicker("setDate", new Date());

            // Edit Worker button click
            $("#btnEditWorker").click(function () {

                $("#divEditWorker").show();
                $("#divWorkerAttendance").hide();

                // Optional active class
                $("#btnEditWorker").addClass("active");
                $("#btnWorkerAttendance").removeClass("active");

            });


            // Worker Attendance button click
            $("#btnWorkerAttendance").click(function () {

                $("#divEditWorker").hide();
                $("#divWorkerAttendance").show();

                // Optional active class
                $("#btnWorkerAttendance").addClass("active");
                $("#btnEditWorker").removeClass("active");

            });

            //Fn_Fill_AttendanceMonthYear();


            const date = new Date();
            const yyyy = date.getFullYear();
            const monthNames = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
                "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

            let dd = date.getDate();
            if (dd < 10) dd = '0' + dd;

            const mmm = monthNames[date.getMonth()];

            const dateformat = dd + '-' + mmm + '-' + yyyy;
            $("#txtAttendDate").val(dateformat);

        });


