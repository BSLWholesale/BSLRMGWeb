    <script type="text/javascript">

        $(function () {
            $("#fileImageUpload").on('change', function (event) {
                const file = event.target.files[0];
                if (!file) return;

                const FileAllowedTypes = ['image/jpeg'];
                const FileMaxSize = 2 * 1024 * 1024;

                if (!FileAllowedTypes.includes(file.type)) {
                    Swal.fire({ title: "", text: "Only JPEG files are allowed.", icon: "error" });
                    event.target.value = '';
                    return;
                }

                if (file.size > FileMaxSize) {
                    Swal.fire({ title: "", text: "File Size must be less than or equal to 2 MB.", icon: "error" });
                    event.target.value = '';
                    return;
                }

                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const bytes = new Uint8Array(e.target.result);

                        if (file.type === 'image/jpeg') {
                            const isJPG = bytes[0] === 0xFF && bytes[1] === 0xD8 && bytes[bytes.length - 2] === 0xFF && bytes[bytes.length - 1] === 0xD9;
                            if (!isJPG) {
                                Swal.fire({ title: "", text: "Invalid JPEG image file.", icon: "error" });
                                event.target.value = '';
                                return;
                            }
                        }

                    };
                    reader.readAsArrayBuffer(file);
                }
            });
        });

    </script>

