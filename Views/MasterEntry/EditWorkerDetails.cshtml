                url: "/MasterEntry/Fn_Fetch_WorkerDetails_ByID",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsWorker),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj.vErrorMsg == "Success") {

                        $("#txtCode").val(obj.Code);
                        $("#txtCode").attr("readonly", true);
                        $("#txtName").val(obj.Name);

                        Fn_SetDropdownValue("ddlEmpDesignation", obj.EmpDesignation);

                        if (obj.EmpUser == null || obj.EmpUser == "") {
                            $("#ddlEmpUser option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlEmpUser").val(obj.EmpUser);
                        }

                        Fn_SetDropdownValue("ddlUnit", obj.Unit);
                        Fn_SetDropdownValue("ddlGrouping", obj.Grouping);
                        Fn_SetDropdownValue("ddlProductSection", obj.ProductSection);
                        Fn_SetDropdownValue("ddlSection", obj.Section);
