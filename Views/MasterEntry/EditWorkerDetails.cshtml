        function Fn_Mandatory_Fields() {

            var EmpUser = $("#ddlEmpUser").val();

            // Remove all previously added * symbols
            $(".required-star").remove();

            // Common mandatory fields for every role
            var mandatoryFields = [
                "txtCode",
                "txtName",
                "ddlEmpDesignation",
                "ddlEmpUser"
            ];

            // Supervisor mandatory fields
            if (EmpUser == "Supervisor") {

                mandatoryFields = mandatoryFields.concat([
                    "ddlUnit",
                    "ddlGrouping",
                    "ddlProductSection",
                    "ddlSection",
                    "txtMobile",
                    "txtAddress",
                    "ddlGender",
                    "txtShift",
                    "txtPin",
                    "ddlPayRoll",
                    "txtDOJ",
                    "txtDOB"
                ]);
            }

            // Operator and QC mandatory fields
            else if (EmpUser == "Operator" || EmpUser == "QC") {

                mandatoryFields = mandatoryFields.concat([
                    "ddlUnit",
                    "ddlGrouping",
                    "ddlProductSection",
                    "ddlSection",
                    "ddlSubSection",
                    "txtMobile",
                    "txtAddress",
                    "txtMainOperation",
                    "txtMainOpCapHr",
                    "ddlGender",
                    "txtShift",
                    "txtPin",
                    "ddlPayRoll",
                    "txtDOJ",
                    "txtDOB",
                    "ddlCategory"
                ]);
            }

            // Display * beside mandatory field labels
            $.each(mandatoryFields, function (index, fieldId) {

                $("#" + fieldId)
                    .closest(".form-group")
                    .find("label")
                    .first()
                    .append(' <span class="required-star" style="color:red;">*</span>');

            });
        }


        function Fn_SetDropdownValue(ddlId, value) {

            var $dropdown = $("#" + ddlId);

            // Null or empty values select the default option.
            if (value == null || String(value).trim() === "") {
                $dropdown.val("0");
                return;
            }

            var savedValue = String(value).trim();

            // Match against the options already loaded.
            var matchedValue = $dropdown.find("option").filter(function () {
                return String(this.value).trim() === savedValue;
            }).first().val();

            if (matchedValue !== undefined) {
                $dropdown.val(matchedValue);
            }
            else {
                // Log any database value that is missing from the list.
                console.warn("Saved value does not exist in dropdown:", ddlId, savedValue);
                $dropdown.val("0");
            }
        }


