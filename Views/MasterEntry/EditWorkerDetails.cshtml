        function Fn_Fetch_WorkerDetails_ByID(EmpID) {

            var clsWorker = {};
            clsWorker.Code = EmpID;

            $.ajax({
                type: "POST",
                url: "/MasterEntry/Fn_Fetch_WorkerDetails_ByID",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsWorker),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj.vErrorMsg == "Success") {
                        $("#txtCode").val(obj.Code);
                        $("#txtCode").attr("readonly", true);
                        $("#txtName").val(obj.Name);

                        if (obj.EmpDesignation == null || obj.EmpDesignation == "") {
                            $("#ddlEmpDesignation option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlEmpDesignation").val(obj.EmpDesignation);
                        }

                        if (obj.EmpUser == null || obj.EmpUser == "") {
                            $("#ddlEmpUser option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlEmpUser").val(obj.EmpUser);
                        }

                        if (obj.Unit == null || obj.Unit == "") {
                            $("#ddlUnit option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlUnit").val(obj.Unit);
                        }

                        if (obj.Grouping == null || obj.Grouping == "") {
                            $("#ddlGrouping option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlGrouping").val(obj.Grouping);
                        }

                        if (obj.ProductSection == null || obj.ProductSection == "") {
                            $("#ddlProductSection option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlProductSection").val(obj.ProductSection);
                        }

                        if (obj.Section == null || obj.Section == "") {
                            $("#ddlSection option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlSection").val(obj.Section);
                        }

                        if (obj.SubSection == null || obj.SubSection == "") {
                            $("#ddlSubSection option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlSubSection").val(obj.SubSection);
                        }

                        $("#txtMobile").val(obj.Mobile);
                        $("#txtAddress").val(obj.Address);
                        $("#txtNativeAddress").val(obj.NativeAddress);
                        $("#txtMainOperation").val(obj.MainOperation);
                        $("#txtMainOpCapHr").val(obj.MainOpCapHr);
                        $("#txtSecondOperation").val(obj.SecondOperation);
                        $("#txtSecondOpCapHr").val(obj.SecondOpCapHr);
                        $("#txtThirdOperation").val(obj.ThirdOperation);
                        $("#txtThirdOpCapHr").val(obj.ThirdOpCapHr);
                        $("#txtFourthOperation").val(obj.FourthOperation);
                        $("#txtFourthOpCapHr").val(obj.FourthOpCapHr);
                        $("#txtFifthOperation").val(obj.FifthOperation);
                        $("#txtFifthOpCapHr").val(obj.FifthOpCapHr);
                        $("#txtSixthOperation").val(obj.SixthOperation);
                        $("#txtSixthOpCapHr").val(obj.SixthOpCapHr);
                        $("#txtSeventhOperation").val(obj.SeventhOperation);
                        $("#txtSeventhOpCapHr").val(obj.SeventhOpCapHr);

                        if (obj.Gender == null || obj.Gender == "") {
                            $("#ddlGender option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlGender").val(obj.Gender);
                        }

                        $("#txtShift").val(obj.Shift);
                        $("#txtPin").val(obj.Pin);

                        if (obj.PayRoll == null || obj.PayRoll == "") {
                            $("#ddlPayRoll option:first").prop('selected', true);
                        }
                        else {
                            $("#ddlPayRoll").val(obj.PayRoll);
                        }

                        $("#txtDOJ").val(obj.DOJ);

                        if (obj.IsActive) {
                            $("#ActiveStatus").prop('checked', true);
                            $("#InactiveStatus").prop('checked', false);
                        }
                        else {
                            $("#ActiveStatus").prop('checked', false);
                            $("#InactiveStatus").prop('checked', true);
                        }

                        $("#divEmpImg").html('');
                        var imgPath = "/DamanEmpImages/" + obj.Code + ".jpeg?t=" + new Date().getTime() + "";
                        var html = "<img src='" + imgPath + "' class='img-responsive' alt='" + obj.Code + "' style=width:20%; height:height:20%; />";
                        $("#divEmpImg").append(html);

                        //$("#fileImageUpload").val(obj.EmpImageFile);
                    }
                },
                error: function (err) {
                    alert(err);
                }
