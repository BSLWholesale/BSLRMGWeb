        function printSingleQR(divId) {
            var printContents = document.getElementById(divId).innerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = printContents;

            window.print();

            document.body.innerHTML = originalContents;
        }


        function Fn_WorkerEmpCode() {

            var clsWorker = {};
            var workercode = $('#txtCode').val();
            var workerno = /^[0-9\s]*$/;

            if (workercode.match(workerno)) {
                clsWorker.vErrorMsg = "";
                return true;
            }
            else {
                clsWorker.vErrorMsg = "Please Enter only Numbers.";
                Swal.fire({ title: "Worker", text: clsWorker.vErrorMsg, icon: "error" });
                $("#txtCode").val('');
                $("#txtCode").focus();
                return false;
            }
        }


        function Fn_ValidateCheckZeroOnly() {

            let value = document.getElementById("txtCode").value.trim();

            if (/^0+$/.test(value)) {
                Swal.fire({ title: "Worker", text: "Only zero values are not allowed", icon: "error" });
                $("#txtCode").val('');
                $("#txtCode").focus();
            }
            else {
                $("#txtCode").html("");
            }
        }


        function Fn_ValidateWorkerMobileNumber() {
            var clsWorker = {};
            var mobileno = $("#txtMobile").val();
            var mobregex = /^\d{10}$/;
            if (mobileno.match(mobregex)) {
                clsWorker.vErrorMsg = "";
                return true;
            }
            else {
                clsWorker.vErrorMsg = "Invalid Mobile Number format";
                swal("Worker", clsWorker.vErrorMsg, "error");
                $("#txtMobile").val('');
                $("#txtMobile").focus();
                return false;
            }
        }


        function Fn_Fill_AttendanceMonthYear() {

            var clsWorker = {};

            const urlParams = new URLSearchParams(window.location.search);
            const EmpID = urlParams.get('EID');
            clsWorker.Code = EmpID;

            $.ajax({
                type: "POST",
                url: "/MasterEntry/Fn_Fill_AttendanceMonthYear",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsWorker),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    var ddlMonth = '<option value="0">--Select Month--</option>';
                    var ddlYear = '<option value="0">--Select Year--</option>';
                    for (var i = 0; i < obj.length; i++) {
                        ddlMonth += '<option value="' + obj[i].MonthNumber + '">' + obj[i].MonthName + '</option>';
                        ddlYear += '<option value="' + obj[i].YearValue + '">' + obj[i].YearValue + '</option>';
                    }
                    $("#ddlMonth").append(ddlMonth);
                    $("#ddlYear").append(ddlYear);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }


        function Fn_Fetch_AttendanceDetailsByID() {

            var clsWorker = {};
            
            const urlParams = new URLSearchParams(window.location.search);
            const EmpID = urlParams.get('EID');

            var MonthYear = $("#txtMonthYear").val();

            var splitpart = MonthYear.split('-');

            clsWorker.Code = EmpID;
            clsWorker.MonthNumber = parseInt(splitpart[1], 10);
            clsWorker.YearValue = parseInt(splitpart[0], 10);
            
            var html = '';
            $("#tbody").html("");

            $.ajax({
                type: "POST",
                url: "/MasterEntry/Fn_Fetch_AttendanceDetailsByID",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsWorker),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        for (var i = 0; i < obj.length; i++) {
                            html += "<tr>";
                            html += "<td>" + obj[i].AttendenceDate + "</td>";
                            html += "<td>" + obj[i].StartTime + "</td>";
                            html += "<td>" + obj[i].EndTime + "</td>";
                            html += "<td>" + obj[i].OTNoOfHrs + "</td>";
                            html += "<td>" + obj[i].DayName + "</td>";
                            //html += "<td>" + obj[i].Code + "</td>";
                            //html += "<td>" + obj[i].AttendanceStatus + "</td>";                            
                            //html += "<td>" + obj[i].IsOvertime + "</td>";
                            //html += "<td>" + obj[i].Unit + "</td>";
                            html += "</tr>";
                        }
                    }
                    else {
                        html += "<tr><td colspan='8' class='text-center'>No attedance records found</td></tr>";
                    }
                    $("#tbody").append(html);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

    </script>


    <script type="text/javascript">

        $(function () {
            $("#fileImageUpload").on('change', function (event) {
                const file = event.target.files[0];
                if (!file) return;

                const FileAllowedTypes = ['image/jpeg'];
                const FileMaxSize = 2 * 1024 * 1024;

                if (!FileAllowedTypes.includes(file.type)) {
                    Swal.fire({ title: "", text: "Only JPEG files are allowed.", icon: "error" });
                    event.target.value = '';
                    return;
                }

                if (file.size > FileMaxSize) {
                    Swal.fire({ title: "", text: "File Size must be less than or equal to 2 MB.", icon: "error" });
                    event.target.value = '';
                    return;
                }

                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const bytes = new Uint8Array(e.target.result);

                        if (file.type === 'image/jpeg') {
                            const isJPG = bytes[0] === 0xFF && bytes[1] === 0xD8 && bytes[bytes.length - 2] === 0xFF && bytes[bytes.length - 1] === 0xD9;
                            if (!isJPG) {
                                Swal.fire({ title: "", text: "Invalid JPEG image file.", icon: "error" });
                                event.target.value = '';
                                return;
                            }
                        }

                    };
                    reader.readAsArrayBuffer(file);
                }
            });
        });

    </script>

