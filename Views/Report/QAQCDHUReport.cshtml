
@{
    ViewBag.Title = "QAQCDHUReport";
}


<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<link href="~/web/css/select2.min.css" rel="stylesheet" />


<script type="text/javascript">

    $(document).ready(function () {

        Fn_Fill_DropdownList("ddlLineName", "EmployeeDetail", "LineName", "", "");

        $("#txtDate").datepicker({
            dateFormat: "dd-M-yy",
            defaultDate: new Date()
        });

    });


    function Fn_AutoComplete_Textbox(txtName, strTBLName, strFieldName) {

        var clsRequestDropdown = {};
        clsRequestDropdown.vFieldName = strFieldName;
        clsRequestDropdown.vTBLName = strTBLName;

        $("#" + txtName).autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '/Production/Fn_AutoComplete_Textbox',
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term, strTBLName: strTBLName, strFieldName: strFieldName },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        response($.map(obj, function (item) {
                            return { label: item.SearchKeyword, value: item.SearchKeyword };
                        }));
                    }
                });
            },
            select: function (event, ui) {
                var str = ui.item.value;
            }
        });
    }


    function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {

        var clsRequestDropdown = {};

        clsRequestDropdown.vFieldName = strFieldName;
        clsRequestDropdown.vValueField = strValueField;
        clsRequestDropdown.vTBLName = strTBLName;
        clsRequestDropdown.vCriteria = strCriteria;

        $("#" + ddlName).html('');
        var dropdown = ''; var dropdown1 = "";

        dropdown1 = "<option value='0'>--Select--</option>";
        $("#" + ddlName).append(dropdown1);

        $.ajax({
            type: "POST",
            url: '/Home/Fn_Fill_DropdownList',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsRequestDropdown),
            success: function (data) {
                var obj = JSON.parse(data.message);
                for (var i = 0; i < obj.length; i++) {
                    if (strValueField == "") {
                        dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                    }
                    else {
                        dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                    }

                }
                $("#" + ddlName).append(dropdown);
            },
            error: function (err) {
                alert(err);
            }
        });
    }



    function Fn_Get_QAQCDHUReport() {

        if ($("#txtDate").val() == "") {
            Swal.fire({ title: "", text: "Please Select the Date", icon: "error" });
            return;
        }
        if ($("#ddlLineName").val() == "0") {
            Swal.fire({ title: "", text: "Please Select the Line", icon: "error" });
            return;
        }

        var clsQADHUReport = {};

        if ($("#txtDate").val() != "") {
            clsQADHUReport.SelectDate = $("#txtDate").val();
        }
        if ($("#ddlLineName").val() != "0") {
            clsQADHUReport.LineName = $("#ddlLineName").val();
        }

        $("#tbody").html('');
        var html = '';        

        $.ajax({
            type: "POST",
            url: "/Report/Fn_Get_QAQCDHUReport",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsQADHUReport),
            beforeSend: function () {
                $("#loader").show();
                $("#dvMain").hide();
            },
            success: function (data) {
                var obj = JSON.parse(data.message);
                if (obj[0].vErrorMsg == "Success") {
                    for (var i = 0; i < obj.length; i++) {
                        html += "<tr>";
                        html += "<td>" + obj[i].StyleCode + "</td>";
                        html += "<td>" + obj[i].OrderNo + "</td>";
                        html += "<td>" + obj[i].ColorName + "</td>";
                        html += "<td>" + obj[i].OrderQty + "</td>";
                        html += "<td>" + obj[i].SubSection + "</td>";
                        html += "<td>" + obj[i].Reject + "</td>";
                        html += "<td>" + obj[i].Repair + "</td>";
                        html += "<td>" + obj[i].Altered + "</td>";
                        html += "<td>" + obj[i].Defectives + "</td>";
                        html += "<td>" + obj[i].Pass + "</td>";
                        html += "<td>" + obj[i].TotalChecked + "</td>";
                        html += "<td>" + obj[i].FTPPercentage + "</td>";
                        html += "<td>" + obj[i].RejectPercentage + "</td>";
                        html += "<td>" + obj[i].TotalDefect + "</td>";
                        html += "<td>" + obj[i].DHUPercentage + "</td>";
                        html += "</tr>";
                    }
                }
                else {
                    html += "<tr><td colspan='12' class='text-center'>No DHU report records found.</td></tr>";
                }
                $("#tbody").append(html);
            },
            complete: function (data) {
                $("#loader").hide();
                $("#dvMain").show();
            },
            error: function (err) {
                Swal.fire({ title: "", text: err, icon: "error" });
            }
        });
    }


</script>

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">

            <div class="col-sm-12">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a></span>
                <span><a href="javascript:void(0);"><i>></i> <b>Reports</b></a></span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">DHU Report</b></a></span>
            </div>

        </div>


        <div class="row" style="margin-top: 1%;" id="dvMain">
            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">Select Date</label>
                                    <input type="text" id="txtDate" class="form-control" />
                                </div>
                            </div>

                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">Line</label>
                                    <select id="ddlLineName" class="form-control" onchange="">
                                        <option value="0">--Select Line--</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-sm-2">
                                <div class="form-inline">
                                    <div class="form-group">
                                        <button class="btn btn-success" style="margin-top: 20px;" onclick="">Search</button>
                                        <button id="btnExcel" style="margin-top: 20px;" title="Download Excel" class="btn btn-success"><i class="fa fa-download" onclick="fnExcelReport()"></i></button>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="row">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover table-responsive text-nowrap" id="tblList">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                            <th>Style</th>
                                            <th>Order No</th>
                                            <th>Color</th>
                                            <th>Qty</th>
                                            <th>Sub Section</th>
                                            <th>FTP</th>
                                            <th>Reject</th>
                                            <th>Repair</th>
                                            <th>Altered</th>
                                            <th>Defectives</th>
                                            <th>Pass</th>
                                            <th>Total Check</th>
                                            <th>FTP%</th>
                                            <th>Reject%</th>
                                            <th>Total Defect</th>
                                            <th>DHU%</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>

    </section>
</section>


<script src="~/web/js/select2.min.js"></script>
<script>

    $(function () {
        $("#ddlLineName").select2();
    });

</script>