
@{
    ViewBag.Title = "BundleStatusReport";
}

@{
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <!-- CSS CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.min.css" />

    <!-- datetimepicker jQuery CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.full.min.js"></script>


    <link href="~/web/css/select2.min.css" rel="stylesheet" />
    <script type="text/javascript">

        $(document).ready(function () {

            Fn_Fill_DropdownList("ddlOrderNo", "vPending_BundleStatus", "OrderNo", "", "");

            var strCriteria = "";
            strCriteria = " AND EmpRole = 'Operator' ";
            var strFieldName = " CONCAT(EmpName, ' (', EmpId, ')') AS EmpName ";
            Fn_Fill_DropdownList("ddlAppEmp", "EmployeeMaster", strFieldName, "EmpId", strCriteria);
            Fn_Fill_DropdownList("ddlOperator", "EmployeeMaster", strFieldName, "EmpId", strCriteria);

            $('#txtStartDatetime').datetimepicker({
                format: "d-M-Y H:m:s"
            });
            $('#txtEndDatetime').datetimepicker({
                format: "d-M-Y H:m:s"
            });

            $('#txtStartDatetime2').datetimepicker({
                format: "d-M-Y H:m:s"
            });
            $('#txtEndDatetime2').datetimepicker({
                format: "d-M-Y H:m:s"
            });

            $("#chkAll").click(function () {
                if ($(this).prop("checked")) {
                    $(".chkItem").prop("checked", true);
                } else {
                    $(".chkItem").prop("checked", false).removeClass("clschkChecked");
                    $(".chkItem").prop("checked", false).addClass("clschk");
                }
            });

            $(".chkItem").click(function () {
                if ($(".chkItem:checked").length === $(".chkItem").length) {
                    $("#chkAll").prop("checked", true);
                } else {
                    $("#chkAll").prop("checked", false);
                }
            });

        });

        var currentPage = 1;
        var isLoading = false;
        var hasMoreData = true;
        var currentTabStatus = "";
        var rCount = 0;

        function Fn_Get_Pending_BundleStatus(tabStatus, isScroll = false) {

            if (isLoading || !hasMoreData)
                return;

            currentTabStatus = tabStatus;

            var clsBundleStatusReportReq = {};
            clsBundleStatusReportReq.BundleIDStatus = tabStatus;
            clsBundleStatusReportReq.PageNumber = currentPage;
            clsBundleStatusReportReq.PageSize = 30;

            if (tabStatus == "") {
                Swal.fire({ title: "", text: "Please select any tab", icon: "error" });
                return;
            }

            if ($("#ddlStyleCode").val() != "") {
                clsBundleStatusReportReq.StyleCode = $("#ddlStyleCode").val();
            }
            if ($("#ddlOrderNo").val() != "") {
                clsBundleStatusReportReq.OrderNo = $("#ddlOrderNo").val();
            }
            if ($("#ddlOperator").val() != "0") {
                clsBundleStatusReportReq.AppEmpID = $("#ddlOperator").val();
            }
            if ($("#ddlSubSection").val() != "0") {
                clsBundleStatusReportReq.SubSection = $("#ddlSubSection").val();
            }

            // Clear only first time
            if (!isScroll) {
                $("#tbody" + tabStatus).html('');
                currentPage = 1;
                hasMoreData = true;
            }

            isLoading = true;

            $.ajax({
                type: "POST",
                url: "/Report/Fn_Get_Pending_BundleStatus",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsBundleStatusReportReq),
                beforeSend: function () {
                    $("#loader").show();
                },
                success: function (data) {

                    var obj = JSON.parse(data.message);
                    var html = "";
                    var gTotalRows = 0;
                    if (obj.length > 0 && obj[0].vErrorMsg == "Success") {

                        var bundleColors = {};
                        var colors = ["#ffcccc", "#ccffcc", "#ccccff", "#ffffcc", "#ffd9b3"];
                        var colorIndex = 0;
                        gTotalRows = obj[0].TotalRows;
                        for (var i = 0; i < obj.length; i++) {

                            var bundleId = obj[i].BundleID;

                            // Assign same color for same BundleID
                            if (!bundleColors[bundleId]) {
                                bundleColors[bundleId] = colors[colorIndex % colors.length];
                                colorIndex++;
                            }

                            var rowColor = bundleColors[bundleId];

                            var chkVal = ""; var vIsPilot = "";
                            chkVal = obj[i].BundleID + "-" + obj[i].OpNo;
                            html += "<tr style='background-color:" + rowColor + "'>";

                            if (obj[i].IsPilot == true) {
                                html += "<td><input type='checkbox' class='clschkChecked chkItem' id='chk_" + obj[i].BundleID + "' value=" + chkVal + " checked='checked' /> <a href='javascript: void(0)' onclick='Fn_Show_Update_BundleID_Popup(" + obj[i].BundleID + ", " + obj[i].OpNo + ");' >" + obj[i].BundleID + "</a></td>";
                                vIsPilot = "Yes";
                            }
                            else {
                                html += "<td><input type='checkbox' class='clschk chkItem' id='chk_" + obj[i].BundleID + "' value=" + chkVal + " /> <a href='javascript: void(0)' onclick='Fn_Show_Update_BundleID_Popup(" + obj[i].BundleID + ", " + obj[i].OpNo + ");' >" + obj[i].BundleID + "</a></td>";
                                vIsPilot = "No";
                            }

                            html += "<td>" + obj[i].OpNo + "</td>";
                            html += "<td>" + obj[i].OpName + "</td>";
                            html += "<td>" + obj[i].BundleNo + "</td>";
                            html += "<td>" + obj[i].SizeName + "</td>";
                            html += "<td>" + obj[i].ColorName + "</td>";
                            html += "<td>" + obj[i].ShadeName + "</td>";
                            html += "<td>" + obj[i].Qty + "</td>";
                            html += "<td>" + obj[i].PlyFrom + "</td>";
                            html += "<td>" + obj[i].PlyTo + "</td>";
                            html += "<td>" + obj[i].LotNo + "</td>";
                            html += "<td>" + obj[i].SubSection + "</td>";
                            html += "<td>" + obj[i].OrderNo + "</td>";
                            html += "<td>" + vIsPilot + "</td>";
                            html += "<td>Pending</td>";


                            html += "</tr>";
                            rCount++;
                        }

                        // Append data instead of replace
                        $("#tbody" + tabStatus).append(html);
                        $("#spTotalRowCount").html("Total Rows: " + rCount + " / " + gTotalRows);
                        // Next page
                        currentPage++;

                        // If less than page size => no more data
                        if (obj.length < 30) {
                            hasMoreData = false;
                        }
                    }
                    else {
                        hasMoreData = false;
                    }
                },
                complete: function () {
                    $("#loader").hide();
                    isLoading = false;
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });
                }
            });
        }


        function Fn_Get_Finished_BundleStatus(tabStatus, isScroll = false) {

            if (isLoading || !hasMoreData)
                return;

            currentTabStatus = tabStatus;

            var clsBundleStatusReportReq = {};
            clsBundleStatusReportReq.BundleIDStatus = tabStatus;
            clsBundleStatusReportReq.PageNumber = currentPage;
            clsBundleStatusReportReq.PageSize = 30;

            if (tabStatus == "") {
                Swal.fire({ title: "", text: "Please select any tab", icon: "error" });
                return;
            }


            if ($("#ddlOrderNo").val() != "") {
                clsBundleStatusReportReq.OrderNo = $("#ddlOrderNo").val();
            }
            if ($("#ddlOperator").val() != "0") {
                clsBundleStatusReportReq.AppEmpID = $("#ddlOperator").val();
            }
            if ($("#ddlSubSection").val() != "0") {
                clsBundleStatusReportReq.SubSection = $("#ddlSubSection").val();
            }

            // Clear only first time
            if (!isScroll) {
                $("#tbody" + tabStatus).html('');
                currentPage = 1;
                hasMoreData = true;
            }

            isLoading = true;

            $.ajax({
                type: "POST",
                url: "/Report/Fn_Get_Assign_Finish_BundleStatus",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsBundleStatusReportReq),
                beforeSend: function () {
                    $("#loader").show();
                },
                success: function (data) {

                    var obj = JSON.parse(data.message);
                    var html = "";
                    var gTotalRows = 0;
                    if (obj.length > 0 && obj[0].vErrorMsg == "Success") {

                        var bundleColors = {};
                        var colors = ["#ffcccc", "#ccffcc", "#ccccff", "#ffffcc", "#ffd9b3"];
                        var colorIndex = 0;
                        gTotalRows = obj[0].TotalRows;

                        for (var i = 0; i < obj.length; i++) {

                            var bundleId = obj[i].BundleID;

                            // Assign same color for same BundleID
                            if (!bundleColors[bundleId]) {
                                bundleColors[bundleId] = colors[colorIndex % colors.length];
                                colorIndex++;
                            }

                            var rowColor = bundleColors[bundleId];

                            html += "<tr style='background-color:" + rowColor + "'>";
                            html += "<td>" + obj[i].BundleID + "</td>";
                            html += "<td>" + obj[i].OpNo + "</td>";
                            html += "<td>" + obj[i].OpName + "</td>";
                            html += "<td>" + obj[i].BundleNo + "</td>";
                            html += "<td>" + obj[i].SizeName + "</td>";
                            html += "<td>" + obj[i].ColorName + "</td>";
                            html += "<td>" + obj[i].ShadeName + "</td>";
                            html += "<td>" + obj[i].Qty + "</td>";
                            html += "<td>" + obj[i].PlyFrom + "</td>";
                            html += "<td>" + obj[i].PlyTo + "</td>";
                            html += "<td>" + obj[i].LotNo + "</td>";
                            html += "<td>" + obj[i].SubSection + "</td>";
                            if (obj[i].SupervisorID == 0) {
                                html += "<td>" + obj[i].SupervisorName + "</td>";
                            }
                            else {
                                html += "<td>" + obj[i].SupervisorName + " (" + obj[i].SupervisorID + ")</td>";
                            }

                            html += "<td>" + obj[i].AssignedDate + "</td>";
                            html += "<td>" + obj[i].AppEmpID + "</td>";
                            html += "<td>" + obj[i].EmpName + "</td>";
                            html += "<td>" + obj[i].AppStartTime + "</td>";
                            if (obj[i].IsPilot == true) {
                                html += "<td>Yes</td>";
                            }
                            else {
                                html += "<td>No</td>";
                            }

                            html += "<td>" + obj[i].BundleStatus + "</td>";
                            html += "</tr>";

                            rCount++;
                        }

                        $("#tbody" + tabStatus).append(html);
                        $("#spTotalRowCount").html("Total Rows: " + rCount + " / " + gTotalRows);

                        currentPage++;

                        if (obj.length < 30) {
                            hasMoreData = false;
                        }
                    }
                    else {
                        hasMoreData = false;
                    }
                },
                complete: function () {
                    $("#loader").hide();
                    isLoading = false;
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });
                }
            });
        }


        $(window).scroll(function () {

            if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
                var tabStatus = $("#hdnStatus").val();
                if (tabStatus == "Pending") {
                    Fn_Get_Pending_BundleStatus(currentTabStatus, true);
                }
                else if (tabStatus == "Finished") {
                    Fn_Get_Finished_BundleStatus(currentTabStatus, true);
                }
                else if (tabStatus == "Assigned") {
                    Fn_Get_Assigned_BundleStatus(currentTabStatus, true);
                }
                else {

                }
            }

        });

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }


        function Fn_OnDDLOrderChange() {
            var strCriteria = "";
            strCriteria = " AND OrderNo='" + $("#ddlOrderNo").val() + "'";

            Fn_Fill_DropdownList("ddlSubSection", "BundleCompile", "SubSection", "", strCriteria);

            currentPage = 1;
            isLoading = false;
            hasMoreData = true;
            currentTabStatus = "";
            rCount = 0;
            $("#spTotalRowCount").html("Total Rows: " + rCount);
            $("#tbodyPending").html('');
            $("#tbodyFinished").html('');
        }


        function Fn_Active_Tab(evt, tabStatus) {


            currentPage = 1;
            isLoading = false;
            hasMoreData = true;
            currentTabStatus = "";
            rCount = 0;
            $("#spTotalRowCount").html("Total Rows: " + rCount);
            $("#tbodyPending").html('');
            $("#tbodyFinished").html('');

            $("#hdnStatus").val(tabStatus);

            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }
            document.getElementById(tabStatus).style.display = "block";
            evt.currentTarget.className += " active";

            if (tabStatus == "Pending") {
                Fn_Get_Pending_BundleStatus('Pending', false);
            }
            else if (tabStatus == "Finished") {
                Fn_Get_Finished_BundleStatus('Finished', false)
            }
            else if (tabStatus == "Assigned") {
                Fn_Get_Assigned_BundleStatus('Assigned', false)
            }
            else {

            }
            $(".clsbtnHide").show();
        }

        function Fn_Set_AS_Pilot() {
            const checkedValues = Array.from(
                document.querySelectorAll('.clschk:checked')
            ).map(checkbox => checkbox.value)
                .join(',');


            if (checkedValues == "" || checkedValues == null) {
                Swal.fire({ title: "", text: "Please checked for Pilot", icon: "error" });
            }
            else {
                var clsPilot = {};
                clsPilot.BundleList = checkedValues;
                clsPilot.CreatedBy = sessionStorage.getItem("LogInID");
                $.ajax({
                    type: "POST",
                    url: "/Report/Fn_Set_AS_Pilot",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsPilot),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Swal.fire({ title: "", text: "Set Pilot Successfully", icon: "success" });
                            $("#ddlOperator").select2("val", "0");
                            Fn_Active_Tab(event, 'Pending');
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }

        }

        function Fn_Show_Update_BundleID_Popup(BundleId, OpNo) {
            $("#BundleUpdateModal").modal('show');
            $("#txtBundleID").val(BundleId);
            $("#txtOPNo").val(OpNo)
            var strFieldName = " CONCAT(EmpName, ' (', EmpId, ')') AS EmpName ";
            var strCriteria = " AND EmpRole='Operator' ";
            Fn_Fill_DropdownList("ddlAppEmp", "EmployeeMaster", strFieldName, "EmpId", strCriteria);
        }

        function Fn_Update_AppEmpId() {

            var clsBundleCompile = {};
            clsBundleCompile.CreatedBy = sessionStorage.getItem("LogInID");
            clsBundleCompile.BundleID = $("#txtBundleID").val();
            clsBundleCompile.AppEmpID = $("#ddlAppEmp").val();
            clsBundleCompile.OperationNo = $("#txtOPNo").val();
            clsBundleCompile.AppStartTime = $("#txtStartDatetime").val();
            clsBundleCompile.AppEndTime = $("#txtEndDatetime").val();
            if (clsBundleCompile.BundleID == "") {
                Swal.fire({ title: "", text: "BundleID Not supplied", icon: "error" });
            }
            else if (clsBundleCompile.AppEmpID == "0") {
                Swal.fire({ title: "", text: "Please Select Employee", icon: "error" });
            }
            else if (clsBundleCompile.OperationNo == "0") {
                Swal.fire({ title: "", text: "Please Select OpNo", icon: "error" });
            }
            else if (clsBundleCompile.AppStartTime == "") {
                Swal.fire({ title: "", text: "Please Select StartDateTime", icon: "error" });
            }
            else if (clsBundleCompile.AppEndTime == "") {
                Swal.fire({ title: "", text: "Please Select EndDateTime", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: '/Production/Fn_Update_AppEmpId',
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsBundleCompile),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Swal.fire({ title: "", text: "Updated Successfully.", icon: "success" });
                            $("#txtBundleID").val("");
                            $("#ddlAppEmp").select2("val", "0");
                            $("#txtOPNo").val("");
                            $("#ddlOperator").select2("val", "0");
                            Fn_Active_Tab(event, 'Pending');
                            $("#BundleUpdateModal").modal('hide');
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });
                    }
                });
            }

        }

        //////////////////////// Multiple Manual Entry

        function Fn_Show_MultipleManualEntryModal() {
            const checkedValues = Array.from(
                document.querySelectorAll('.clschk:checked')
            ).map(checkbox => checkbox.value)
                .join('<br />');

            $("#spnBundleList").html(checkedValues);
            $("#MultipleManualEntryModal").modal('show');

            var strCriteria = "";
            strCriteria = " AND EmpRole = 'Operator' ";
            var strFieldName = " CONCAT(EmpName, ' (', EmpId, ')') AS EmpName ";
            Fn_Fill_DropdownList("ddlAppEmpName", "EmployeeMaster", strFieldName, "EmpId", strCriteria);
        }

        function Fn_Add_Multiple_Manual_Entry() {
            const checkedValues = Array.from(
                document.querySelectorAll('.clschk:checked')
            ).map(checkbox => checkbox.value)
                .join(',');

            var clsManualEntry = {};
            clsManualEntry.BundleList = checkedValues;
            clsManualEntry.CreatedBy = sessionStorage.getItem("LogInID");
            clsManualEntry.AppEmpID = $("#ddlAppEmpName").val();
            clsManualEntry.AppStartTime = $("#txtStartDatetime2").val();
            clsManualEntry.AppEndTime = $("#txtEndDatetime2").val();

            if (checkedValues == "" || checkedValues == null) {
                Swal.fire({ title: "", text: "Please checked for manual entry", icon: "error" });
            }
            else if ($("#ddlAppEmpName").val() == "0") {
                Swal.fire({ title: "", text: "Please select EmpName", icon: "error" });
            }
            else if (clsManualEntry.AppStartTime == "") {
                Swal.fire({ title: "", text: "Please Select StartDateTime", icon: "error" });
            }
            else if (clsManualEntry.AppEndTime == "") {
                Swal.fire({ title: "", text: "Please Select EndDateTime", icon: "error" });
            }
            else {
               
                $.ajax({
                    type: "POST",
                    url: "/Report/Fn_Add_Multiple_Manual_Entry",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsManualEntry),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            $("#ddlAppEmpName").select2("val", "0");
                            $("#txtStartDatetime2").val("");
                            $("#txtEndDatetime2").val("");
                            Swal.fire({ title: "", text: "Manual Entry Added Successfully", icon: "success" });
                            $("#MultipleManualEntryModal").modal('hide');
                            Fn_Active_Tab(event, 'Pending');
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            }

        }

    </script>

    <style>

        .highlight {
            background-color: #ffeaa7;
            transition: background-color 0.3s ease;
        }

        /* Style the tab */
        .tab {
            overflow: hidden;
            border: 1px solid #ccc;
            background-color: #f1f1f1;
        }

            /* Style the buttons that are used to open the tab content */
            .tab button {
                background-color: inherit;
                float: left;
                border: none;
                outline: none;
                cursor: pointer;
                /* padding: 14px 16px;*/
                padding: 8px 16px;
                transition: 0.3s;
            }

                /* Change background color of buttons on hover */
                .tab button:hover {
                    background-color: #ddd;
                }

                /* Create an active/current tablink class */
                .tab button.active {
                    background-color: #ccc;
                }

        /* Style the tab content */
        .tabcontent {
            display: none;
            padding: 6px 12px;
            border: 1px solid #ccc;
            border-top: none;
        }
    </style>

}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-12">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b>Reports</b></a></span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Bundle Status Report</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>
                <span class="pull-right" id="spTotalRowCount" style="color: black; font-weight: 800;"></span>
            </div>
        </div>

        <div class="row" style="margin-top: 1%;" id="dvMain">
            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">OrderNo</label>
                                    <select id="ddlOrderNo" class="form-control" onchange="Fn_OnDDLOrderChange();">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">SubSection</label>
                                    <select id="ddlSubSection" class="form-control">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>
