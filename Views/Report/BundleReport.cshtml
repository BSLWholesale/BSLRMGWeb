
@{
    ViewBag.Title = "BundleReport";
}

@{
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            Fn_AutoComplete_Textbox("txtStyleCode", "OrderMaster", "StyleCode");


            $('#txtStyleCode').focusout(function () {
                var strCriteria = " AND StyleCode ='" + $("#txtStyleCode").val() + "'";
                var strFieldName = " CONCAT(OrderNo, ' (', Qty, ')') AS OrderQty "
                Fn_Fill_DropdownList("ddlOrderNo", "OrderMaster", strFieldName, "ID", strCriteria);
            });


        });

        function Fn_AutoComplete_Textbox(txtName, strTBLName, strFieldName) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vTBLName = strTBLName;

            $("#" + txtName).autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Production/Fn_AutoComplete_Textbox',
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term, strTBLName: strTBLName, strFieldName: strFieldName },
                        success: function (data) {
                            var obj = JSON.parse(data.message);
                            response($.map(obj, function (item) {
                                return { label: item.SearchKeyword, value: item.SearchKeyword };
                            }));
                        }
                    });
                },
                select: function (event, ui) {
                    var str = ui.item.value;
                }
            });
        }

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

        function Fn_Get_Bundle_Report() {

            if ($("#ddlOrderNo").val() == "0") {
                Swal.fire({ title: "", text: "Please Select Order.", icon: "error" });
                return;
            }

            var str = $("#ddlOrderNo option:selected").text();
            var arr = str.split("(");
            var OrderNo = arr[0].trim();
            var qty = arr[1];
            qty = qty.substring(0, qty.length - 1);

            var clsBundleCompile = {};
            clsBundleCompile.CreatedBy = sessionStorage.getItem("LogInID");
            clsBundleCompile.StyleCode = $("#txtStyleCode").val();

            clsBundleCompile.PlyFrom = $("#txtLayFrom").val();
            clsBundleCompile.PlyTo = $("#txtLayTo").val();
            if ($("#ddlSubSection").val() != "0") {
                clsBundleCompile.SubSection = $("#ddlSubSection option:selected").text();
            }
            if ($("#ddlOrderNo").val() != "0") {
                clsBundleCompile.OrderNo = OrderNo;
            }
            if ($("#ddlSize").val() != "0") {
                clsBundleCompile.SizeName = $("#ddlSize option:selected").text();
            }

            $("#dvtbl").html('');
            var html = '';
            var rCount = 0;
            $.ajax({
                type: "POST",
                url: "/Report/Fn_Get_Bundle_Report",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsBundleCompile),
                beforeSend: function () {
                    $("#loader").show();
                    $("#dvMain").hide();
                },
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        var prevSizeName = ""; var totalQty = 0; var sizewise_totalQty = 0; var prevLayNo = "";
                        html += "<table class='table table-striped table-responsive-sm' id='tblReport'>";
                        for (var i = 0; i < obj.length; i++) {

                            if (i == 0) {

                                html += "<tr>";
                                html += "<th></th><th></th><th></th><th></th>";
                                html += "<th style='color: black; font-weight: 800;'>BundleList</th>";
                                html += "<th></th><th></th><th></th><th></th>";
                                html += "</tr>";

                                html += "<tr>";
                                html += "<th style='color: black; font-weight: 800;'>OrderNo</th>";
                                html += "<th style='color: black; font-weight: 800;'>" + obj[i].OrderNo + "</th>";
                                html += "<th></th><th></th>";
                                html += "<th style='color: black; font-weight: 800;'>Style</th>";
                                html += "<th style='color: black; font-weight: 800;'>" + obj[i].StyleCode + "</th>";
                                html += "<th></th><th></th><th></th>";
                                html += "</tr>";

                                html += "<tr>";
                                html += "<th style='color: black; font-weight: 800;'>Lay No</th>";
                                html += "<th style='color: black; font-weight: 800;'>" + obj[i].LayID + "</th>";
                                html += "<th></th><th></th>";
                                html += "<th style='color: black; font-weight: 800;'>Order Qty</th>";
                                html += "<th style='color: black; font-weight: 800;'>" + qty + "</th>";
                                html += "<th></th><th></th><th></th>";
                                html += "</tr>";

                                html += "<tr style='background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;'>";
                                html += "<th>BundleNo</th>";
                                html += "<th>Size</th>";
                                html += "<th>Color</th>";
                                html += "<th>Shade</th>";
                                html += "<th>Qty</th>";
                                html += "<th>PlyFrom</th>";
                                html += "<th>PlyTo</th>";
                                html += "<th>LotNo</th>";
                                html += "<th>SubSection</th>";
                                html += "</tr>";
                            }

                            if (prevLayNo != obj[i].LayID && i != 0) {

                                if (prevSizeName != obj[i].SizeName && i != 0) {

                                    html += "<tr style='border: 2px solid #ddd;'>";
                                    html += "<th style='color: black; font-weight: 800;'>Total Qty:</th>";
                                    html += "<th></th><th></th><th></th>";
                                    html += "<th style='color: black; font-weight: 800;'>" + sizewise_totalQty + "</th>";
                                    html += "<th></th><th></th><th></th><th></th>";
                                    html += "</tr>";
                                    sizewise_totalQty = 0;
                                }


                                html += "<tr style='border: 2px solid #ddd;'>";
                                html += "<td style='color: black; font-weight: 800;'>Lay No</td>";
                                html += "<td style='color: black; font-weight: 800;'>" + obj[i].LayID + "</td>";
                                html += "<td></td><td></td><td></td><td></td><td></td><td></td><td></td>";
                                html += "</tr>";

                                html += "<tr style='background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;'>";
                                html += "<th>BundleNo</th>";
                                html += "<th>Size</th>";
                                html += "<th>Color</th>";
                                html += "<th>Shade</th>";
                                html += "<th>Qty</th>";
                                html += "<th>PlyFrom</th>";
                                html += "<th>PlyTo</th>";
                                html += "<th>LotNo</th>";
                                html += "<th>SubSection</th>";
                                html += "</tr>";

                                html += "<tr>";
                                html += "<td>" + obj[i].BundleNo + "<a/></td>";
                                html += "<td>" + obj[i].SizeName + "</td>";
                                html += "<td>" + obj[i].ColorName + "</td>";
                                html += "<td>" + obj[i].ShadeName + "</td>";
                                html += "<td>" + obj[i].Qty + "</td>";
                                html += "<td>" + obj[i].PlyFrom + "</td>";
                                html += "<td>" + obj[i].PlyTo + "</td>";
                                html += "<td>" + obj[i].LotNo + "</td>";
                                html += "<td>" + obj[i].SubSection + "</td>";
                                html += "</tr>";

                                totalQty = totalQty + obj[i].Qty;
                                sizewise_totalQty = sizewise_totalQty + obj[i].Qty;

                            }
                            else {
                                if (prevSizeName != obj[i].SizeName && i != 0) {

                                    html += "<tr style='border: 2px solid #ddd;'>";
                                    html += "<th style='color: black; font-weight: 800;'>Total Qty:</th>";
                                    html += "<th></th><th></th><th></th>";
                                    html += "<th style='color: black; font-weight: 800;'>" + sizewise_totalQty + "</th>";
                                    html += "<th></th><th></th><th></th><th></th>";
                                    html += "</tr>";
                                    sizewise_totalQty = 0;

                                    html += "<tr>";
                                    html += "<td>" + obj[i].BundleNo + "<a/></td>";
                                    html += "<td>" + obj[i].SizeName + "</td>";
                                    html += "<td>" + obj[i].ColorName + "</td>";
                                    html += "<td>" + obj[i].ShadeName + "</td>";
                                    html += "<td>" + obj[i].Qty + "</td>";
                                    html += "<td>" + obj[i].PlyFrom + "</td>";
                                    html += "<td>" + obj[i].PlyTo + "</td>";
                                    html += "<td>" + obj[i].LotNo + "</td>";
                                    html += "<td>" + obj[i].SubSection + "</td>";
                                    html += "</tr>";

                                    totalQty = totalQty + obj[i].Qty;
                                    sizewise_totalQty = sizewise_totalQty + obj[i].Qty;
                                }
                                else {
                                    html += "<tr>";
                                    html += "<td>" + obj[i].BundleNo + "<a/></td>";
                                    html += "<td>" + obj[i].SizeName + "</td>";
                                    html += "<td>" + obj[i].ColorName + "</td>";
                                    html += "<td>" + obj[i].ShadeName + "</td>";
                                    html += "<td>" + obj[i].Qty + "</td>";
                                    html += "<td>" + obj[i].PlyFrom + "</td>";
                                    html += "<td>" + obj[i].PlyTo + "</td>";
                                    html += "<td>" + obj[i].LotNo + "</td>";
                                    html += "<td>" + obj[i].SubSection + "</td>";
                                    html += "</tr>";

                                    totalQty = totalQty + obj[i].Qty;
                                    sizewise_totalQty = sizewise_totalQty + obj[i].Qty;

                                }
                            }
                            prevLayNo = obj[i].LayID;
                            prevSizeName = obj[i].SizeName;

                            rCount++;
                        }
                        html += "<tr style='border: 2px solid #ddd;'>";
                        html += "<th style='color: black; font-weight: 800;'>Total Qty:</th>";
                        html += "<th></th><th></th><th></th>";
                        html += "<th style='color: black; font-weight: 800;'>" + sizewise_totalQty + "</th>";
                        html += "<th></th><th></th><th></th><th></th>";
                        html += "</tr>";

                        html += "<tr style='border: 2px solid #ddd;'>";
                        html += "<th style='color: black; font-weight: 800;'>Grand Total</th>";
                        html += "<th></th><th></th><th></th>";
                        html += "<th style='color: black; font-weight: 800;'>" + totalQty + "</th>";
                        html += "<th></th><th></th><th></th><th></th>";
                        html += "</tr>";
                        html += "<table>";
                        $("#spTotalRowCount").html("Total Record : " + rCount);
                        $("#btnExcel").show();
                    }
                    else {
                        html += "<p class='text-center'>" + obj[0].vErrorMsg + "</p>";
                        $("#btnExcel").hide();
                    }
                    $("#dvtbl").prepend(html);
                },
                complete: function (data) {
                    $("#loader").hide();
                    $("#dvMain").show();
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });

                }
            });
        }

        function Fn_OnDDLChange() {
            var strCriteria = "";
            strCriteria = " AND StyleCode='" + $("#txtStyleCode").val() + "'"
            Fn_Fill_DropdownList("ddlSubSection", "BundleCompile", "SubSection", "", strCriteria);
            Fn_Fill_DropdownList("ddlSize", "BundleCompile", "SizeName", "", strCriteria);
            Fn_Get_Bundle_Report();
        }

        function fnExcelReport() {

            var str = $("#ddlOrderNo option:selected").text();
            var arr = str.split("(");
            var OrderNo = arr[0].trim();
            var strFileName = OrderNo + "-BundleList";

            var tab = document.getElementById('tblReport');
            var tab_text = "<table border='2px'>";

            for (var j = 0; j < tab.rows.length; j++) {
                tab_text += "<tr>";

                var cells = tab.rows[j].cells;

                for (var i = 0; i < cells.length; i++) {

                    var cellValue = cells[i].innerText.trim();
                    var tagName = cells[i].tagName.toLowerCase();

                    if (tagName === "th") {
                        tab_text += "<th bgcolor='#87AFC6'>" + cellValue + "</th>";
                    }
                    else if (i === 0) {
                        tab_text += "<td style=\"mso-number-format:'0';\">" + cellValue + "</td>";
                    }
                    else {
                        tab_text += "<td>" + cellValue + "</td>";
                    }
                }

                tab_text += "</tr>";
            }

            tab_text += "</table>";

            tab_text = tab_text.replace(/<A[^>]*>|<\/A>/g, "");
            tab_text = tab_text.replace(/<img[^>]*>/gi, "");
            tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

            var ua = window.navigator.userAgent;
            var msie = ua.indexOf("MSIE ");

            if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {
                txtArea1.document.open("txt/html", "replace");
                txtArea1.document.write(tab_text);
                txtArea1.document.close();
                txtArea1.focus();
                sa = txtArea1.document.execCommand("SaveAs", true, "report.xls");
            } else {
                var fileName = strFileName;  //"MyReport.xls"; // change dynamically if needed

                var blob = new Blob([tab_text], {
                    type: "application/vnd.ms-excel"
                });

                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = fileName;

                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }

            return sa;
        }


    </script>

}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-12">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b>Reports</b></a></span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Bundle-Reports</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>

                <span class="pull-right" id="spTotalRowCount" style="color: black; font-weight: 800;"></span>
            </div>

        </div>

        <div class="row" style="margin-top: 1%;" id="dvMain">
            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="form-label">Style</label>
                                    <input type="text" id="txtStyleCode" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="form-label">OrderNo</label>
                                    <select id="ddlOrderNo" class="form-control" onchange="Fn_OnDDLChange();">
                                        <option value="0">--Select OrderNo</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="form-label">Section</label>
                                    <select id="ddlSubSection" class="form-control" onchange="Fn_Get_Bundle_Report();">
                                        <option value="0">--Select Setion</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="form-label">Size</label>
                                    <select id="ddlSize" class="form-control" onchange="Fn_Get_Bundle_Report();">
                                        <option value="0">--Select Size</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label">Lay</label>
                                <div class="form-inline">
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="txtLayFrom" placeholder="L-From" style="width: 80px;" />
                                        <input type="text" class="form-control" id="txtLayTo" placeholder="L-To" style="width: 80px;" />
                                        <button class="btn btn-success" onclick="Fn_Get_Bundle_Report();">Search</button>
                                        <button id="btnExcel" style="display: none;" title="Download Excel" class="btn btn-success"><i class="fa fa-download" onclick="fnExcelReport()"></i></button>

                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="table-responsive" id="dvtbl">
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>

    </section>
</section>

