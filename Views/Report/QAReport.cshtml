
@{
    ViewBag.Title = "QAReport";
}

@{
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            Fn_AutoComplete_Textbox("txtOrderNo", "BundleCompile", "OrderNo");
        });

        function Fn_AutoComplete_Textbox(txtName, strTBLName, strFieldName) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vTBLName = strTBLName;

            $("#" + txtName).autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Production/Fn_AutoComplete_Textbox',
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term, strTBLName: strTBLName, strFieldName: strFieldName },
                        success: function (data) {
                            var obj = JSON.parse(data.message);
                            response($.map(obj, function (item) {
                                return { label: item.SearchKeyword, value: item.SearchKeyword };
                            }));
                        }
                    });
                },
                select: function (event, ui) {
                    var str = ui.item.value;
                }
            });
        }

        function Fn_Get_QAReport() {

            var clsQAReport = {};

            if ($("#txtOrderNo").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Order No", icon: "error" });
            }
            else {
                clsQAReport.OrderNo = $("#txtOrderNo").val();
                $("#tbody").html('');
                var html = '';
                var rCount = 0;
                $.ajax({
                    type: "POST",
                    url: "/Report/Fn_Get_QAReport",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsQAReport),
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        var totalOrderQty = 0, totalFTP = 0, totalReject = 0, totalRepair = 0, totalAltered = 0, totalPass = 0, totalSendRepair = 0;
                        if (obj[0].vErrorMsg == "Success") {
                            for (var i = 0; i < obj.length; i++) {
                                
                                html += "<tr>";
                                html += "<td>" + obj[i].OrderNo + "</td>";
                                html += "<td>" + obj[i].SizeName + "</td>";
                                html += "<td>" + obj[i].OrderQty + "</td>";
                                html += "<td>" + obj[i].ColorName + "</td>";
                                html += "<td>" + obj[i].SubSection + "</td>";
                                html += "<td>" + obj[i].FTP + "</td>";
                                html += "<td>" + obj[i].Reject + "</td>";
                                html += "<td>" + obj[i].Repair + "</td>";
                                html += "<td>" + obj[i].Altered + "</td>";
                                html += "<td>" + obj[i].Pass + "</td>";
                                html += "<td class='text-center'>" + obj[i].SendRepair + "</td>";
                                html += "</tr>";
                                rCount
                                totalOrderQty = totalOrderQty + parseInt(obj[i].OrderQty);
                                totalFTP = totalFTP + parseInt(obj[i].FTP);
                                totalReject = totalReject + parseInt(obj[i].Reject);
                                totalRepair = totalRepair + parseInt(obj[i].Repair);
                                totalAltered = totalAltered + parseInt(obj[i].Altered);
                                totalPass = totalPass + parseInt(obj[i].Pass);
                                totalSendRepair = totalSendRepair + parseInt(obj[i].SendRepair);
                            }
                            html += "<tr style='border: 2px solid #ddd;'>";
                            html += "<td style='color: black; font-weight: 800;'>Total</td>";
                            html += "<td></td>";
                            html += "<td style='color: black; font-weight: 800;'>" + totalOrderQty + "</td>";
                            html += "<td></td>";
                            html += "<td></td>";
                            html += "<td style='color: black; font-weight: 800;'>" + totalFTP + "</td>";
                            html += "<td style='color: black; font-weight: 800;'>" + totalReject + "</td>";
                            html += "<td style='color: black; font-weight: 800;'>" + totalRepair + "</td>";
                            html += "<td style='color: black; font-weight: 800;'>" + totalAltered + "</td>";
                            html += "<td style='color: black; font-weight: 800;'>" + totalPass + "</td>";
                            html += "<td style='color: black; font-weight: 800;' class='text-center'>" + totalSendRepair + "</td>";
                            html += "</tr>";
                            $("#spTotalRowCount").html("Total Record : " + rCount);
                        }
                        else {
                            html += "<tr>";
                            html += "<td colspan='11' class='text-center'>" + obj[0].vErrorMsg + "</td>";
                            html += "<tr>";
                        }
                        $("#tbody").prepend(html);
                    },
                    complete: function (data) {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });

                    }
                });
            }
        }


    </script>

}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-12">
                <span><a href="@Url.Action(" Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b>Reports</b></a></span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">QA Reports</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>

                <span class="pull-right" id="spTotalRowCount" style="color: black; font-weight: 800;"></span>
            </div>

        </div>

        <div class="row" style="margin-top: 1%;" id="dvMain">
            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="form-label">OrderNo</label>
                                    <input type="text" id="txtOrderNo" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-inline">
                                    <div class="form-group">
                                        <button class="btn btn-success" style="margin-top: 20px;" onclick="Fn_Get_QAReport();">Search</button>

                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover table-responsive text-nowrap" id="tblList">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">
                                            <th>OrderNo</th>
                                            <th>SizeName</th>
                                            <th>OrderQty</th>
                                            <th>ColorName</th>
                                            <th>SubSection</th>
                                            <th>FTP</th>
                                            <th>Reject</th>
                                            <th>Repair</th>
                                            <th>Alter</th>
                                            <th>Pass</th>
                                            <th>SendRepair</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>

    </section>
</section>



