        ////////////////////////////

        $(window).scroll(function () {

            if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
                var rbReportType = $("input[name='ReportType']:checked").val();
                if (rbReportType == "Detail") {
                    Fn_Get_Piece_Rate_Report_Detail(true);
                }
                else if (rbReportType == "Summary") {
                    Fn_Get_Piece_Rate_Report_Summary(true);
                }
                else if (rbReportType == "Incentive") {
                    Fn_Get_Peice_Rate_Incentive(true);
                }
                else {

                }
            }

        });

        function Fn_Show_Data() {
            var rbReportType = $("input[name='ReportType']:checked").val();

            if (rbReportType == "Detail") {
                hasMoreData = true;
                Fn_Get_Piece_Rate_Report_Detail(false);
            }
            else if (rbReportType == "Summary") {
                hasMoreData = true;
                Fn_Get_Piece_Rate_Report_Summary(false);
            }
            else if (rbReportType == "Incentive") {
                hasMoreIncentiveData = true;
                Fn_Get_Peice_Rate_Incentive(false);
            }
            else {
                hasMoreData = true;
                Fn_Get_Piece_Rate_Report_Detail(false);
            }
        }

    </script>



}

