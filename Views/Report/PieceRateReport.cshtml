
@{
    ViewBag.Title = "Piece Rate Report";
}

@{
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <link href="~/web/css/select2.min.css" rel="stylesheet" />
    <script type="text/javascript">

        $(document).ready(function () {

            Fn_AutoComplete_Textbox("txtStyleCode", "vPieceRateReport", "StyleCode");

            var strFieldName = " CONCAT(EmpName, ' (', Code, ')') AS EmpName ";
            Fn_Fill_DropdownList("ddlAppEmp", "vPieceRateReport", strFieldName, "Code", "");
            Fn_Fill_DropdownList("ddlLineName", "vPieceRateReport", "LineName", "", "");


            $("#txtFromDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());
            $("#txtToDate").datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            }).datepicker("setDate", new Date());
        });

        function Fn_AutoComplete_Textbox(txtName, strTBLName, strFieldName) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vTBLName = strTBLName;

            $("#" + txtName).autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Production/Fn_AutoComplete_Textbox',
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term, strTBLName: strTBLName, strFieldName: strFieldName },
                        success: function (data) {
                            var obj = JSON.parse(data.message);
                            response($.map(obj, function (item) {
                                return { label: item.SearchKeyword, value: item.SearchKeyword };
                            }));
                        }
                    });
                },
                select: function (event, ui) {
                    var str = ui.item.value;
                }
            });
        }

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

        var currentPage = 1;
        var pageSize = 30;
        var isLoading = false;
        var hasMoreData = true;
        var rCount = 0;
        var TotalEarning = 0;
        var TotalEmpCount = 0;

        function Fn_Get_Piece_Rate_Report_Detail(isScroll = false) {

            if (isLoading || !hasMoreData)
                return;

            // New search
            if (!isScroll) {
                currentPage = 1;
                hasMoreData = true;
                rCount = 0;
                TotalEarning = 0;
                TotalEmpCount = 0;

                $("#tbodyDetail").empty();
                $("#spTotalRowCount").html("Total Record : 0");
            }

            var clsPieceRateReportReq = {};

            clsPieceRateReportReq.PageNumber = currentPage;
            clsPieceRateReportReq.PageSize = pageSize;
            var rbVal = $("input[name='rb']:checked").val();
            clsPieceRateReportReq.OrderBy = rbVal;

            if ($("#txtStyleCode").val() != "") {
                clsPieceRateReportReq.StyleCode = $("#txtStyleCode").val();
            }
            if ($("#ddlAppEmp").val() != "0") {
                clsPieceRateReportReq.Code = $("#ddlAppEmp").val();
            }
            if ($("#ddlLineName").val() != "0") {
                clsPieceRateReportReq.LineName = $("#ddlLineName").val();
            }
            if ($("#txtFromDate").val() != "") {
                clsPieceRateReportReq.StartDate = $("#txtFromDate").val();
            }
            if ($("#txtToDate").val() != "") {
                clsPieceRateReportReq.EndDate = $("#txtToDate").val();
            }

            isLoading = true;

            $.ajax({
                type: "POST",
                url: "/Report/Fn_Get_Piece_Rate_Report",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsPieceRateReportReq),
                beforeSend: function () {
                    $("#loader").show();
                },
                success: function (data) {

                    var obj = JSON.parse(data.message);
                    var totalRows = 0;

                    if (obj.length > 0 && obj[0].vErrorMsg === "Success") {

                        var html = "";
                        var totalQty = 0;
                        var prevQty = 0;
                        var prevAmt = 0;
                        var prevCode = "";

                        totalRows = obj[0].TotalRows;
                        var TotalEarning = Number(obj[0].TotalAmount || 0);
                        var TotalEmpCount = Number(obj[0].TotalEmp || 0);

                        for (var i = 0; i < obj.length; i++) {

                            var qty = Number(obj[i].Qty || 0);
                            var rate = Number(obj[i].Rate || 0);
                            var amount = qty * rate;

                            if (i === 0) {
                                prevCode = obj[i].Code;
                            }

                            // Group changed -> Print previous group total
                            if (prevCode !== obj[i].Code) {

                                html += "<tr style='background-color:#d4edda;'>";
                                html += "<th style='color: black; font-weight: 800;'>Total</th>";
                                html += "<th></th><th></th><th></th><th></th><th></th><th></th><th></th><th></th>";
                                html += "<th style='color: black; font-weight: 800;'>" + prevQty + "</th>";
                                html += "<th></th>";
                                html += "<th style='color: black; font-weight: 800;'>" + prevAmt.toFixed(2) + "</th>";
                                html += "<th></th>";
                                html += "</tr>";

                                prevQty = 0;
                                prevAmt = 0;
                                prevCode = obj[i].Code;
                            }

                            // Update totals
                            totalQty += qty;
                            prevQty += qty;
                            prevAmt += amount;

                            // Detail row
                            html += "<tr>";
                            html += "<td>" + obj[i].LineName + "</td>";
                            html += "<td>" + obj[i].StyleCode + "</td>";
                            html += "<td>" + obj[i].OrderNo + "</td>";
                            html += "<td>" + obj[i].SubSection + "</td>";
                            html += "<td>" + obj[i].Code + "</td>";
                            html += "<td>" + obj[i].EmpName + "</td>";
                            html += "<td>" + obj[i].OpNo + "</td>";
                            html += "<td>" + obj[i].OpName + "</td>";
                            html += "<td>" + obj[i].WorkDate + "</td>";
                            html += "<td>" + qty + "</td>";
                            html += "<td>" + rate.toFixed(2) + "</td>";
                            html += "<td>" + amount.toFixed(2) + "</td>";
                            html += "<td>" + (obj[i].UpdateType === "System" ? "QR Code" : "Manual") + "</td>";
                            html += "</tr>";

                            rCount++;
                        }

                        // Last group total
                        html += "<tr style='background-color:#d4edda;'>";
                        html += "<th style='color: black; font-weight: 800;'>Total</th>";
                        html += "<th></th><th></th><th></th><th></th><th></th><th></th><th></th><th></th>";
                        html += "<th style='color: black; font-weight: 800;'>" + prevQty + "</th>";
                        html += "<th></th>";
                        html += "<th style='color: black; font-weight: 800;'>" + prevAmt.toFixed(2) + "</th>";
                        html += "<th></th>";
                        html += "</tr>";

                        // Grand Total
                        html += "<tr style='background-color:#fff3cd;'>";
                        html += "<th style='color: black; font-weight: 800;'>Grand Total</th>";
                        html += "<th></th><th></th><th></th><th></th><th></th><th></th><th></th><th></th>";
                        html += "<th style='color: black; font-weight: 800;'>" + totalQty + "</th>";
                        html += "<th></th>";
                        html += "<th style='color: black; font-weight: 800;'>" + TotalEarning.toFixed(2) + "</th>";
                        html += "<th></th>";
                        html += "</tr>";

                        $("#tbodyDetail").append(html);

                        $("#txtTotalAmount").val(TotalEarning.toFixed(2));
                        $("#txtOperatorCount").val(TotalEmpCount);
                        $("#spTotalRowCount").html("Total Record : " + rCount + " / " + totalRows);

                        $("#dvRow").show();
                        $("#dvFileDownload").show();

                        $("#tblSummary").hide();
                        $("#tblIncentive").hide();
                        $("#tblDetail").show();

                        currentPage++;

                        if (obj.length < pageSize) {
                            hasMoreData = false;
                        }

                    } else {

                        hasMoreData = false;
                        $("#txtTotalAmount").val("");
                        $("#txtOperatorCount").val("");
                        $("#spTotalRowCount").html("Total Record : 0");
                        Swal.fire({ title: "Error", text: obj[0].vErrorMsg, icon: "error" });
                    }
                },
                complete: function () {
                    $("#loader").hide();
                    isLoading = false;
                },
                error: function (xhr, status, error) {

                    $("#loader").hide();
                    isLoading = false;
                    Swal.fire({ title: "Error", text: error, icon: "error" });
                }
            });
        }

        function Fn_Get_Piece_Rate_Report_Summary(isScroll = false) {

            if (isLoading || !hasMoreData)
                return;

            if (!isScroll) {
                currentPage = 1;
                hasMoreData = true;
                rCount = 0;
                TotalEarning = 0;
                TotalEmpCount = 0;

                $("#tbodySummary").empty();
            }

            var clsPieceRateReportReq = {};

            clsPieceRateReportReq.PageNumber = currentPage;
            clsPieceRateReportReq.PageSize = pageSize;
            clsPieceRateReportReq.OrderBy = $("input[name='rb']:checked").val();

            if ($("#txtStyleCode").val() != "") {
                clsPieceRateReportReq.StyleCode = $("#txtStyleCode").val();
            }
            if ($("#ddlAppEmp").val() != "0") {
                clsPieceRateReportReq.Code = $("#ddlAppEmp").val();
            }
            if ($("#ddlLineName").val() != "0") {
                clsPieceRateReportReq.LineName = $("#ddlLineName").val();
            }
            if ($("#txtFromDate").val() != "") {
                clsPieceRateReportReq.StartDate = $("#txtFromDate").val();
            }
            if ($("#txtToDate").val() != "") {
                clsPieceRateReportReq.EndDate = $("#txtToDate").val();
            }
            isSummaryLoading = true;

            $.ajax({
                type: "POST",
                url: "/Report/Fn_Get_Piece_Rate_Report",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsPieceRateReportReq),
                beforeSend: function () {
                    $("#loader").show();
                },
                success: function (data) {

                    var obj = JSON.parse(data.message);
                    var totalRows = 0;
                    if (obj.length > 0 && obj[0].vErrorMsg == "Success") {

                        var html = ""; var totalQty = 0;
                        totalRows = obj[0].TotalRows;
                        TotalEarning = obj[0].TotalAmount;
                        TotalEmpCount = obj[0].TotalEmp;
                        for (var i = 0; i < obj.length; i++) {

                            var amount = parseFloat(obj[i].Qty || 0) * parseFloat(obj[i].Rate || 0);
                            totalQty += parseInt(obj[i].Qty || 0);
                            html += "<tr>";
                            html += "<td>" + obj[i].LineName + "</td>";
                            html += "<td>" + obj[i].StyleCode + "</td>";
                            html += "<td>" + obj[i].OrderNo + "</td>";
                            html += "<td>" + obj[i].Code + "</td>";
                            html += "<td>" + obj[i].EmpName + "</td>";
                            html += "<td>" + obj[i].OpNo + "</td>";
                            html += "<td>" + obj[i].OpName + "</td>";
                            html += "<td>" + obj[i].Qty + "</td>";
                            html += "<td>" + obj[i].Rate + "</td>";
                            html += "<td>" + amount.toFixed(2) + "</td>";

                            if (obj[i].UpdateType == "System")
                                html += "<td>QR Code</td>";
                            else
                                html += "<td>Manual</td>";

                            html += "</tr>";

                            rCount++;
                        }

                        // Grand Total
                        html += "<tr style='background-color:#fff3cd;'>";
                        html += "<th style='color: black; font-weight: 800;'>Grand Total</th>";
                        html += "<th></th><th></th><th></th><th></th><th></th><th></th>";
                        html += "<th style='color: black; font-weight: 800;'>" + totalQty + "</th>";
                        html += "<th></th>";
                        html += "<th style='color: black; font-weight: 800;'>" + TotalEarning.toFixed(2) + "</th>";
                        html += "<th></th>";
                        html += "</tr>";

                        $("#tbodySummary").append(html);

                        $("#tblSummary").show();
                        $("#tblDetail").hide();
                        $("#tblIncentive").hide();

                        $("#txtTotalAmount").val(TotalEarning.toFixed(2));
                        $("#txtOperatorCount").val(TotalEmpCount);
                        $("#spTotalRowCount").html("Total Record : " + rCount + " / " + totalRows);

                        currentPage++;

                        if (obj.length < pageSize) {
                            hasMoreData = false;
                        }
                    }
                    else {
                        hasMoreData = false;
                        $("#txtTotalAmount").val("");
                        $("#txtOperatorCount").val("");
                        $("#spTotalRowCount").html("Total Record : 0");
                    }
                },
                complete: function () {
                    $("#loader").hide();
                    isLoading = false;
                },
                error: function (err) {
                    isLoading = false;
                    Swal.fire({ title: "", text: err.responseText, icon: "error" });
                }
            });
        }

        // download Excel function--

        function fnExcelReport() {
            var sa;
            var tab = "";
            var rbReportType = $("input[name='ReportType']:checked").val();
            var StartDate = $("#txtFromDate").val();
            var EndDate = $("#txtToDate").val();

            var colNo = 0, tdCol = 0;
            if (rbReportType == "Detail") {
                tab = document.getElementById('tblDetail');
                colNo = 13;
                tdCol = 6;
            }
            else {
                tab = document.getElementById('tblSummary');
                colNo = 11;
                tdCol = 4;
            }

            var strFileName = "Piece_Rate_" + rbReportType + "Report";

            // var tab = document.getElementById('tblReport');
            var tab_text = "<table border='2px'>";

            tab_text += "<tr>";
            tab_text += "<td colspan='" + colNo + "' style='font-weight:bold;font-size:16px;text-align:center;background:#DCE6F1;'>";
            tab_text += "Piece Rate Report";
            tab_text += "</td>";
            tab_text += "</tr>";

            // Date Row
            tab_text += "<tr>";
            tab_text += "<td style='font-weight:bold;'>From Date</td>";
            tab_text += "<td colspan='5' style='font-weight:bold;'>" + StartDate + "</td>";
            tab_text += "<td style='font-weight:bold;'>To Date</td>";
            tab_text += "<td colspan='" + tdCol + "' style='font-weight:bold;'>" + EndDate + "</td>";
            tab_text += "</tr>";

            for (var j = 0; j < tab.rows.length; j++) {
                tab_text += "<tr>";

                var cells = tab.rows[j].cells;

                for (var i = 0; i < cells.length; i++) {

                    var cellValue = cells[i].innerText.trim();
                    var tagName = cells[i].tagName.toLowerCase();

                    if (tagName === "th") {
                        tab_text += "<th bgcolor='#87AFC6'>" + cellValue + "</th>";
                    }
                    else if (i === 0) {
                        tab_text += "<td style=\"mso-number-format:'0';\">" + cellValue + "</td>";
                    }
                    else {
                        tab_text += "<td>" + cellValue + "</td>";
                    }
                }

                tab_text += "</tr>";
            }

            tab_text += "</table>";

            tab_text = tab_text.replace(/<A[^>]*>|<\/A>/g, "");
            tab_text = tab_text.replace(/<img[^>]*>/gi, "");
            tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

            var ua = window.navigator.userAgent;
            var msie = ua.indexOf("MSIE ");

            if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {
                txtArea1.document.open("txt/html", "replace");
                txtArea1.document.write(tab_text);
                txtArea1.document.close();
                txtArea1.focus();
                sa = txtArea1.document.execCommand("SaveAs", true, "report.xls");
            } else {
                var fileName = strFileName;  //"MyReport.xls"; // change dynamically if needed

                var blob = new Blob([tab_text], {
                    type: "application/vnd.ms-excel"
                });

                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = fileName;

                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }

            return sa;
        }


        var currentIncentivePage = 1;
        var incentivePageSize = 30;
        var isIncentiveLoading = false;
        var hasMoreIncentiveData = true;

        var incentiveRowCount = 0;
        var incentiveTotalEarning = 0;
        var incentiveOperatorCount = 0;

        function Fn_Get_Peice_Rate_Incentive(isScroll = false) {

            if (isIncentiveLoading || !hasMoreIncentiveData)
                return;

            if (!isScroll) {

                currentIncentivePage = 1;
                hasMoreIncentiveData = true;

                incentiveRowCount = 0;
                incentiveTotalEarning = 0;
                incentiveOperatorCount = 0;

                $("#tbodyIncentive").empty();
            }

            var clsPieceRateReportReq = {};

            clsPieceRateReportReq.PageNumber = currentIncentivePage;
            clsPieceRateReportReq.PageSize = incentivePageSize;

            clsPieceRateReportReq.OrderBy = $("input[name='rb']:checked").val();

            if ($("#txtStyleCode").val() != "") {
                clsPieceRateReportReq.StyleCode = $("#txtStyleCode").val();
            }
            if ($("#ddlAppEmp").val() != "0") {
                clsPieceRateReportReq.Code = $("#ddlAppEmp").val();
            }
            if ($("#ddlLineName").val() != "0") {
                clsPieceRateReportReq.LineName = $("#ddlLineName").val();
            }
            if ($("#txtFromDate").val() != "") {
                clsPieceRateReportReq.StartDate = $("#txtFromDate").val();
            }
            if ($("#txtToDate").val() != "") {
                clsPieceRateReportReq.EndDate = $("#txtToDate").val();
            }
            isIncentiveLoading = true;

            $.ajax({
                type: "POST",
                url: "/Report/Fn_Get_Peice_Rate_Incentive",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsPieceRateReportReq),
                beforeSend: function () {
                    $("#loader").show();
                },
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj.length > 0 && obj[0].vErrorMsg == "Success") {

                        var html = ""; var totalQty = 0;
                        for (var i = 0; i < obj.length; i++) {

                            incentiveTotalEarning += parseFloat(obj[i].TotalEarning || 0);

                            incentiveOperatorCount++;
                            incentiveRowCount++;
                            totalQty += parseInt(obj[i].TotalQty || 0);
                            html += "<tr>";
                            html += "<td>" + obj[i].Code + "</td>";
                            html += "<td>" + obj[i].EmpName + "</td>";
                            html += "<td>" + obj[i].WorkingDays + "</td>";
                            html += "<td>" + obj[i].TotalQty + "</td>";
                            html += "<td>" + obj[i].EarningPerDay + "</td>";
                            html += "<td>" + obj[i].TotalEarning + "</td>";
                            html += "</tr>";
                        }

                        $("#tbodyIncentive").append(html);
                        $("#tblIncentive").show();

                        $("#txtTotalAmount").val(incentiveTotalEarning.toFixed(2));
                        $("#txtOperatorCount").val(incentiveOperatorCount);
                        $("#spTotalRowCount").html("Total Record : " + incentiveRowCount);


                        $("#tblDetail").hide();
                        $("#tblSummary").hide();

                        $("#dvRow").show();
                        $("#dvFileDownload").show();

                        currentIncentivePage++;

                        if (obj.length < incentivePageSize) {
                            hasMoreIncentiveData = false;

                            // Final Total Row
                            $("#tbodyIncentive").append(
                                "<tr style='background-color:#fff3cd;'>" +
                                "<th style='color: black; font-weight: 800;'>Total</th>" +
                                "<th></th><th></th><th style='color: black; font-weight: 800;'>" + totalQty + "</th><th></th>" +
                                "<th style='color: black; font-weight: 800;'>" +
                                incentiveTotalEarning.toFixed(2) +
                                "</th>" +
                                "</tr>"
                            );
                        }
                    }
                    else {
                        hasMoreIncentiveData = false;
                        $("#txtTotalAmount").val("");
                        $("#txtOperatorCount").val("");
                        $("#spTotalRowCount").html("Total Record : 0");
                    }
                },
                complete: function () {

                    $("#loader").hide();
                    $("#dvMain").show();

                    isIncentiveLoading = false;
                },
                error: function (err) {
                    isIncentiveLoading = false;
                    Swal.fire({title: "", text: err.responseText, icon: "error" });
                }
            });
        }

