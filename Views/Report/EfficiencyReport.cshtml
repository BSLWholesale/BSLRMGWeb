
@{
    ViewBag.Title = "EfficiencyReport";
}

@{
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            
        });

       
        function Fn_Get_EfficiencyReport() {

            var clsEfficiencyReportReq = {};

            if ($("#ddlMonth").val() == "0") {
                Swal.fire({ title: "", text: "Please Select Month", icon: "error" });
            }
            else if ($("#ddlYear").val() == "0") {
                Swal.fire({ title: "", text: "Please Select Year", icon: "error" });
            }
            else {
                $("#tblList").html('');
                var html = '';
                clsEfficiencyReportReq.Year = $("#ddlYear").val();
                clsEfficiencyReportReq.Month = $("#ddlMonth").val();

                $.ajax({
                    type: "POST",
                    url: "/Report/Fn_Get_EfficiencyReport",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsEfficiencyReportReq),
                    beforeSend: function () {
                        $("#loader").show();
                        $("#dvMain").hide();
                    },
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj[0].vErrorMsg == "Success") {
                            // ===== Get Dynamic Column Names =====
                            var columns = Object.keys(obj[0].DynamicColumns);
                            // ===== Create Header =====
                            html += "<thead><tr style='background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;'>";
                            html += "<th>Code</th>";
                            html += "<th>Name</th>";
                            $.each(columns, function (index, colName) {

                                html += "<th>" + colName + "</th>";

                            });

                            html += "</tr><thead>";
                            html += "<tbody>";
                            // ===== Create Rows =====
                            for (var i = 0; i < obj.length; i++) {

                                html += "<tr>";
                                html += "<td>" + obj[i].Code + "</td>";
                                html += "<td>" + obj[i].EmpName + "</td>";
                                $.each(columns, function (index, colName) {

                                    //html += "<td>" + obj[i].DynamicColumns[colName] + "</td>";
                                    var value = obj[i].DynamicColumns[colName];
                                    // Check if value is numeric
                                    if (!isNaN(value) && value !== null && value !== "") {
                                        value = parseFloat(value).toFixed(2);
                                    }

                                    html += "<td>" + value + "</td>";

                                });
                                html += "</tr>";
                            }
                            html += "</tbody>";
                            $("#spTotalRowCount").html("Total Record : " + obj.length);
                            $("#btnExcel").show();
                        }
                        else {
                            html += "<p class='text-center' style='color: black; font-weight: 800;'>" + obj[0].vErrorMsg + "</p>";

                            $("#btnExcel").hide();
                        }

                        $("#tblList").html(html);
                    },

                    complete: function () {
                        $("#loader").hide();
                        $("#dvMain").show();
                    },

                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });
                    }
                });
            }
            
        }

        function fnExcelReport() {

            var ddlMonth = $("#ddlMonth option:selected").text();
            var ddlYear = $("#ddlYear").val();
            var strFileName = "EfficiencyReport-" + ddlMonth + "-" + ddlYear;

            var tab = document.getElementById('tblList');
            var tab_text = "<table border='2px'>";

            for (var j = 0; j < tab.rows.length; j++) {
                tab_text += "<tr>";

                var cells = tab.rows[j].cells;

                for (var i = 0; i < cells.length; i++) {

                    var cellValue = cells[i].innerText.trim();
                    var tagName = cells[i].tagName.toLowerCase();

                    if (tagName === "th") {
                        tab_text += "<th bgcolor='#87AFC6'>" + cellValue + "</th>";
                    }
                    else {
                        tab_text += "<td>" + cellValue + "</td>";
                    }
                }

                tab_text += "</tr>";
            }

            tab_text += "</table>";

            tab_text = tab_text.replace(/<A[^>]*>|<\/A>/g, "");
            tab_text = tab_text.replace(/<img[^>]*>/gi, "");
            tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

            var ua = window.navigator.userAgent;
            var msie = ua.indexOf("MSIE ");

            if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {
                txtArea1.document.open("txt/html", "replace");
                txtArea1.document.write(tab_text);
                txtArea1.document.close();
                txtArea1.focus();
                sa = txtArea1.document.execCommand("SaveAs", true, "report.xls");
            } else {
                var fileName = strFileName;  //"MyReport.xls"; // change dynamically if needed

                var blob = new Blob([tab_text], {
                    type: "application/vnd.ms-excel"
                });

                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = fileName;

                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }

            return sa;
        }


    </script>

}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-12">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b>Reports</b></a></span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Efficiency Reports</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>

                <span class="pull-right" id="spTotalRowCount" style="color: black; font-weight: 800;"></span>
            </div>

        </div>

        <div class="row" style="margin-top: 1%;" id="dvMain">
            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="form-label">Month</label>
                                    <select id="ddlMonth" class="form-control">
                                        <option value="0">--Select Month--</option>
                                        <option value="1">Jan</option>
                                        <option value="2">Fab</option>
                                        <option value="3">Mar</option>
                                        <option value="4">Apr</option>
                                        <option value="5">May</option>
                                        <option value="6">Jun</option>
                                        <option value="7">Jul</option>
                                        <option value="8">Aug</option>
                                        <option value="9">Sep</option>
                                        <option value="10">Oct</option>
                                        <option value="11">Nov</option>
                                        <option value="12">Dec</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="form-label">Year</label>
                                    <select id="ddlYear" class="form-control">
                                        <option value="0">--Select Year--</option>
                                        <option value="2026">2026</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-sm-2">
                                <div class="form-inline">
                                    <div class="form-group">
                                        <button class="btn btn-success" style="margin-top: 20px;" onclick="Fn_Get_EfficiencyReport();">Search</button>
                                        <button id="btnExcel" style="display: none; margin-top: 20px;" title="Download Excel" class="btn btn-success"><i class="fa fa-download" onclick="fnExcelReport()"></i></button>

                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="table-responsive" id="dvTbl">
                                <table class="table table-striped table-hover table-responsive text-nowrap" id="tblList">
                                    
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
            <img src="~/web/img/loading.gif?timestamp(~/web/ing/loading.gif)" width="8%" />
        </div>

    </section>
</section>

