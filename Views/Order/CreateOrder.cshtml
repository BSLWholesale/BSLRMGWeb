
@{
    ViewBag.Title = "CreateOrder";
}

@{

    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            const urlParams = new URLSearchParams(window.location.search);
            const style = urlParams.get('style');

            if (style != null || style != "") {
                $("#spnStyle").html("Style: " + style);

                Fn_Get_Order_Master();
            }

            $("#tbl_Source").on('click', '.btnSource', function () {
                var currentRow = $(this).closest("tr");
                var rowId = $.trim(currentRow.find("td:eq(0)").text());
                var alreadyExists = false;
                $("#tbodyDestination tr").each(function () {

                    var destinationRowId = $.trim($(this).find("td:eq(0)").text());

                    if (rowId === destinationRowId) {
                        alreadyExists = true;
                        return false;
                    }
                });

                if (alreadyExists) {
                    Swal.fire({ title: "", text: "This size is already added.", icon: "error" });
                    return;
                }

                var newRow = currentRow.clone(true);
                var size = parseFloat(currentRow.find("td:eq(1)").text()) || 0;
                var inserted = false;
                $("#tbodyDestination tr").each(function () {

                    var existingSize = parseFloat($(this).find("td:eq(1)").text()) || 0;
                    if (size < existingSize) {

                        $(this).before(newRow);
                        inserted = true;

                        return false;
                    }
                });

                if (!inserted) {
                    $("#tbodyDestination").append(newRow);
                }

                newRow.find("td i").removeClass("fa fa-shopping-cart fa-2x text-danger").addClass("fa fa-trash fa-2x text-danger");
                newRow.find("td").addClass("btnDelete");
            });

            $("#tbl_Destination").on('click', '.btnDelete', function () {
                $(this).closest('tr').remove();
            });

            Fn_AutoComplete_Textbox("txtSearchColorName", "ColorMaster", "ColorName");

        });


        /////////////////////////////////////////////////

        function Fn_AutoComplete_Textbox(txtName, strTBLName, strFieldName) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vTBLName = strTBLName;

            $("#" + txtName).autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Production/Fn_AutoComplete_Textbox',
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term, strTBLName: strTBLName, strFieldName: strFieldName },
                        success: function (data) {
                            var obj = JSON.parse(data.message);
                            response($.map(obj, function (item) {
                                return { label: item.SearchKeyword, value: item.SearchKeyword };
                            }));
                        }
                    });
                },
                select: function (event, ui) {
                    var str = ui.item.value;
                }
            });
        }

        function Fn_AddOrder_Row() {

            var now = new Date();

            var day = ("0" + now.getDate()).slice(-2);

            var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = monthNames[now.getMonth()];

            var year = now.getFullYear();
            var hours = ("0" + now.getHours()).slice(-2);
            var minutes = ("0" + now.getMinutes()).slice(-2);
            var seconds = ("0" + now.getSeconds()).slice(-2);

            // Format: DD-MMM-YYYY HH:MM:SS
            var formattedDateTime =
                day + "-" + month + "-" + year + " " +
                hours + ":" + minutes + ":" + seconds;


            var hdnRowCount = $("#hdnRowCount").val();

            var html = '';
            html += "<tr class='clstr tr_" + hdnRowCount + "'>";
            html += "<td><input type='text' id='txtOrderNo" + hdnRowCount + "' class='form-control' /></td>";
            html += "<td><input type='text' id='txtQty" + hdnRowCount + "' value='0' class='form-control qty-textbox' readonly='readonly' /></td>";
            html += "<td><input type='checkbox' id='chkFinished" + hdnRowCount + "' /></td>";
            html += "<td><input type='checkbox' id='chkStkr" + hdnRowCount + "' /></td>";
            html += "<td><input type='text' id='txtBundleQty" + hdnRowCount + "' class='form-control qty-textbox' /></td>";
            html += "<td><input type='text' id='txtOrderDate" + hdnRowCount + "' class='form-control clsOrderDate' /></td>";
            html += "<td style='padding-top: 15px;'>" + formattedDateTime + "</td>";
            html += "<td><a href='javascript: void (0);' class='btn btn-xs sharp btn-danger delete'> <i class='fa fa-trash' title='Delete Row'></i></a>";
            html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-success'> <i class='fa fa-check' title='Add Order' onclick=\"Fn_Insert_Order_Master(" + hdnRowCount + ", 'No')\"></i></a>";
            html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-warning'> <i class='fa fa-refresh fa-spin fa-fw' title='Add Size' onclick='Fn_Get_All_SizeName(" + hdnRowCount + ");'></i></a></td>";
            html += "</tr>";

            $("#tbodyOrder").prepend(html);

            $("#txtOrderDate" + hdnRowCount).datepicker({
                dateFormat: "dd-M-yy",
                defaultDate: new Date()
            });

            hdnRowCount++;
            $("#hdnRowCount").val(hdnRowCount);
            $("#tbodyOrderList").html('');
        }


        $(document).on("click", '.delete', function () {
            $(this).closest('tr').remove();
        });

        $(document).on("click", '.btnDeleteList', function () {
            $(this).closest('tr').remove();

            var hdnOrderNo = $("#hdnOrderNo").val();
            let total = 0;

            $('.clstxtQty').each(function () {
                total += parseInt($(this).val()) || 0;
            });
            $("#txtQty" + hdnOrderNo).val(total);
        });

        function Fn_Get_All_SizeName(strSearch) {

            $("#hdnOrderNo").val(strSearch);

            $('.clstr').removeClass('highlight');
            $(".tr_" + strSearch).addClass('highlight');

            const urlParams = new URLSearchParams(window.location.search);
            const gridName = urlParams.get('sz');

            var clsSizeMaster = {};
            clsSizeMaster.Grid = gridName;

            if (strSearch == 0) {

            }
            else {
                clsSizeMaster.SizeName = $("#txtSz").val();
            }


            var html = "";
            $("#tbodySize").html("");

            $.ajax({
                type: "POST",
                url: "/MasterEntry/Fn_Get_All_SizeName",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsSizeMaster),
                success: function (data) {

                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        for (var i = 0; i < obj.length; i++) {
                            html += "<tr>";
                            html += "<td>" + obj[i].ID + "</td>";
                            html += "<td>" + obj[i].SizeName + "</td>";
                            html += "<td><a href='javascript: void (0);'><i class='fa fa-shopping-cart fa-2x text-danger btnSource'></i></a></td>";
                            html += "</tr>";
                        }
                    }
                    else {
                        html += "<tr><td colspan='12' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                    }
                    $("#tbodySize").append(html);
                    $("#SizeModal").modal('show');
                },
                error: function (err) {
                    alert(err);
                }
            });
        }



        function Fn_Insert_Order_Master(rowID, strType) {

            const urlParams = new URLSearchParams(window.location.search);
            const style = urlParams.get('style');
            var strMsg = ""
            var clsOrderMaster = {};
            if (strType == "Yes") {
                clsOrderMaster.ID = rowID;
                strMsg = "Order Updated Successfully";
            }
            else {
                strMsg = "Order saved Successfully";
            }
            clsOrderMaster.StyleCode = style;
            clsOrderMaster.OrderNo = $("#txtOrderNo" + rowID).val();
            clsOrderMaster.Qty = $("#txtQty" + rowID).val();

            if ($("#chkFinished" + rowID).is(':checked')) {
                clsOrderMaster.IsFinished = true;
            } else {
                clsOrderMaster.IsFinished = false;
            }


            if ($("#chkStkr" + rowID).is(':checked')) {
                clsOrderMaster.IsStkr = true;
            } else {
                clsOrderMaster.IsStkr = false;
            }
            clsOrderMaster.BundleQty = $("#txtBundleQty" + rowID).val();
            clsOrderMaster.OrderDate = $("#txtOrderDate" + rowID).val();
            clsOrderMaster.CreatedBy = sessionStorage.getItem("LogInID");

            var clsOrderDetail = [];

            $('#tbodyOrderList tr').each(function (index, row) {

                var tds = $(row).find('td');
                var inputs = $(row).find('input[type="text"]');
                var _list = {
                    // DetailID: $(tds[0]).text().trim(),
                    Color: $(inputs[0]).val().trim(),
                    Size: $(tds[2]).text().trim(),
                    Qty: $(inputs[1]).val(),
                    ExtraQty: $(inputs[2]).val(),
                    OrderNo: $("#txtOrderNo" + rowID).val()
                };

                clsOrderDetail.push(_list);
            });

            clsOrderMaster.oDetail = clsOrderDetail;

            if (clsOrderMaster.OrderNo == "") {
                Swal.fire({ title: "", text: "Please Enter Order No", icon: "error" });
            }
            else if (clsOrderMaster.OrderDate == "") {
                Swal.fire({ title: "", text: "Please Enter Order Date", icon: "error" });
            }
            else if (clsOrderMaster.oDetail.length == 0) {
                Swal.fire({ title: "", text: "Please Make order list", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Insert_Order_Master",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOrderMaster),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Swal.fire({ title: "", text: strMsg, icon: "success" });
                            Fn_Get_Order_Master();
                            $("#tbodyOrderList").html('');
                            $("#rowBtn").hide();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });
                    }
                });
            }

        }

        function Fn_Get_Order_Master() {

            const urlParams = new URLSearchParams(window.location.search);
            const style = urlParams.get('style');

            var clsOrderMaster = {};
            clsOrderMaster.StyleCode = style;
            clsOrderMaster.CreatedBy = sessionStorage.getItem("LogInID");

            $("#tbodyOrder").html('');
            var html = "";

            $.ajax({
                type: "POST",
                url: "/Order/Fn_Get_Order_Master",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsOrderMaster),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {

                        for (var i = 0; i < obj.length; i++) {

                            var hdnRowCount = obj[i].ID;
                            html += "<tr class=' clstr tr_" + obj[i].ID + "'>";
                            html += "<td><input type='text' id='txtOrderNo" + obj[i].ID + "' value='" + obj[i].OrderNo + "' class='form-control' /></td>";
                            html += "<td><input type='text' id='txtQty" + obj[i].ID + "' value='" + obj[i].Qty + "' class='form-control qty-textbox' readonly='readonly' /></td>";
                            if (obj[i].IsFinished == true) {
                                html += "<td style='padding-top: 15px;'><input type='checkbox' id='chkFinished" + obj[i].ID + "' checked='checked' /></td>";
                            }
                            else {
                                html += "<td style='padding-top: 15px;'><input type='checkbox' id='chkFinished" + obj[i].ID + "' /></td>";
                            }

                            if (obj[i].IsStkr == true) {
                                html += "<td style='padding-top: 15px;'><input type='checkbox' id='chkStkr" + obj[i].ID + "' checked='checked' /></td>";
                            }
                            else {
                                html += "<td style='padding-top: 15px;'><input type='checkbox' id='chkStkr" + obj[i].ID + "' /></td>";
                            }


                            html += "<td><input type='text' id='txtBundleQty" + obj[i].ID + "' value='" + obj[i].BundleQty + "' class='form-control qty-textbox' /></td>";
                            html += "<td><input type='text' id='txtOrderDate" + obj[i].ID + "' value='" + obj[i].OrderDate + "' class='form-control clsOrderDate' /></td>";
                            html += "<td style='padding-top: 15px;'>" + obj[i].CreatedOn + "</td>";
                            html += "<td><a href='javascript: void (0);' class='btn btn-xs sharp btn-primary'> <i class='fa fa-eye' title='View List' onclick=\"Fn_Get_Order_Detail('" + obj[i].ID + "')\"></i></a>";
                            html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-success'> <i class='fa fa-check' title='Update List' onclick=\"Fn_Insert_Order_Master('" + obj[i].ID + "', 'Yes')\" ></i></a>";
                            html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-warning'> <i class='fa fa-refresh fa-spin fa-fw' title='Add Size' onclick='Fn_Get_All_SizeName(" + obj[i].ID + ");'></i></a></td>";
                            html += "</tr>";

                            hdnRowCount++;
                            $("#hdnRowCount").val(hdnRowCount);
                        }
                        $("#tbodyOrder").append(html);
                    }
                    else {

                    }
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });
                }
            });
        }

        function Fn_Update_OrderList() {

            var html = "";
            $('#tbodyDestination tr').each(function (index, row) {

                var tds = $(row).find('td');
                var txtColorName = $("#txtSearchColorName").val();
                if (txtColorName != "") {
                    html += "<tr>";
                    html += "<td>" + $(tds[0]).text().trim() + "</td>";
                    html += "<td>" + txtColorName + "</td>";
                    html += "<td>" + $(tds[1]).text().trim() + "</td>";
                    html += "<td><input type='text' class='clstxtQty' onkeyup='Fn_Cal_Qty();' id='txtDQty" + index + "' style='width: 80px; text-align: right;' value='' onkeypress='if (isNaN(String.fromCharCode(event.keyCode))) return false;' /></td>";
                    html += "<td><input type='text' class='clstxtQty' onkeyup='Fn_Cal_Qty();' id='txtExtraQty" + index + "' style='width: 80px; text-align: right;' value='' onkeypress='if (isNaN(String.fromCharCode(event.keyCode))) return false;' /></td>";
                    html += "<td><a href='javascript: void (0);'><i class='fa fa-trash fa-2x text-danger btnDeleteList'></i></a></td>";
                    html += "</tr>";


                }
                else {
                    Swal.fire({ title: "", text: "Please enter color name", icon: "error" });
                }
            });
            $("#tbodyOrderList").append(html);
            $("#tbl_OrderList").show();
            

            // $("#tbodyDestination").html('');
            $("#txtSearchColorName").val("");
            $("#rowBtn").show();
        }

        function Fn_Get_Order_Detail(orderNo) {

            $('.clstr').removeClass('highlight');
            $(".tr_" + orderNo).addClass('highlight');

            $("#hdnOrderNo").val(orderNo);
            var clsOrderDetail = {};
            clsOrderDetail.OrderNo = orderNo;
            clsOrderDetail.CreatedBy = sessionStorage.getItem("LogInID");

            $("#tbodyOrderList").html('');
            $("#theadOrderList").html('');

            $.ajax({
                type: "POST",
                url: "/Order/Fn_Get_Order_Detail",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsOrderDetail),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj.length > 0 && obj[0].vErrorMsg == "Success") {

                        var totalQty = 0;
                        if ($("#chkMatrixView").is(":checked")) {

                            $("#tbl_OrderList").html('');
                            var headerHtml = "";
                            var colors = [];
                            var sizes = [];
                            for (var i = 0; i < obj.length; i++) {

                                var color = $.trim(obj[i].Color);
                                var size = $.trim(obj[i].Size);
                                if (colors.indexOf(color) === -1) {
                                    colors.push(color);
                                }

                                if (sizes.indexOf(size) === -1) {
                                    sizes.push(size);
                                }

                                totalQty += Number(obj[i].Qty || 0);
                            }


                            headerHtml += "<thead>";
                            headerHtml += "<tr style='background-color:#E1C16E; background-image:linear-gradient(to bottom,#722F37,#DB5A6A); color:white;'>";
                            headerHtml += "<th rowspan='2' style='text-align:center;vertical-align:top;'>Color</th>";

                            for (var s = 0; s < sizes.length; s++) {
                                headerHtml += "<th colspan='2' style='text-align:center;vertical-align:top;'>" + sizes[s] + "</th>";
                            }

                            headerHtml += "<th rowspan='2' style='text-align:center;vertical-align:top;'>Total</th>";
                            headerHtml += "</tr>";
                            // Second Header Row
                            headerHtml += "<tr>";
                            for (var s = 0; s < sizes.length; s++) {

                                headerHtml += "<td style='text-align:center;'>Qty</td>";
                                headerHtml += "<td style='text-align:center;'>Extra Qty</td>";
                            }
                            headerHtml += "</tr>";
                            headerHtml += "</thead>";
                            $("#tbl_OrderList").html(headerHtml);

                            // CREATE BODY

                            var bodyHtml = "";
                            bodyHtml += "<tbody id='tbodyOrderList'>";

                            // COLOR LOOP
                            var GrandTotalQty = 0;
                            for (var c = 0; c < colors.length; c++) {

                                var colorName = colors[c];
                                var rowTotalQty = 0;
                                var rowQty = 0;
                                var rowExtraQty = 0;

                                bodyHtml += "<tr>";

                                // Color
                                bodyHtml += "<td style='text-align:center;font-weight:bold;'>" + colorName + "</td>";

                                for (var s = 0; s < sizes.length; s++) {

                                    var sizeName = sizes[s];
                                    var qty = 0;
                                    var extraQty = 0;

                                    // Find Color + Size
                                    for (var j = 0; j < obj.length; j++) {

                                        if ($.trim(obj[j].Color) == colorName &&
                                            $.trim(obj[j].Size) == sizeName) {

                                            qty += Number(obj[j].Qty || 0);
                                            extraQty += Number(obj[j].ExtraQty || 0);
                                        }
                                    }

                                    var totalQty = qty + extraQty;

                                    // Color-wise totals
                                    rowQty += qty;
                                    rowExtraQty += extraQty;
                                    rowTotalQty += totalQty;

                                    // Qty
                                    bodyHtml += "<td style='text-align:center;'>";
                                    bodyHtml += "<input type='text' class='clstxtQty qty-input' id='txtDQty_" + c + "_" + s + "' data-color='" + colorName + "' data-size='" + sizeName + "' value='" + qty + "' style='width:60px;text-align:right;' onkeyup='Fn_Cal_Qty();' onkeypress='return event.charCode >= 48 && event.charCode <= 57;' />";
                                    bodyHtml += "</td>";

                                    // Extra Qty
                                    bodyHtml += "<td style='text-align:center;'>";
                                    bodyHtml += "<input type='text' class='clstxtQty extraqty-input' id='txtExtraQty_" + c + "_" + s + "' data-color='" + colorName + "' data-size='" + sizeName + "' value='" + extraQty + "' style='width:60px;text-align:right;' onkeyup='Fn_Cal_Qty();' onkeypress='return event.charCode >= 48 && event.charCode <= 57;' />";
                                    bodyHtml += "</td>";
                                }

                                // Color-wise Total Qty
                                bodyHtml += "<td style='text-align:center;font-weight:bold;'>";
                                bodyHtml += "<span class='color-total-qty' data-color='" + colorName + "'>" + rowTotalQty + "</span>";
                                bodyHtml += "<br/>";
                                bodyHtml += "<small style='font-weight:normal;'>";
                                bodyHtml += "Qty: <span class='color-qty-total'>" + rowQty + "</span>";
                                bodyHtml += " | Extra: <span class='color-extra-total'>" + rowExtraQty + "</span>";
                                bodyHtml += "</small>";
                                bodyHtml += "&nbsp;&nbsp;";
                                bodyHtml += "<a href='javascript:void(0);'><i class='fa fa-trash text-danger btnDeleteList'></i></a>";
                                bodyHtml += "</td>";
                                bodyHtml += "</tr>";

                                GrandTotalQty += rowTotalQty;
                            }
                            bodyHtml += "</tbody>";
                            $("#tbl_OrderList").append(bodyHtml);
                            $("#txtQty" + orderNo).val(GrandTotalQty);
                        }
                        else {

                            var html = "";
                            html += "<thead>";
                            html += "<tr style='background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;'>";
                            html += "<th>ID</th><th>Color</th><th>Size</th><th>Qty</th><th>Extra Qty</th><th>Action</th>";
                            html += "</tr>";
                            html += "</thead>";
                            $("#tbl_OrderList").html(html);

                            html += "<tbody id='tbodyOrderList'>";
                            for (var i = 0; i < obj.length; i++) {

                                html += "<tr>";
                                html += "<td>" + obj[i].DetailID + "</td>";
                                html += "<td>" + obj[i].Color + "</td>";
                                html += "<td>" + obj[i].Size + "</td>";
                                html += "<td><input type='text' class='clstxtQty' onkeyup='Fn_Cal_Qty();' id='txtDQty" + i + "' style='width:80px;text-align:right;' value='" + obj[i].Qty + "' onkeypress='if (isNaN(String.fromCharCode(event.keyCode))) return false;' /></td>";
                                html += "<td><input type='text' class='clstxtQty' onkeyup='Fn_Cal_Qty();' id='txtExtraQty" + i + "' style='width:80px;text-align:right;' value='" + obj[i].ExtraQty + "' onkeypress='if (isNaN(String.fromCharCode(event.keyCode))) return false;' /></td>";
                                html += "<td><a href='javascript:void(0);'><i class='fa fa-trash fa-2x text-danger btnDeleteList'></i></a></td>";
                                html += "</tr>";

                                totalQty += (Number(obj[i].Qty || 0) + Number(obj[i].ExtraQty || 0));
                            }
                            html += "</tbody>";
                            $("#tbl_OrderList").html(html);
                            $("#txtQty" + orderNo).val(totalQty);
                        }

                        $("#tbl_OrderList").show();
                        $("#rowBtn").show();
                    }
                    else {
                        $("#tbl_OrderList").hide();
                    }
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });
                }
            });
        }

        function Fn_Cal_Qty() {

            var hdnOrderNo = $("#hdnOrderNo").val();
            let total = 0;
            $('.clstxtQty').each(function () {
                total += parseInt($(this).val()) || 0;
            });
            $("#txtQty" + hdnOrderNo).val(total);
        }

        function Fn_Update_Order_List() {
            var hdnOrderNo = $("#hdnOrderNo").val();

            const urlParams = new URLSearchParams(window.location.search);
            const style = urlParams.get('style');
            var strMsg = ""
            var clsOrderMaster = {};
            clsOrderMaster.ID = hdnOrderNo;
            strMsg = "Order List Updated Successfully";
            clsOrderMaster.StyleCode = style;
            clsOrderMaster.OrderNo = $("#txtOrderNo" + hdnOrderNo).val();
            clsOrderMaster.Qty = $("#txtQty" + hdnOrderNo).val();

            if ($("#chkFinished" + hdnOrderNo).is(':checked')) {
                clsOrderMaster.IsFinished = true;
            } else {
                clsOrderMaster.IsFinished = false;
            }


            if ($("#chkStkr" + hdnOrderNo).is(':checked')) {
                clsOrderMaster.IsStkr = true;
            } else {
                clsOrderMaster.IsStkr = false;
            }
            clsOrderMaster.BundleQty = $("#txtBundleQty" + hdnOrderNo).val();
            clsOrderMaster.OrderDate = $("#txtOrderDate" + hdnOrderNo).val();
            clsOrderMaster.CreatedBy = sessionStorage.getItem("LogInID");

            var clsOrderDetail = [];

            if ($("#chkMatrixView").is(":checked")) {

                $('#tbodyOrderList tr').each(function () {

                    $(this).find('.qty-input').each(function () {

                        var $qty = $(this);
                        var color = $qty.data('color');
                        var size = $qty.data('size');
                        var qty = Number($qty.val() || 0);
                        var $extraQty = $(this).closest('td').next('td').find('.extraqty-input');
                        var extraQty = Number($extraQty.val() || 0);
                        clsOrderDetail.push({
                            Color: color,
                            Size: size,
                            Qty: qty,
                            ExtraQty: extraQty,
                            OrderNo: $("#txtOrderNo" + hdnOrderNo).val()
                        });
                    });
                });
            }
            else {
                $('#tbodyOrderList tr').each(function (index, row) {

                    var tds = $(row).find('td');
                    var inputs = $(row).find('input[type="text"]');
                    var _list = {
                        Color: $(tds[1]).text().trim(),
                        Size: $(tds[2]).text().trim(),
                        Qty: $(inputs[0]).val(),
                        ExtraQty: $(inputs[1]).val(),
                        OrderNo: $("#txtOrderNo" + hdnOrderNo).val()
                    };
                    clsOrderDetail.push(_list);
                });
            }

            clsOrderMaster.oDetail = clsOrderDetail;

            if (clsOrderMaster.OrderNo == "") {
                Swal.fire({ title: "", text: "Please Enter Order No", icon: "error" });
            }
            else if (clsOrderMaster.OrderDate == "") {
                Swal.fire({ title: "", text: "Please Enter Order Date", icon: "error" });
            }
            else if (clsOrderMaster.oDetail.length == 0) {
                Swal.fire({ title: "", text: "Please Make order list", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Insert_Order_Master",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsOrderMaster),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Swal.fire({ title: "", text: strMsg, icon: "success" });
                            Fn_Get_Order_Master();
                            $("#tbodyOrderList").html('');
                            $("#rowBtn").hide();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });
                    }
                });
            }

        }
        

    </script>

