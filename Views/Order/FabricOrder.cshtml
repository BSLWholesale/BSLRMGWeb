
@{
    ViewBag.Title = "FabricOrder";
}

@{

    <link href="~/web/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/web/js/jquery-3.7.1.min.js"></script>
    <script src="~/web/js/jquery-ui.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            const urlParams = new URLSearchParams(window.location.search);
            const style = urlParams.get('style');

            if (style != null || style != "") {
                $("#spnStyle").html("Style: " + style);
                Fn_Get_FabricOrder();

            }

        });

        function Fn_Add_FabricOrder() {

            const urlParams = new URLSearchParams(window.location.search);
            const style = urlParams.get('style');
            var btnAddFabric = $("#btnAddFabric").val();
            var strMsg = "";
            if (btnAddFabric == "Save") {
                strMsg = "Record added successfully";
            }
            else {
                strMsg = "Record updated successfully";
            }

            var clsFabricOrder = {};
            clsFabricOrder.StyleCode = style;
            clsFabricOrder.ItemCode = $("#txtItemCode").val();
            clsFabricOrder.Descriptions = $("#txtDescription").val();
            clsFabricOrder.Contents = $("#txtContent").val();
            clsFabricOrder.Mill = $("#txtMill").val();
            clsFabricOrder.FabricColor = $("#txtFabricColor").val();
            clsFabricOrder.FabricCC = $("#txtFabricCC").val();
            clsFabricOrder.Width = $("#txtWidth").val();
            clsFabricOrder.WidthTolerance = $("#txtWidthTolerance").val();
            clsFabricOrder.OrderRollLength = $("#txtOrderRollLength").val();
            clsFabricOrder.OrderRollLengthTolerance = $("#txtOrderRollLengthTolerance").val();
            clsFabricOrder.GSM = $("#txtGSM").val();
            clsFabricOrder.GSMTolerance = $("#txtGSMTolerance").val();
            clsFabricOrder.OrderShrinkageWarpLength = $("#txtOrderShrinkageWarpLength").val();
            clsFabricOrder.OrderShrinkageWaftWidth = $("#txtOrderShrinkageWaftWidth").val();
            clsFabricOrder.TotalQuantity = $("#txtTotalQuantity").val();
            clsFabricOrder.Unit = $("#ddUnit").val();
            clsFabricOrder.MarkerType = $("#ddlMarkerType").val();
            clsFabricOrder.Price = $("#txtPrice").val();
            clsFabricOrder.QueryType = "Add_FabricOrder";
            clsFabricOrder.CreatedBy = sessionStorage.getItem("LogInID");

            if (clsFabricOrder.StyleCode == "") {
                Swal.fire({ title: "", text: "Please Enter Item Code", icon: "error" });
            }
            else if ($("#txtItemCode").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Item Code", icon: "error" });
            }
            else if ($("#txtDescription").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Description", icon: "error" });
            }
            else if ($("#txtContent").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Content", icon: "error" });
            }
            else if ($("#txtFabricColor").val() == "") {
                Swal.fire({ title: "", text: "Please Enter FabricColor", icon: "error" });
            }
            else if ($("#txtWidth").val() == "") {
                Swal.fire({ title: "", text: "Please Enter Width", icon: "error" });
            }
            else if ($("#txtTotalQuantity").val() == "") {
                Swal.fire({ title: "", text: "Please Enter TotalQuantity", icon: "error" });
            }
            else if ($("#ddUnit").val() == "0") {
                Swal.fire({ title: "", text: "Please Enter Unit", icon: "error" });
            }
            else if ($("#ddlMarkerType").val() == "0") {
                Swal.fire({ title: "", text: "Please Select MarkerType", icon: "error" });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Order/Fn_Add_FabricOrder",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: JSON.stringify(clsFabricOrder),
                    success: function (data) {
                        var obj = JSON.parse(data.message);
                        if (obj.vErrorMsg == "Success") {
                            Swal.fire({ title: "", text: strMsg, icon: "success" });
                            Fn_Reset_Control();
                            Fn_Get_FabricOrder();
                        }
                        else {
                            Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                        }
                    },
                    error: function (err) {
                        Swal.fire({ title: "", text: err, icon: "error" });
                    }
                });
            }
        }

        function Fn_Reset_Control() {

            $("#txtItemCode").val("");
            $("#txtItemCode").prop('readonly', false);
            $("#txtDescription").val("");
            $("#txtContent").val("");
            $("#txtMill").val("");
            $("#txtFabricColor").val("");
            $("#txtFabricCC").val("");
            $("#txtWidth").val("");
            $("#txtWidthTolerance").val("");
            $("#txtOrderRollLength").val("");
            $("#txtOrderRollLengthTolerance").val("");
            $("#txtGSM").val("");
            $("#txtGSMTolerance").val("");
            $("#txtOrderShrinkageWarpLength").val("");
            $("#txtOrderShrinkageWaftWidth").val("");
            $("#txtTotalQuantity").val("");
            $("#ddUnit").val("0");
            $("#ddlMarkerType").val("0");
            $("#txtPrice").val("");
            $("#btnAddFabric").val("Save");
            $("#AddFabricOrderModal").modal('hide');
        }

        function Fn_Get_FabricOrder() {

            const urlParams = new URLSearchParams(window.location.search);
            const style = urlParams.get('style');

            var clsFabricOrder = {};
            clsFabricOrder.CreatedBy = sessionStorage.getItem("LogInID");
            clsFabricOrder.StyleCode == style;

            $("#tbody").html('');
            var html = '';
            $.ajax({
                type: "POST",
                url: "/Order/Fn_Get_FabricOrder",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsFabricOrder),
                beforeSend: function () {
                    $("#loader").show();
                    $("#dvMain").hide();
                },
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        for (var i = 0; i < obj.length; i++) {

                            html += "<tr>";
                            html += "<td>" + obj[i].ItemCode + "</td>";
                            html += "<td>" + obj[i].Descriptions + "</td>";
                            html += "<td>" + obj[i].Contents + "</td>";
                            html += "<td>" + obj[i].FabricColor + "</td>";
                            html += "<td>" + obj[i].Mill + "</td>";
                            html += "<td>" + obj[i].GSM + "</td>";
                            html += "<td>CU</td>";
                            html += "<td>" + obj[i].Width + "</td>";
                            html += "<td>" + obj[i].TotalQuantity + "</td>";
                            html += "<td>" + obj[i].OrderShrinkageWarpLength + "</td>";
                            html += "<td>" + obj[i].OrderShrinkageWaftWidth + "</td>";
                            html += "<td>" + obj[i].Price + "</td>";
                            html += "<td>";
                            html += "<a href='javascript: void (0);' class='btn btn-xs btn-info'><i onclick=\"Fn_Edit_ItemCode('" + obj[i].ItemCode + "', '" + obj[i].StyleCode + "')\" class='fa fa-edit'></i></a>";
                            html += "&nbsp;&nbsp;<a href='javascript: void (0);' class='btn btn-xs sharp btn-danger'><i class='fa fa-trash' onclick=\"Fn_Delete_ItemCode('" + obj[i].ItemCode + "', '" + obj[i].StyleCode + "')\"></i></a>";
                            html += "</td>";
                            html += "</tr>";
                            
                        }
                    }
                    else {
                        html += "<tr><td colspan='13' class='text-center'>" + obj[0].vErrorMsg + "</td></tr>";
                    }
                    $("#tbody").append(html);
                },
                complete: function (data) {
                    $("#loader").hide();
                    $("#dvMain").show();
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });

                }
            });
        }

        function Fn_Delete_ItemCode(itemcode, stylecode) {

            Swal.fire({
                title: 'Are your sure?',
                text: "Do you want to delete?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes',
            }).then((result) => {
                if (result.isConfirmed) {

                    var clsFabricOrder = {};
                    clsFabricOrder.ItemCode = itemcode;
                    clsFabricOrder.StyleCode = stylecode;
                    clsFabricOrder.CreatedBy = sessionStorage.getItem("LogInID");
                    $.ajax({
                        type: "POST",
                        url: "/Order/Fn_Delete_ItemCode",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        data: JSON.stringify(clsFabricOrder),
                        success: function (data) {
                            var obj = JSON.parse(data.message);
                            if (obj.vErrorMsg == "Success") {
                                Swal.fire({ title: "", text: "Itemcode deleted successfully.", icon: "success" });
                                Fn_Get_FabricOrder();
                            }
                            else {
                                Swal.fire({ title: "", text: obj.vErrorMsg, icon: "error" });
                            }
                        },
                        error: function (err) {
                            alert(err);
                        }
                    });
                }
                else {
                    return false;
                }
            });
        }

        function Fn_Edit_ItemCode(itemcode, stylecode) {

            var clsFabricOrder = {};
            clsFabricOrder.ItemCode = itemcode;
            clsFabricOrder.StyleCode = stylecode;

            $.ajax({
                type: "POST",
                url: "/Order/Fn_Get_FabricOrder",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsFabricOrder),
                beforeSend: function () {
                    $("#loader").show();
                    $("#dvMain").hide();
                },
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        
                        $("#txtItemCode").val(obj[0].ItemCode);
                        $("#txtItemCode").prop('readonly', true)
                        $("#txtDescription").val(obj[0].Descriptions);
                        $("#txtContent").val(obj[0].Contents);
                        $("#txtMill").val(obj[0].Mill);
                        $("#txtFabricColor").val(obj[0].FabricColor);
                        $("#txtFabricCC").val(obj[0].FabricCC);
                        $("#txtWidth").val(obj[0].Width);
                        $("#txtWidthTolerance").val(obj[0].WidthTolerance);
                        $("#txtOrderRollLength").val(obj[0].OrderRollLength);
                        $("#txtOrderRollLengthTolerance").val(obj[0].OrderRollLengthTolerance);
                        $("#txtGSM").val(obj[0].GSM);
                        $("#txtGSMTolerance").val(obj[0].GSMTolerance);
                        $("#txtOrderShrinkageWarpLength").val(obj[0].OrderShrinkageWarpLength);
                        $("#txtOrderShrinkageWaftWidth").val(obj[0].OrderShrinkageWaftWidth);
                        $("#txtTotalQuantity").val(obj[0].TotalQuantity);
                        $("#ddUnit").val(obj[0].Unit);
                        $("#ddlMarkerType").val(obj[0].MarkerType);
                        $("#txtPrice").val(obj[0].Price);
                        $("#AddFabricOrderModal").modal('show');
                        $("#btnAddFabric").val("Update");
                    }
                    else {
                        Swal.fire({ title: "", text: "Fetching record faild", icon: "error" });
                    }
                },
                complete: function (data) {
                    $("#loader").hide();
                    $("#dvMain").show();
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });

                }
            });
        }

    </script>


}

<section id="main-content">
    <section class="wrapper">
        <div class="row page-titles mx-0">
            <div class="col-sm-5">
                <span><a href="@Url.Action("Dashboard", "Home" )"><i class="fa fa-home"></i> <b>Home</b></a> </span>
                <span><a href="javascript:void(0);"><i>></i> <b id="spnHeading">Fabric Order</b></a></span>
                <span><a href="javascript:history.back();"><i>></i> <b>Go Back</b></a></span>
            </div>
            <div class="col-sm-4">
                <span id="spnStyle" style="font-weight: 800;"></span>
            </div>
            <div class="col-sm-3">
                @*<span id="spnView" style="display: none;"><i class="btn btn-primary btn-xs pull-right fa fa-eye" onclick=""></i></span>
                <span id="spnAdd"><i class="btn btn-primary btn-xs pull-right fa fa-plus-circle" onclick="Fn_AddOrder_Row();"></i></span>*@
            </div>
        </div>

        <div class="row" style="margin-top: 1%;" id="dvAddOrder">

            <div class="col-xl-12 col-xxl-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <button type="button" class="btn btn-primary pull-right" data-toggle="modal" data-target="#AddFabricOrderModal"><i class="fa fa-plus"></i> Add Fabric</button>
                        </div>
                        <div class="row">
                            <div class="table-responsive">
                                <table class="table table-responsive text-nowrap">
                                    <thead>
                                        <tr style="background-color: #E1C16E; background-image: linear-gradient(to bottom, #722F37, #DB5A6A); color: white;">                                           
                                            <td>Code</td>
                                            <td>Desc.</td>
                                            <td>Cat.</td>
                                            <td>Fab.Color</td>
                                            <td>Mill</td>
                                            <td>GSM</td>
                                            <td>CU</td>
                                            <td>Width</td>
                                            <td>Quantity</td>
                                            <td>Shrnk.Warp/Length</td>
                                            <td>Shrnk.Weft/Width</td>
                                            <td>Price</td>
                                            <td>Action</td>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>
</section>

<!-- Add Fabric Moded -->
<div id="AddFabricOrderModal" class="modal fade">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content  modal-dialog-centered modal-lg">
            <div class="modal-header">
                <div class="row">
                    <div class="col-sm-10">
                        <h4 class="modal-title">Add New Fabric</h4>
                    </div>
                    <div class="col-sm-2">
                        <button type="button" class="close" style="color:#fff;" data-dismiss="modal" onclick="Fn_Reset_Control();">&times;</button>
                    </div>
                </div>
            </div>
            <div class="modal-body">
                <div class="wrapper">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Item Code <span class="text-danger">*</span></label>
                                <input type="text" id="txtItemCode" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Description <span class="text-danger">*</span></label>
                                <input type="text" id="txtDescription" class="form-control" />
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Content <span class="text-danger">*</span></label>
                                <input type="text" id="txtContent" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Mill</label>
                                <input type="text" id="txtMill" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Fabric Color <span class="text-danger">*</span></label>
                                <input type="text" id="txtFabricColor" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Fabric CC (Meter/Kg)</label>
                                <input type="text" id="txtFabricCC" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Width (CM) <span class="text-danger">*</span></label>
                                <input type="text" id="txtWidth" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Width Tolerance (%)</label>
                                <input type="text" id="txtWidthTolerance" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Order Roll Length</label>
                                <input type="text" id="txtOrderRollLength" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Order Roll Length Tolerance (%)</label>
                                <input type="text" id="txtOrderRollLengthTolerance" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>GSM</label>
                                <input type="text" id="txtGSM" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>GSM Tolerance (%)></label>
                                <input type="text" id="txtGSMTolerance" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Order Shrinkage Warp/Length (%)</label>
                                <input type="text" id="txtOrderShrinkageWarpLength" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Order Shrinkage Waft/Width (%)</label>
                                <input type="text" id="txtOrderShrinkageWaftWidth" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Total Quantity <span class="text-danger">*</span></label>
                                <input type="text" id="txtTotalQuantity" class="form-control" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Unit  <span class="text-danger">*</span></label>
                                <select id="ddlUnit" class="form-control">
                                    <option value="0">--Select Unit--</option>
                                    <option value="Meter">Meter</option>
                                    <option value="PCS">PCS</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Marker Type <span class="text-danger">*</span></label>
                                <select id="ddlMarkerType" class="form-control">
                                    <option value="0">--Select Marker--</option>
                                    <option value="SHELL FABRIC">SHELL FABRIC</option>
                                    <option value="LINING">LINING</option>
                                    <option value="INTER LINING">INTER LINING</option>
                                    <option value="FUSING">FUSING</option>
                                    <option value="CUTTING MARKER">CUTTING MARKER</option>
                                    <option value="TRS PACKING">TRS PACKING</option>
                                    <option value="TRS PRESSING">TRS PRESSING</option>
                                    <option value="JKT PACKING">JKT PACKING</option>
                                    <option value="TRS FINISHING">TRS FINISHING</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Price</label>
                                <input type="text" id="txtPrice" class="form-control" placeholder="Price" onkeypress="var ch=String.fromCharCode(event.which||event.keyCode); return /[0-9]/.test(ch) || (ch==='.' && this.value.indexOf('.')===-1);" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <input type="submit" id="btnAddFabric" class="btn btn-primary" value="Save" onclick="Fn_Add_FabricOrder();" />
                <button type="button" class="btn btn-default" data-dismiss="modal" onclick="Fn_Reset_Control();">Close</button>
            </div>
        </div>

    </div>
</div>
<!--End Season -->
